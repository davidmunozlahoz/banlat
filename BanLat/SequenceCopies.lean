import BanLat.Examples.C0.Basic
import BanLat.Examples.Ellp.Sum
import BanLat.Operators.Hom
import Mathlib.Analysis.Normed.Operator.Extend
import Mathlib.LinearAlgebra.Finsupp.LSum

/-!
# Sequence spaces generated by disjoint vectors

A disjoint positive sequence in a Banach lattice generates a closed lattice copy of `c₀`
when its finite sums are uniformly bounded in norm and its vector norms are bounded away from zero.

It generates a closed lattice copy of `ℓ¹` when its vectors are uniformly bounded in norm and
some continuous linear functional takes values bounded below by a positive constant on them.
In both cases, the copy is the closed linear span of the sequence.
-/

noncomputable section

open Set
open scoped ZeroAtInfty lp

namespace BanachLattice

variable {X : Type*} [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
  [BanachLattice X]

/-- The absolute value of a finite sum of disjoint positive vectors equals the sum of their
absolute values. -/
private lemma abs_sum_disjoint {ι : Type*} (s : Finset ι) (v : ι → X) (a : ι → ℝ)
    (hd : Pairwise fun i j ↦ IsVLDisjoint (v i) (v j)) :
    |∑ i ∈ s, a i • v i| = ∑ i ∈ s, |a i| • |v i| := by
  rw [← Finset.sum_coe_sort s (fun i ↦ a i • v i),
    ← Finset.sum_coe_sort s (fun i ↦ |a i| • |v i|)]
  rw [← s.equivFin.symm.sum_comp (fun i : s ↦ a i • v i),
    ← s.equivFin.symm.sum_comp (fun i : s ↦ |a i| • |v i|)]
  exact abs_sum_of_pairwise_isVLDisjoint
    (fun _ _ hij ↦ hd (fun h ↦ hij (s.equivFin.symm.injective (Subtype.ext h))))

/-- Finite linear combinations of disjoint positive vectors preserve absolute values. -/
private lemma linearCombination_abs {v : ℕ → X} (hv : ∀ n, 0 ≤ v n)
    (hd : Pairwise fun n m ↦ IsVLDisjoint (v n) (v m)) (a : ℕ →₀ ℝ) :
    Finsupp.linearCombination ℝ v |a| = |Finsupp.linearCombination ℝ v a| := by
  have hs : (|a|).support ⊆ a.support := fun _ hi ↦
    Finsupp.mem_support_iff.mpr (abs_ne_zero.mp (Finsupp.mem_support_iff.mp hi))
  rw [Finsupp.linearCombination_apply,
    Finsupp.sum_of_support_subset |a| hs (fun i c ↦ c • v i) (fun _ _ ↦ zero_smul _ _)]
  change (∑ n ∈ a.support, |a n| • v n) = |∑ n ∈ a.support, a n • v n|
  simpa only [abs_of_nonneg (hv _)] using
    (abs_sum_disjoint a.support v (fun n ↦ a n) hd).symm

/-- A uniform norm bound for finite sums of disjoint positive vectors bounds their
finite linear combinations by the supremum norm of the coefficients. -/
private lemma norm_linearCombination_c0_le {v : ℕ → X} (hv : ∀ n, 0 ≤ v n)
    (hd : Pairwise fun n m ↦ IsVLDisjoint (v n) (v m)) {C : ℝ}
    (hb : ∀ s : Finset ℕ, ‖∑ n ∈ s, v n‖ ≤ C) (a : ℕ →₀ ℝ) :
    ‖Finsupp.linearCombination ℝ v a‖ ≤ C * ‖ZeroAtInftyContinuousMap.ofFinsupp a‖ := by
  have ha (n : ℕ) : |a n| ≤ ‖ZeroAtInftyContinuousMap.ofFinsupp a‖ :=
    (ZeroAtInftyContinuousMap.ofFinsupp a).toBCF.norm_coe_le_norm n
  have hs := Finset.sum_le_sum (s := a.support)
    (fun n _ ↦ smul_le_smul_of_nonneg_right (ha n) (hv n))
  have habs : |Finsupp.linearCombination ℝ v a| ≤
      ‖ZeroAtInftyContinuousMap.ofFinsupp a‖ • ∑ n ∈ a.support, v n := by
    simpa only [Finsupp.linearCombination_apply, Finsupp.sum, abs_sum_disjoint _ _ _ hd,
      abs_of_nonneg (hv _), Finset.smul_sum] using hs
  have hn := norm_le_norm_of_abs_le_abs (habs.trans (le_abs_self _))
  rw [norm_smul, Real.norm_of_nonneg (norm_nonneg _)] at hn
  exact hn.trans ((mul_le_mul_of_nonneg_left (hb a.support) (norm_nonneg _)).trans_eq
    (mul_comm _ _))

/-- In a finite combination of disjoint vectors, each individual summand has norm
at most the norm of the whole combination. -/
private lemma norm_smul_le_norm_linearCombination {v : ℕ → X}
    (hd : Pairwise fun n m ↦ IsVLDisjoint (v n) (v m)) (a : ℕ →₀ ℝ) (n : ℕ) :
    ‖a n • v n‖ ≤ ‖Finsupp.linearCombination ℝ v a‖ := by
  apply norm_le_norm_of_abs_le_abs
  change |a n • v n| ≤ |∑ i ∈ a.support, a i • v i|
  rw [abs_smul', abs_sum_disjoint _ _ _ hd]
  by_cases hn : n ∈ a.support
  · exact Finset.single_le_sum (fun i _ ↦ smul_nonneg (abs_nonneg (a i)) (abs_nonneg (v i))) hn
  · simpa only [Finsupp.notMem_support_iff.mp hn, abs_zero, zero_smul] using
      Finset.sum_nonneg (s := a.support)
        (fun i _ ↦ smul_nonneg (abs_nonneg (a i)) (abs_nonneg (v i)))

/-- A positive lower bound for the norms of disjoint vectors gives a lower bound
for finite combinations in terms of the supremum norm of their coefficients. -/
private lemma c0_norm_le_norm_linearCombination {v : ℕ → X}
    (hd : Pairwise fun n m ↦ IsVLDisjoint (v n) (v m)) {ε : ℝ} (hε : 0 < ε)
    (hv : ∀ n, ε ≤ ‖v n‖) (a : ℕ →₀ ℝ) :
    ‖ZeroAtInftyContinuousMap.ofFinsupp a‖ ≤ ε⁻¹ * ‖Finsupp.linearCombination ℝ v a‖ := by
  apply (BoundedContinuousFunction.norm_le
    (mul_nonneg (inv_nonneg.mpr hε.le) (norm_nonneg _))).mpr
  intro n
  change |a n| ≤ ε⁻¹ * ‖Finsupp.linearCombination ℝ v a‖
  rw [le_inv_mul_iff₀ hε]
  have hn : ‖v n‖ * |a n| ≤ ‖Finsupp.linearCombination ℝ v a‖ := by
    simpa only [norm_smul, Real.norm_eq_abs, mul_comm] using
      norm_smul_le_norm_linearCombination hd a n
  exact (mul_le_mul_of_nonneg_right (hv n) (abs_nonneg _)).trans hn

/-- The candidate for continuous operator from `c₀` to the Banach lattice `X` mapping the
unit vectors to `v n`. -/
private def c0Combination (v : ℕ → X) : C₀(ℕ, ℝ) →L[ℝ] X :=
  (Finsupp.linearCombination ℝ v).extendOfNorm ZeroAtInftyContinuousMap.ofFinsuppLinear

/-- Bounded finite sums ensure that the operator candidate agrees with each
finitely supported linear combination. -/
private lemma c0Combination_ofFinsupp {v : ℕ → X} (hv : ∀ n, 0 ≤ v n)
    (hd : Pairwise fun n m ↦ IsVLDisjoint (v n) (v m)) {C : ℝ}
    (hb : ∀ s : Finset ℕ, ‖∑ n ∈ s, v n‖ ≤ C) (a : ℕ →₀ ℝ) :
    c0Combination v (ZeroAtInftyContinuousMap.ofFinsupp a) =
      Finsupp.linearCombination ℝ v a :=
  LinearMap.extendOfNorm_eq ZeroAtInftyContinuousMap.denseRange_ofFinsupp
    ⟨C, norm_linearCombination_c0_le hv hd hb⟩ a

/-- Preservation of absolute values from finite combinations extends to all elements in `c₀`. -/
private lemma c0Combination_map_abs {v : ℕ → X} (hv : ∀ n, 0 ≤ v n)
    (hd : Pairwise fun n m ↦ IsVLDisjoint (v n) (v m)) {C : ℝ}
    (hb : ∀ s : Finset ℕ, ‖∑ n ∈ s, v n‖ ≤ C) (f : C₀(ℕ, ℝ)) :
    c0Combination v |f| = |c0Combination v f| := by
  refine ZeroAtInftyContinuousMap.denseRange_ofFinsupp.induction_on f
    (isClosed_eq ((c0Combination v).continuous.comp
      NormedVectorLattice.lipschitzWith_abs.continuous)
      (NormedVectorLattice.lipschitzWith_abs.continuous.comp (c0Combination v).continuous)) ?_
  intro a
  rw [← ZeroAtInftyContinuousMap.ofFinsupp_abs, c0Combination_ofFinsupp hv hd hb,
    c0Combination_ofFinsupp hv hd hb, linearCombination_abs hv hd]

/-- A disjoint positive sequence with norms bounded away from zero and norm-bounded finite sums
spans a closed vector sublattice isomorphic to `c₀`. -/
theorem containsLatticeCopy_c0_of_disjoint {v : ℕ → X} (hv : ∀ n, 0 ≤ v n)
    (hd : Pairwise fun n m ↦ IsVLDisjoint (v n) (v m)) {C ε : ℝ} (hε : 0 < ε)
    (hn : ∀ n, ε ≤ ‖v n‖) (hb : ∀ s : Finset ℕ, ‖∑ n ∈ s, v n‖ ≤ C) :
    ContainsLatticeCopy X C₀(ℕ, ℝ) := by
  let T := VecLatHom.ofAbs (c0Combination v).toLinearMap (c0Combination_map_abs hv hd hb)
  refine containsLatticeCopy_of_norm_lower_bound T ⟨ε⁻¹, inv_nonneg.mpr hε.le⟩ fun f ↦ ?_
  refine ZeroAtInftyContinuousMap.denseRange_ofFinsupp.induction_on f
    (isClosed_le continuous_norm (continuous_const.mul (c0Combination v).continuous.norm)) ?_
  intro a
  change ‖ZeroAtInftyContinuousMap.ofFinsupp a‖ ≤
    ε⁻¹ * ‖c0Combination v (ZeroAtInftyContinuousMap.ofFinsupp a)‖
  rw [c0Combination_ofFinsupp hv hd hb]
  exact c0_norm_le_norm_linearCombination hd hε hn a

/-- Regard finitely supported real coefficients as an absolutely summable sequence,
without imposing a norm on the coefficient space itself. -/
private def ell1OfFinsupp : (ℕ →₀ ℝ) →ₗ[ℝ] ℓ¹(ℕ, ℝ) where
  toFun a := ⟨fun n ↦ a n, (memℓp_zero a.hasFiniteSupport).of_exponent_ge zero_le_one⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The norm of a finitely supported summable sequence of reals is the sum of the absolute
values of its nonzero coefficients. -/
private lemma norm_ell1OfFinsupp (a : ℕ →₀ ℝ) :
    ‖ell1OfFinsupp a‖ = ∑ n ∈ a.support, |a n| := by
  rw [lp.norm_eq_tsum_rpow (by norm_num : 0 < (1 : ENNReal).toReal)]
  change (∑' n, ‖a n‖ ^ (1 : ENNReal).toReal) ^ (1 / (1 : ENNReal).toReal) =
    ∑ n ∈ a.support, |a n|
  simpa only [ENNReal.toReal_one, div_one, Real.rpow_one, Real.norm_eq_abs] using
    tsum_eq_sum (fun n hn ↦ abs_eq_zero.mpr (Finsupp.notMem_support_iff.mp hn))

/-- Every absolutely summable sequence is a norm limit of finite coordinate sums,
so finitely supported coefficients have dense image in `ℓ¹`. -/
private lemma denseRange_ell1OfFinsupp : DenseRange ell1OfFinsupp := by
  intro f
  refine mem_closure_of_tendsto (lp.hasSum_single (by simp : (1 : ENNReal) ≠ ⊤) f)
    (Filter.Eventually.of_forall fun s ↦ ?_)
  refine ⟨∑ n ∈ s, Finsupp.single n (f n), ?_⟩
  ext n
  change (∑ i ∈ s, Finsupp.single i (f i)) n = _
  simp only [Finsupp.finsetSum_apply, lp.coeFn_sum, Finset.sum_apply, lp.coeFn_single,
    Finsupp.single_apply, Pi.single_apply, eq_comm]

/-- A uniform bound on the norm of vectors bounds the norem of each finite combination by
the `ℓ¹` norm of its coefficients. -/
private lemma norm_linearCombination_ell1_le {v : ℕ → X} {M : ℝ}
    (hv : ∀ n, ‖v n‖ ≤ M) (a : ℕ →₀ ℝ) :
    ‖Finsupp.linearCombination ℝ v a‖ ≤ M * ‖ell1OfFinsupp a‖ := by
  rw [norm_ell1OfFinsupp, Finsupp.linearCombination_apply, Finsupp.sum, Finset.mul_sum]
  exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun n _ ↦
    (norm_smul (a n) (v n)).trans_le ((mul_le_mul_of_nonneg_left (hv n)
      (norm_nonneg (a n))).trans_eq (by rw [Real.norm_eq_abs, mul_comm])))

/-- A functional which is stricly positive on a disjoint positive family yields an estimate of the
norm of all finite linear combinations with the `ℓ¹` norm of the coefficients from below. -/
private lemma ell1_norm_le_norm_linearCombination {v : ℕ → X} (hv : ∀ n, 0 ≤ v n)
    (hd : Pairwise fun n m ↦ IsVLDisjoint (v n) (v m)) (φ : StrongDual ℝ X)
    {ε : ℝ} (hε : 0 < ε) (hφ : ∀ n, ε ≤ φ (v n)) (a : ℕ →₀ ℝ) :
    ‖ell1OfFinsupp a‖ ≤ (ε⁻¹ * ‖φ‖) * ‖Finsupp.linearCombination ℝ v a‖ := by
  rw [norm_ell1OfFinsupp, mul_assoc, le_inv_mul_iff₀ hε, Finset.mul_sum]
  have heq : φ |Finsupp.linearCombination ℝ v a| = ∑ n ∈ a.support, |a n| * φ (v n) := by
    simp only [Finsupp.linearCombination_apply, Finsupp.sum, abs_sum_disjoint _ _ _ hd,
      abs_of_nonneg (hv _), map_sum, map_smul, smul_eq_mul]
  have hle : (∑ n ∈ a.support, ε * |a n|) ≤ φ |Finsupp.linearCombination ℝ v a| :=
    heq.symm ▸ Finset.sum_le_sum (fun n _ ↦
      (mul_le_mul_of_nonneg_right (hφ n) (abs_nonneg _)).trans_eq (mul_comm _ _))
  exact hle.trans ((le_abs_self _).trans
    ((φ.le_opNorm _).trans_eq (by rw [norm_abs_eq_norm])))

/-- The candidate continuous operator `ℓ¹ →L[ℝ] X` mapping the unit vector
basis of `ℓ¹` to `v n`. -/
private def ell1Combination (v : ℕ → X) : ℓ¹(ℕ, ℝ) →L[ℝ] X :=
  (Finsupp.linearCombination ℝ v).extendOfNorm ell1OfFinsupp

private lemma ell1Combination_ofFinsupp {v : ℕ → X} {M : ℝ}
    (hv : ∀ n, ‖v n‖ ≤ M) (a : ℕ →₀ ℝ) :
    ell1Combination v (ell1OfFinsupp a) = Finsupp.linearCombination ℝ v a :=
  LinearMap.extendOfNorm_eq denseRange_ell1OfFinsupp
    ⟨M, norm_linearCombination_ell1_le hv⟩ a

private lemma ell1Combination_map_abs {v : ℕ → X} (hv : ∀ n, 0 ≤ v n)
    (hd : Pairwise fun n m ↦ IsVLDisjoint (v n) (v m)) {M : ℝ}
    (hb : ∀ n, ‖v n‖ ≤ M) (f : ℓ¹(ℕ, ℝ)) :
    ell1Combination v |f| = |ell1Combination v f| := by
  refine denseRange_ell1OfFinsupp.induction_on f
    (isClosed_eq ((ell1Combination v).continuous.comp
      NormedVectorLattice.lipschitzWith_abs.continuous)
      (NormedVectorLattice.lipschitzWith_abs.continuous.comp (ell1Combination v).continuous)) ?_
  intro a
  change ell1Combination v (ell1OfFinsupp |a|) = |ell1Combination v (ell1OfFinsupp a)|
  rw [ell1Combination_ofFinsupp hb, ell1Combination_ofFinsupp hb, linearCombination_abs hv hd]

/-- A norm bounded disjoint positive sequence on which one continuous functional is
uniformly above zero spans a closed vector sublattice isomorphic to `ℓ¹`. -/
theorem containsLatticeCopy_ell1_of_disjoint {v : ℕ → X} (hv : ∀ n, 0 ≤ v n)
    (hd : Pairwise fun n m ↦ IsVLDisjoint (v n) (v m)) {M ε : ℝ}
    (hb : ∀ n, ‖v n‖ ≤ M) (φ : StrongDual ℝ X) (hε : 0 < ε)
    (hφ : ∀ n, ε ≤ φ (v n)) : ContainsLatticeCopy X ℓ¹(ℕ, ℝ) := by
  let T := VecLatHom.ofAbs (ell1Combination v).toLinearMap (ell1Combination_map_abs hv hd hb)
  refine containsLatticeCopy_of_norm_lower_bound T
    ⟨ε⁻¹ * ‖φ‖, mul_nonneg (inv_nonneg.mpr hε.le) (norm_nonneg _)⟩ fun f ↦ ?_
  refine denseRange_ell1OfFinsupp.induction_on f
    (isClosed_le continuous_norm (continuous_const.mul (ell1Combination v).continuous.norm)) ?_
  intro a
  change ‖ell1OfFinsupp a‖ ≤ (ε⁻¹ * ‖φ‖) * ‖ell1Combination v (ell1OfFinsupp a)‖
  rw [ell1Combination_ofFinsupp hb]
  exact ell1_norm_le_norm_linearCombination hv hd φ hε hφ a

end BanachLattice
