import BanLat.AMSpace.Complex.Kakutani
import BanLat.Substructures.ComplexSublattice

/-!
# Functional calculus in uniformly complete complex vector lattices

This file develops the **lattice-linear** and **positively homogeneous functional calculus**
associated to every tuple `z₁,...,zₙ` in a complex vector lattice with uniformly complete
self-adjoint part.

* Lattice-linear functional calculus is the unique complex vector lattice homomorphism from
`complexLatticeLinearFunctions n` to `Z` such that `coordinate i ↦ z i`. Its domain is the
complex vector sublattice of `C(ℂⁿ, ℂ)` generated by the coordinate projections `z ↦ zᵢ`.
* Positively homogeneous functional calculus is the unique complex vector lattice homomorphism
from `complexPosHomFunctions n` to `Z` such that `coordinate i ↦ z i`. Its domain consists of
continuous functions on `ℂⁿ` homogeneous under nonnegative real scalar multiplication.

Apart from both uniqueness results, this file also shows that:
* The positively homogeneous functional calculus agrees with the lattice-linear functional calculus
over `complexLatticeLinearFunctions n`.
* `complexPosHomFunctions n` and `C(complexEllInfinityUnitSphere n, ℂ)`, where
`complexEllInfinityUnitSphere n` denotes the unit sphere of `(ℂⁿ, ‖·‖_∞)`, are complex Banach
lattice isometric. To do so, we develop the usual restriction (`restrict`) and radial extension
(`extend`) procedure between these spaces.
* The set of restrictions to the unit sphere of `complexLatticeLinearFunctions n` is dense
in `C(complexEllInfinityUnitSphere n, ℂ)`.
* Both functional calculi are preserved by complex vector lattice homomorphisms.
* The positively homogeneous functional calculus commutes with composition and substitution.
-/

open scoped BigOperators ComplexStarModule

/-! ### Lattice-linear functions in `C(ℂⁿ, ℂ)` -/

/-- Coordinate projections `z ↦ zᵢ` as elements of `C(ℂⁿ, ℂ)`. -/
noncomputable def continuousComplexCoordinate (n : ℕ) (i : Fin n) :
    C(Fin n → ℂ, ℂ) := by
  exact ⟨fun z ↦ z i, continuous_apply i⟩

/-- The complex vector sublattice of `C(ℂⁿ, ℂ)` generated by coordinate projections. -/
noncomputable def complexLatticeLinearFunctions (n : ℕ) :
    ComplexVectorSublattice C(Fin n → ℂ, ℂ) := by
  exact ComplexVectorSublattice.generated (Set.range (continuousComplexCoordinate n))

namespace ComplexLatticeLinearFunction

variable {n : ℕ}

/-- Complex lattice-linear functions can be evaluated at complex tuples. -/
noncomputable instance instCoeFun :
    CoeFun (complexLatticeLinearFunctions n) (fun _ ↦ (Fin n → ℂ) → ℂ) := by
  exact ⟨fun f ↦ f.1⟩

/-- The `i`-th coordinate projection, bundled with a proof of its membership
in `complexLatticeLinearFunctions`. -/
noncomputable def coordinate (i : Fin n) : complexLatticeLinearFunctions n := by
  exact ⟨continuousComplexCoordinate n i,
    ComplexVectorSublattice.subset_generated _ ⟨i, rfl⟩⟩

/-- Evaluating a coordinate projection returns the corresponding tuple entry. -/
@[simp]
theorem coordinate_apply (i : Fin n) (z : Fin n → ℂ) :
    coordinate i z = z i := by
  rfl

/-- Pointwise substitution of a continuous tuple into lattice-linear functions. -/
private noncomputable def continuousMapPullback
    {K : Type*} [TopologicalSpace K] (z : Fin n → C(K, ℂ)) :
    ComplexVecLatHom (complexLatticeLinearFunctions n) C(K, ℂ) := by
  let q : C(K, Fin n → ℂ) := ⟨fun t i ↦ z i t, continuous_pi fun i ↦ (z i).continuous⟩
  refine
    { toLinearMap := (ContinuousMap.compRightAlgHom ℂ ℂ q).toLinearMap.comp
        (complexLatticeLinearFunctions n).toSubmodule.subtype
      map_modulus' := ?_ }
  intro f
  apply ContinuousMap.ext
  intro t
  change (((ComplexVectorLattice.modulus f : selfAdjoint _) :
    complexLatticeLinearFunctions n) : C(Fin n → ℂ, ℂ)) (q t) =
      ((ComplexVectorLattice.modulus (f.val.comp q) : selfAdjoint C(K, ℂ)) : C(K, ℂ)) t
  rw [(complexLatticeLinearFunctions n).coe_modulus, ContinuousMap.modulus_apply,
    ContinuousMap.modulus_apply, ContinuousMap.comp_apply]

/-- Pointwise substitution sends each coordinate projection to the corresponding tuple entry. -/
private theorem continuousMapPullback_coordinate
    {K : Type*} [TopologicalSpace K] (z : Fin n → C(K, ℂ)) (i : Fin n) :
    continuousMapPullback z (coordinate i) = z i := by
  exact ContinuousMap.ext fun _ ↦ rfl

variable {Z : Type*}
  [AddCommGroup Z] [Module ℂ Z]
  [StarAddMonoid Z] [StarModule ℂ Z]
  [Lattice (selfAdjoint Z)] [IsOrderedAddMonoid (selfAdjoint Z)]
  [ComplexVectorLattice Z]

/-- The zero complex lattice homomorphism. -/
private noncomputable def zeroComplexVecLatHom :
    ComplexVecLatHom (complexLatticeLinearFunctions n) Z := by
  refine { toLinearMap := 0, map_modulus' := ?_ }
  simp

/-- The real and imaginary parts of each tuple entry belong to the principal ideal generated by
the sum of the tuple moduli. -/
private theorem parts_mem_principal_sum_modulus
    (z : Fin n → Z) (i : Fin n) :
    ℜ (z i) ∈ OrderIdeal.principal
        (∑ j, ComplexVectorLattice.modulus (z j)) ∧
      ℑ (z i) ∈ OrderIdeal.principal
        (∑ j, ComplexVectorLattice.modulus (z j)) := by
  have he : 0 ≤ ∑ j, ComplexVectorLattice.modulus (z j) :=
    Finset.sum_nonneg fun j _ ↦ ComplexVectorLattice.modulus_nonneg (z j)
  have hi : ComplexVectorLattice.modulus (z i) ≤
      ∑ j, ComplexVectorLattice.modulus (z j) :=
    Finset.single_le_sum (fun j _ ↦ ComplexVectorLattice.modulus_nonneg (z j))
      (Finset.mem_univ i)
  constructor
  · apply (OrderIdeal.principal _).mem_of_abs_le_abs (OrderIdeal.self_mem_principal _)
    simpa only [abs_of_nonneg he] using
      (ComplexVectorLattice.abs_realPart_le_modulus (z i)).trans hi
  · apply (OrderIdeal.principal _).mem_of_abs_le_abs (OrderIdeal.self_mem_principal _)
    simpa only [abs_of_nonneg he] using
      (ComplexVectorLattice.abs_imaginaryPart_le_modulus (z i)).trans hi

variable [IsUniformlyCompleteComplexVectorLattice Z]

/-- Construct the calculus through the complex representation of a nonzero
principal ideal, together with its coordinate identities. -/
private noncomputable def functionalCalculusOfPosData
    (z : Fin n → Z)
    (h : 0 < ∑ i, ComplexVectorLattice.modulus (z i)) :
    { T : ComplexVecLatHom (complexLatticeLinearFunctions n) Z //
      ∀ i, T (coordinate i) = z i } := by
  let e := ∑ i, ComplexVectorLattice.modulus (z i)
  letI := OrderIdeal.principalNormedAddCommGroup e
  letI : Lattice ↥(OrderIdeal.principal e) := OrderIdeal.instLatticePrincipal e
  letI : IsOrderedAddMonoid ↥(OrderIdeal.principal e) :=
    OrderIdeal.instIsOrderedAddMonoidPrincipal e
  letI : AMSpaceWithUnit ↥(OrderIdeal.principal e) :=
    OrderIdeal.principalAMSpaceWithUnit h.le
      (IsUniformlyCompleteVectorLattice.complete_principal e h)
  letI : IsUniformlyCompleteComplexVectorLattice
      (Complexification ↥(OrderIdeal.principal e)) :=
    isUniformlyCompleteComplexVectorLattice_of_complexBanachLattice _
  let u : Fin n → Complexification ↥(OrderIdeal.principal e) := fun i ↦
    ⟨⟨ℜ (z i), (parts_mem_principal_sum_modulus z i).1⟩,
      ⟨ℑ (z i), (parts_mem_principal_sum_modulus z i).2⟩⟩
  let j := ComplexVecLatHom.ofSelfAdjointVecLatHom
    ((OrderIdeal.principal e).subtype.comp
      Complexification.selfAdjointBanachLatEquiv.toVecLatEquiv.toVecLatHom)
  let k := OrderIdeal.complexPrincipalKakutaniEquiv h
  refine ⟨j.comp (k.symm.toComplexVecLatHom.comp
    (continuousMapPullback (fun i ↦ k (u i)))), ?_⟩
  intro i
  simp only [ComplexVecLatHom.comp_apply, continuousMapPullback_coordinate,
    ComplexBanachLatEquiv.toComplexVecLatHom_apply, ComplexBanachLatEquiv.symm_apply_apply]
  change ((Complexification.selfAdjointEquiv (ℜ (u i))).val : Z) +
    Complex.I • ((Complexification.selfAdjointEquiv (ℑ (u i))).val : Z) = z i
  rw [Complexification.selfAdjointEquiv_realPart,
    Complexification.selfAdjointEquiv_imaginaryPart]
  exact realPart_add_I_smul_imaginaryPart (z i)

/-- Combine the zero and positive-principal-ideal constructions. -/
private noncomputable def functionalCalculusData (z : Fin n → Z) :
    { T : ComplexVecLatHom (complexLatticeLinearFunctions n) Z //
      ∀ i, T (coordinate i) = z i } := by
  classical
  by_cases h : ∑ i, ComplexVectorLattice.modulus (z i) = 0
  · refine ⟨zeroComplexVecLatHom, ?_⟩
    intro i
    change 0 = z i
    exact (ComplexVectorLattice.modulus_eq_zero_iff (z i)).mp
      ((Finset.sum_eq_zero_iff_of_nonneg
        (fun j _ ↦ ComplexVectorLattice.modulus_nonneg (z j))).mp h i
          (Finset.mem_univ i)) |>.symm
  · exact functionalCalculusOfPosData z
      (lt_of_le_of_ne
        (Finset.sum_nonneg fun i _ ↦ ComplexVectorLattice.modulus_nonneg (z i))
        (Ne.symm h))

/-- The **lattice-linear functional calculus** associated to a tuple `z₁,...,zₙ ∈ Z`
in a complex vector lattice with uniformly complete self-adjoint part. -/
noncomputable def functionalCalculus (z : Fin n → Z) :
    ComplexVecLatHom (complexLatticeLinearFunctions n) Z := by
  exact (functionalCalculusData z).val

/-- The lattice-linear functional calculus sends the `i`-th coordinate
function to `z i`. -/
@[simp]
theorem functionalCalculus_coordinate (z : Fin n → Z) (i : Fin n) :
    functionalCalculus z (coordinate i) = z i := by
  exact (functionalCalculusData z).property i

/-- The **lattice-linear functional calculus** associated to `z₁,...,zₙ ∈ Z` is the
**unique** complex vector lattice homomorphism from `complexLatticeLinearFunctions n` to `Z`
such that `coordinate i ↦ z i`. -/
theorem eq_functionalCalculus_of_map_coordinate (z : Fin n → Z)
    (T : ComplexVecLatHom (complexLatticeLinearFunctions n) Z)
    (hT : ∀ i, T (coordinate i) = z i) :
    T = functionalCalculus z := by
  apply ComplexVecLatHom.ext_generated
  rintro _ ⟨i, rfl⟩
  exact (hT i).trans (functionalCalculus_coordinate z i).symm

end ComplexLatticeLinearFunction


/-! ### Functoriality of the lattice-linear functional calculus -/

namespace ComplexLatticeLinearFunction

variable {n : ℕ} {Z W : Type*}
  [AddCommGroup Z] [Module ℂ Z]
  [StarAddMonoid Z] [StarModule ℂ Z]
  [Lattice (selfAdjoint Z)] [IsOrderedAddMonoid (selfAdjoint Z)]
  [ComplexVectorLattice Z]
  [IsUniformlyCompleteComplexVectorLattice Z]
  [AddCommGroup W] [Module ℂ W]
  [StarAddMonoid W] [StarModule ℂ W]
  [Lattice (selfAdjoint W)] [IsOrderedAddMonoid (selfAdjoint W)]
  [ComplexVectorLattice W]
  [IsUniformlyCompleteComplexVectorLattice W]

/-- Lattice-linear functional calculus is preserved by complex vector lattice homomorphisms:
`T (functionalCalculus z f) = functionalCalculus (Tz) f`. -/
theorem functionalCalculus_map (T : ComplexVecLatHom Z W) (z : Fin n → Z)
    (f : complexLatticeLinearFunctions n) :
    T (functionalCalculus z f) =
      functionalCalculus (fun i ↦ T (z i)) f := by
  have h := eq_functionalCalculus_of_map_coordinate (fun i ↦ T (z i))
    (T.comp (functionalCalculus z)) (by
      intro i
      simp only [ComplexVecLatHom.comp_apply, functionalCalculus_coordinate])
  exact DFunLike.congr_fun h f

end ComplexLatticeLinearFunction

/-! ### Positively homogeneous functions in `ℂⁿ` -/

/-- The complex vector sublattice of continuous functions on `ℂⁿ` that are homogeneous
under multiplication by nonnegative real scalars. -/
noncomputable def complexPosHomFunctions (n : ℕ) :
    ComplexVectorSublattice C(Fin n → ℂ, ℂ) where
  toSubmodule :=
    { carrier := {f | ∀ c : ℝ, 0 ≤ c → ∀ z, f (c • z) = c • f z}
      zero_mem' := by
        simp
      add_mem' := by
        intro f g hf hg c hc z
        simp only [ContinuousMap.add_apply, hf c hc z, hg c hc z, smul_add]
      smul_mem' := by
        intro a f hf c hc z
        simp only [ContinuousMap.smul_apply, hf c hc z, smul_comm a c] }
  star_mem' := by
    intro f hf c hc z
    simp only [ContinuousMap.star_apply, hf c hc z, star_smul, star_trivial]
  modulus_mem' := by
    intro f hf c hc z
    rw [ContinuousMap.modulus_apply, ContinuousMap.modulus_apply, hf c hc z,
      norm_smul, Real.norm_of_nonneg hc]
    exact Complex.ofReal_mul c ‖f z‖

namespace ComplexPosHomFunction

variable {n : ℕ}

/-- Complex positively homogeneous functions can be evaluated at complex tuples. -/
noncomputable instance instCoeFun :
    CoeFun (complexPosHomFunctions n) (fun _ ↦ (Fin n → ℂ) → ℂ) := by
  exact ⟨fun f ↦ f.val⟩

/-- Complex positively homogeneous functions are equal if they agree pointwise. -/
@[ext]
theorem ext {f g : complexPosHomFunctions n} (h : ∀ z, f z = g z) :
    f = g := by
  exact Subtype.ext (ContinuousMap.ext h)

/-- A positively homogeneous function commutes with nonnegative real scalar multiplication. -/
@[simp]
theorem map_smul_of_nonneg (f : complexPosHomFunctions n) (c : ℝ) (hc : 0 ≤ c)
    (z : Fin n → ℂ) :
    f (c • z) = c • f z := by
  exact f.property c hc z

/-- A positively homogeneous function vanishes at zero. -/
@[simp]
theorem map_zero (f : complexPosHomFunctions n) :
    f 0 = 0 := by
  simpa only [zero_smul] using
    map_smul_of_nonneg f 0 le_rfl (0 : Fin n → ℂ)

/-- The `i`-th coordinate projection, bundled with a proof of its membership
in `complexPosHomFunctions`. -/
noncomputable def coordinate (i : Fin n) : complexPosHomFunctions n := by
  exact ⟨continuousComplexCoordinate n i, fun _ _ _ ↦ rfl⟩

/-- Evaluating a coordinate projection returns the corresponding tuple entry. -/
@[simp]
theorem coordinate_apply (i : Fin n) (z : Fin n → ℂ) :
    coordinate i z = z i := by
  rfl

/-- Complex lattice-linear functions form a complex vector sublattice
of continuous positively homogeneous functions. -/
theorem complexLatticeLinearFunctions_le_complexPosHomFunctions :
    complexLatticeLinearFunctions n ≤ complexPosHomFunctions n := by
  apply ComplexVectorSublattice.generated_le
  rintro _ ⟨i, rfl⟩ c hc z
  rfl

/-- The inclusion of complex lattice-linear functions into positively homogeneous functions
as a complex vector lattice homomorphism. -/
noncomputable def latticeLinearInclusion :
    ComplexVecLatHom (complexLatticeLinearFunctions n) (complexPosHomFunctions n) := by
  exact ComplexVectorSublattice.inclusion
    complexLatticeLinearFunctions_le_complexPosHomFunctions

/-- Inclusion preserves the pointwise values of a complex lattice-linear function. -/
@[simp]
theorem latticeLinearInclusion_apply (f : complexLatticeLinearFunctions n)
    (z : Fin n → ℂ) :
    latticeLinearInclusion f z = f z := by
  rfl

end ComplexPosHomFunction

/-! ### Restriction to the unit sphere of `(ℂⁿ, ‖·‖_∞)` -/

/-- The unit sphere of `(ℂⁿ, ‖·‖_∞)`. -/
def complexEllInfinityUnitSphere (n : ℕ) : Set (Fin n → ℂ) :=
  Metric.sphere 0 1

/-- The unit sphere of `(ℂⁿ, ‖·‖_∞)` is compact. -/
noncomputable instance instCompactSpaceComplexEllInfinityUnitSphere (n : ℕ) :
    CompactSpace (complexEllInfinityUnitSphere n) := by
  unfold complexEllInfinityUnitSphere
  infer_instance

namespace ComplexPosHomFunction

variable {n : ℕ}

/-- Restriction of complex positively homogeneous functions to the unit sphere,
as a complex vector lattice homomorphism. -/
noncomputable def restrict :
    ComplexVecLatHom (complexPosHomFunctions n)
      C(complexEllInfinityUnitSphere n, ℂ) := by
  let q : C(complexEllInfinityUnitSphere n, Fin n → ℂ) :=
    ⟨Subtype.val, continuous_subtype_val⟩
  refine
    { toLinearMap := (ContinuousMap.compRightAlgHom ℂ ℂ q).toLinearMap.comp
        (complexPosHomFunctions n).toSubmodule.subtype
      map_modulus' := ?_ }
  intro f
  apply ContinuousMap.ext
  intro z
  change (((ComplexVectorLattice.modulus f : selfAdjoint _) :
    complexPosHomFunctions n) : C(Fin n → ℂ, ℂ)) (q z) =
      ((ComplexVectorLattice.modulus (f.val.comp q) : selfAdjoint _) :
        C(complexEllInfinityUnitSphere n, ℂ)) z
  rw [(complexPosHomFunctions n).coe_modulus, ContinuousMap.modulus_apply,
    ContinuousMap.modulus_apply, ContinuousMap.comp_apply]

/-- Restriction preserves pointwise values on the unit sphere. -/
@[simp]
theorem restrict_apply (f : complexPosHomFunctions n)
    (z : complexEllInfinityUnitSphere n) :
    restrict f z = f (z : Fin n → ℂ) := by
  rfl

/-- The normalization map `ℂⁿ ∖ {0} → {z | ‖z‖_∞ = 1}` given by `z ↦ ‖z‖_∞⁻¹ • z`. -/
private noncomputable def normalize :
    {z : Fin n → ℂ // z ≠ 0} → complexEllInfinityUnitSphere n := fun z ↦
  ⟨‖(z : Fin n → ℂ)‖⁻¹ • z, by
    rw [complexEllInfinityUnitSphere, Metric.mem_sphere, dist_zero_right, norm_smul,
      norm_inv, Real.norm_eq_abs, abs_norm,
      inv_mul_cancel₀ (norm_ne_zero_iff.mpr z.2)]⟩

/-- Normalization is continuous away from the origin. -/
private theorem continuous_normalize : Continuous (normalize (n := n)) := by
  exact continuous_induced_rng.mpr
    (((continuous_norm.comp continuous_subtype_val).inv₀
      (fun z ↦ norm_ne_zero_iff.mpr z.2)).smul continuous_subtype_val)

/-- For every nonzero `z ∈ ℂⁿ`, multiplying `normalize z` by `‖z‖_∞` recovers `z`. -/
private theorem norm_smul_normalize (z : {z : Fin n → ℂ // z ≠ 0}) :
    ‖(z : Fin n → ℂ)‖ • (normalize z : Fin n → ℂ) = z := by
  change ‖(z : Fin n → ℂ)‖ • (‖(z : Fin n → ℂ)‖⁻¹ • (z : Fin n → ℂ)) =
    (z : Fin n → ℂ)
  rw [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.mpr z.2), one_smul]

/-- Normalize a nonzero vector to the unit sphere of `(ℂⁿ, ‖·‖_∞)`. -/
private noncomputable def unitNormalize (z : Fin n → ℂ) (hz : z ≠ 0) :
    complexEllInfinityUnitSphere n := normalize ⟨z, hz⟩

/-- Normalization is invariant under multiplication by a positive real scalar. -/
private theorem unitNormalize_smul_of_pos (c : ℝ) (hc : 0 < c)
    (z : Fin n → ℂ) (hz : z ≠ 0) :
    unitNormalize (c • z) (smul_ne_zero hc.ne' hz) = unitNormalize z hz := by
  apply Subtype.ext
  change ‖c • z‖⁻¹ • (c • z) = ‖z‖⁻¹ • z
  rw [norm_smul, Real.norm_of_nonneg hc.le, smul_smul]
  apply congrArg (fun a : ℝ ↦ a • z)
  field_simp

/-- The radial extension of a continuous function on the unit sphere of `(ℂⁿ, ‖·‖_∞)` to `ℂⁿ`,
taking the value `0` at zero. -/
private noncomputable def radialExtension
    (g : C(complexEllInfinityUnitSphere n, ℂ)) (z : Fin n → ℂ) : ℂ :=
  if hz : z = 0 then 0 else ‖z‖ • g (unitNormalize z hz)

/-- The radial extension of a continuous function on the unit sphere vanishes at the origin. -/
@[simp]
private theorem radialExtension_zero (g : C(complexEllInfinityUnitSphere n, ℂ)) :
    radialExtension g 0 = 0 := by
  simp [radialExtension]

/-- Formula for the radial extension of a continuous function on the unit sphere away from the
origin. -/
@[simp]
private theorem radialExtension_of_ne (g : C(complexEllInfinityUnitSphere n, ℂ))
    {z : Fin n → ℂ} (hz : z ≠ 0) :
    radialExtension g z = ‖z‖ • g (unitNormalize z hz) := by
  rw [radialExtension, dif_neg hz]

/-- The norm of a radial extension at `z` is bounded by `‖z‖` times the supremum norm of the
original function on the unit sphere. -/
private theorem norm_radialExtension_le (g : C(complexEllInfinityUnitSphere n, ℂ))
    (z : Fin n → ℂ) :
    ‖radialExtension g z‖ ≤ ‖z‖ * ‖g‖ := by
  by_cases hz : z = 0
  · simp [hz]
  · rw [radialExtension_of_ne g hz, norm_smul, Real.norm_of_nonneg (norm_nonneg z)]
    exact mul_le_mul_of_nonneg_left (ContinuousMap.norm_coe_le_norm g _) (norm_nonneg z)

/-- The radial extension of a continuous function on the unit sphere is continuous at the
origin. -/
private theorem continuousAt_radialExtension_zero
    (g : C(complexEllInfinityUnitSphere n, ℂ)) :
    ContinuousAt (radialExtension g) 0 := by
  change Filter.Tendsto (radialExtension g) (nhds 0) (nhds (radialExtension g 0))
  rw [radialExtension_zero]
  apply squeeze_zero_norm (norm_radialExtension_le g)
  simpa only [ContinuousAt, norm_zero, zero_mul] using
    (continuous_norm.mul_const ‖g‖).continuousAt (x := (0 : Fin n → ℂ))

/-- The radial extension of a continuous function on the unit sphere is continuous on `ℂⁿ`. -/
private theorem continuous_radialExtension (g : C(complexEllInfinityUnitSphere n, ℂ)) :
    Continuous (radialExtension g) := by
  rw [continuous_iff_continuousAt]
  intro z
  by_cases hz : z = 0
  · subst z
    exact continuousAt_radialExtension_zero g
  · have h : ContinuousOn (radialExtension g) ({0}ᶜ : Set (Fin n → ℂ)) := by
      rw [continuousOn_iff_continuous_restrict]
      change Continuous (fun w : {w : Fin n → ℂ // w ≠ 0} ↦ radialExtension g w)
      apply Continuous.congr
        ((continuous_norm.comp continuous_subtype_val).smul
          (g.continuous.comp (continuous_normalize (n := n))))
      intro w
      exact (radialExtension_of_ne g w.2).symm
    exact h.continuousAt (isOpen_compl_singleton.mem_nhds hz)

/-- The radial extension of a continuous function on the unit sphere is positively homogeneous.
-/
private theorem radialExtension_smul_of_nonneg
    (g : C(complexEllInfinityUnitSphere n, ℂ)) (c : ℝ) (hc : 0 ≤ c)
    (z : Fin n → ℂ) :
    radialExtension g (c • z) = c • radialExtension g z := by
  rcases hc.eq_or_lt with rfl | hc
  · simp
  by_cases hz : z = 0
  · simp [hz]
  have hcz : c • z ≠ 0 := smul_ne_zero hc.ne' hz
  rw [radialExtension_of_ne g hcz, radialExtension_of_ne g hz,
    unitNormalize_smul_of_pos c hc z hz, norm_smul, Real.norm_of_nonneg hc.le,
    smul_smul]

/-- Every point of the unit sphere of `(ℂⁿ, ‖·‖_∞)` has norm one. -/
private theorem norm_coe_sphere (z : complexEllInfinityUnitSphere n) :
    ‖(z : Fin n → ℂ)‖ = 1 := by
  simpa only [complexEllInfinityUnitSphere, Metric.mem_sphere, dist_zero_right] using z.property

/-- A function and its radial extension agree on the unit sphere. -/
private theorem radialExtension_sphere (g : C(complexEllInfinityUnitSphere n, ℂ))
    (z : complexEllInfinityUnitSphere n) :
    radialExtension g (z : Fin n → ℂ) = g z := by
  have hz : (z : Fin n → ℂ) ≠ 0 := norm_ne_zero_iff.mp (by
    rw [norm_coe_sphere]
    exact one_ne_zero)
  rw [radialExtension_of_ne g hz]
  have hu : unitNormalize (z : Fin n → ℂ) hz = z := by
    apply Subtype.ext
    change ‖(z : Fin n → ℂ)‖⁻¹ • (z : Fin n → ℂ) = (z : Fin n → ℂ)
    rw [norm_coe_sphere, inv_one, one_smul]
  rw [hu, norm_coe_sphere, one_smul]

/-- A positively homogeneous function is determined by its values on the unit sphere of `(ℂⁿ,
‖·‖_∞)`. -/
private theorem eq_norm_smul_unit (f : complexPosHomFunctions n)
    {z : Fin n → ℂ} (hz : z ≠ 0) :
    f z = ‖z‖ • f (unitNormalize z hz) := by
  calc
    f z = f (‖z‖ • (normalize ⟨z, hz⟩ : Fin n → ℂ)) :=
      congrArg f (norm_smul_normalize ⟨z, hz⟩).symm
    _ = ‖z‖ • f (unitNormalize z hz) :=
      map_smul_of_nonneg f ‖z‖ (norm_nonneg z) _

/-- A positively homogeneous function is determined by its restriction to the unit sphere. -/
theorem restrict_injective :
    Function.Injective (restrict (n := n)) := by
  intro f g hfg
  apply ext
  intro z
  by_cases hz : z = 0
  · subst z
    rw [map_zero, map_zero]
  · rw [eq_norm_smul_unit f hz, eq_norm_smul_unit g hz]
    exact congrArg (fun q : C(complexEllInfinityUnitSphere n, ℂ) ↦
      ‖z‖ • q (unitNormalize z hz)) hfg

/-- Radial extension sends a continuous function on the unit sphere to a continuous
positively homogeneous function, with value zero at the origin. -/
noncomputable def extend :
    C(complexEllInfinityUnitSphere n, ℂ) → complexPosHomFunctions n := by
  exact fun g ↦ ⟨⟨radialExtension g, continuous_radialExtension g⟩,
    radialExtension_smul_of_nonneg g⟩

/-- Radial extension has the prescribed values along nonnegative rays from the unit sphere. -/
theorem extend_apply (g : C(complexEllInfinityUnitSphere n, ℂ))
    (z : complexEllInfinityUnitSphere n) (r : ℝ) (hr : 0 ≤ r) :
    extend g (r • (z : Fin n → ℂ)) = r • g z := by
  rw [map_smul_of_nonneg _ r hr]
  exact congrArg (fun w : ℂ ↦ r • w) (radialExtension_sphere g z)

/-- Radial extension vanishes at the origin. -/
theorem extend_apply_zero (g : C(complexEllInfinityUnitSphere n, ℂ)) :
    extend g 0 = 0 := by
  exact map_zero (extend g)

/-- Restricting a radial extension recovers the original function on the unit sphere. -/
@[simp]
theorem restrict_extend (g : C(complexEllInfinityUnitSphere n, ℂ)) :
    restrict (extend g) = g := by
  exact ContinuousMap.ext fun z ↦ radialExtension_sphere g z

/-- Radially extending a restriction recovers the original positively homogeneous function. -/
@[simp]
theorem extend_restrict (f : complexPosHomFunctions n) :
    extend (restrict f) = f := by
  exact restrict_injective (restrict_extend (restrict f))

/-- The complex vector lattice of continuous positively homogeneous functions on `ℂⁿ` is
isomorphic to `C(complexEllInfinityUnitSphere n, ℂ)`. The isomorphism is given by
restriction (`restrict`) and radial extension (`extend`). -/
noncomputable def ellInfinityUnitSphereEquiv :
    ComplexVecLatEquiv (complexPosHomFunctions n)
      C(complexEllInfinityUnitSphere n, ℂ) := by
  exact
    { toLinearEquiv :=
        { toFun := restrict
          invFun := extend
          left_inv := extend_restrict
          right_inv := restrict_extend
          map_add' := map_add (restrict (n := n))
          map_smul' := map_smul (restrict (n := n)) }
      map_modulus' := (restrict (n := n)).map_modulus }

/-- The sphere equivalence is evaluated by restriction. -/
@[simp]
theorem ellInfinityUnitSphereEquiv_apply (f : complexPosHomFunctions n)
    (z : complexEllInfinityUnitSphere n) :
    ellInfinityUnitSphereEquiv f z = f (z : Fin n → ℂ) := by
  rfl

/-- The inverse sphere equivalence is radial extension. -/
@[simp]
theorem ellInfinityUnitSphereEquiv_symm_apply
    (g : C(complexEllInfinityUnitSphere n, ℂ)) :
    (ellInfinityUnitSphereEquiv (n := n)).symm g = extend g := by
  rfl

end ComplexPosHomFunction

/-! ### Positively homogeneous functions as a complex Banach lattice -/

namespace ComplexPosHomFunction

variable {n : ℕ}

/-- The norm of a positively homogeneous function is its supremum norm on the unit sphere. -/
noncomputable instance instNorm : Norm (complexPosHomFunctions n) where
  norm f := ‖restrict f‖

/-- Restriction preserves the norm of a positively homogeneous function. -/
@[simp]
theorem norm_restrict (f : complexPosHomFunctions n) :
    ‖restrict f‖ = ‖f‖ := by
  rfl

/-- The sphere norm makes positively homogeneous functions a normed additive group. -/
noncomputable instance instNormedAddCommGroup :
    NormedAddCommGroup (complexPosHomFunctions n) := by
  exact NormedAddCommGroup.induced (complexPosHomFunctions n)
    C(complexEllInfinityUnitSphere n, ℂ)
    (restrict (n := n)).toLinearMap.toAddHom restrict_injective

/-- The sphere norm is compatible with complex scalar multiplication. -/
noncomputable instance instNormedSpace : NormedSpace ℂ (complexPosHomFunctions n) := by
  exact NormedSpace.induced ℂ (complexPosHomFunctions n)
    C(complexEllInfinityUnitSphere n, ℂ) (restrict (n := n)).toLinearMap

/-- Restriction is a complex-linear isometric equivalence between
`complexPosHomFunctions n` and `C(complexEllInfinityUnitSphere n, ℂ)`. -/
noncomputable def ellInfinityUnitSphereIsometry :
    complexPosHomFunctions n ≃ₗᵢ[ℂ] C(complexEllInfinityUnitSphere n, ℂ) := by
  exact
    { (ellInfinityUnitSphereEquiv (n := n)).toLinearEquiv with
      norm_map' := norm_restrict }

/-- The sphere norm on positively homogeneous functions is complete. -/
instance instCompleteSpace :
    @CompleteSpace (complexPosHomFunctions n)
      (instNormedAddCommGroup (n := n)).toUniformSpace := by
  exact (ellInfinityUnitSphereIsometry (n := n)).toIsometryEquiv.completeSpace

/-- Restriction identifies self-adjoint positively homogeneous functions with self-adjoint
continuous functions on the unit sphere as real vector lattices. -/
private noncomputable def selfAdjointSphereEquiv :
    VecLatEquiv (selfAdjoint (complexPosHomFunctions n))
      (selfAdjoint C(complexEllInfinityUnitSphere n, ℂ)) := by
  let e := ellInfinityUnitSphereEquiv (n := n)
  let T := e.toComplexVecLatHom.toSelfAdjointVecLatHom
  let U := e.symm.toComplexVecLatHom.toSelfAdjointVecLatHom
  refine
    { toLinearEquiv :=
        { T.toLinearMap with
          invFun := U
          left_inv := ?_
          right_inv := ?_ }
      map_sup' := T.map_sup'
      map_inf' := T.map_inf' }
  · intro x
    apply Subtype.ext
    change e.symm (e (x : complexPosHomFunctions n)) = (x : complexPosHomFunctions n)
    exact e.symm_apply_apply _
  · intro y
    apply Subtype.ext
    change e (e.symm (y : C(complexEllInfinityUnitSphere n, ℂ))) =
      (y : C(complexEllInfinityUnitSphere n, ℂ))
    exact e.apply_symm_apply _

/-- Restriction preserves the norm of a self-adjoint positively homogeneous function. -/
private theorem norm_selfAdjointSphereEquiv (x : selfAdjoint (complexPosHomFunctions n)) :
    ‖selfAdjointSphereEquiv x‖ = ‖x‖ := by
  rfl

/-- Restriction is an isometric equivalence between the self-adjoint parts of the positively
homogeneous functions and the continuous functions on the unit sphere. -/
private noncomputable def selfAdjointSphereIsometry :
    selfAdjoint (complexPosHomFunctions n) ≃ᵢ
      selfAdjoint C(complexEllInfinityUnitSphere n, ℂ) := by
  exact
    { (selfAdjointSphereEquiv (n := n)).toLinearEquiv.toEquiv with
      isometry_toFun := AddMonoidHomClass.isometry_of_norm
        (selfAdjointSphereEquiv (n := n)).toLinearEquiv norm_selfAdjointSphereEquiv }

/-- The self-adjoint part is a real Banach lattice for the sphere norm. -/
noncomputable instance instBanachLatticeSelfAdjoint :
    BanachLattice (selfAdjoint (complexPosHomFunctions n)) := by
  let e := selfAdjointSphereEquiv (n := n)
  refine { solid := ?_, norm_smul := ?_, toCompleteSpace := ?_ }
  · intro x y hxy
    rw [← norm_selfAdjointSphereEquiv x, ← norm_selfAdjointSphereEquiv y]
    apply norm_le_norm_of_abs_le_abs
    change |e.toVecLatHom x| ≤ |e.toVecLatHom y|
    rw [← VecLatHom.map_abs, ← VecLatHom.map_abs]
    exact e.toVecLatHom.monotone hxy
  · intro r x
    rw [← norm_selfAdjointSphereEquiv (r • x), ← norm_selfAdjointSphereEquiv x]
    change ‖e.toLinearEquiv (r • x)‖ = ‖r‖ * ‖e.toLinearEquiv x‖
    rw [map_smul, norm_smul]
  · exact @IsometryEquiv.completeSpace _ _ _ _
      (BanachLattice.toCompleteSpace
        (X := selfAdjoint C(complexEllInfinityUnitSphere n, ℂ)))
      (selfAdjointSphereIsometry (n := n))

/-- The sphere norm makes positively homogeneous functions a complex Banach lattice. -/
noncomputable instance instComplexBanachLattice :
    ComplexBanachLattice (complexPosHomFunctions n) := by
  refine
    { instBanachLatticeSelfAdjoint (n := n),
      (complexPosHomFunctions n).instComplexVectorLatticeCoe with
      norm_modulus := ?_ }
  intro f
  change ‖restrict ((ComplexVectorLattice.modulus f : selfAdjoint _) :
    complexPosHomFunctions n)‖ = ‖restrict f‖
  rw [ComplexVecLatHom.map_modulus]
  exact ComplexBanachLattice.norm_modulus (restrict f)

/-- Restriction is a complex Banach lattice isometric equivalence between
`complexPosHomFunctions n` and `C(complexEllInfinityUnitSphere n, ℂ)`. -/
noncomputable def ellInfinityUnitSphereBanachLatEquiv :
    ComplexBanachLatEquiv (complexPosHomFunctions n)
      C(complexEllInfinityUnitSphere n, ℂ) := by
  exact
    { toLinearIsometryEquiv := ellInfinityUnitSphereIsometry
      map_modulus' := (ellInfinityUnitSphereEquiv (n := n)).map_modulus }

/-- Evaluation is bounded by the tuple norm times the sphere norm of the function. -/
theorem norm_apply_le_norm_mul_norm (f : complexPosHomFunctions n) (z : Fin n → ℂ) :
    ‖f z‖ ≤ ‖z‖ * ‖f‖ := by
  by_cases hz : z = 0
  · subst z
    rw [map_zero, norm_zero, norm_zero, zero_mul]
  · rw [eq_norm_smul_unit f hz, norm_smul, Real.norm_of_nonneg (norm_nonneg z)]
    apply mul_le_mul_of_nonneg_left _ (norm_nonneg z)
    simpa only [restrict_apply, norm_restrict] using
      ContinuousMap.norm_coe_le_norm (restrict f) (unitNormalize z hz)

end ComplexPosHomFunction

/-! ### Density of lattice-linear restrictions on the complex unit sphere -/

namespace ComplexPosHomFunction

variable {n : ℕ}

/-- Restrict a self-adjoint lattice-linear function to the sphere and identify its values
with real numbers. -/
private noncomputable def selfAdjointLatticeLinearRestriction :
    VecLatHom (selfAdjoint (complexLatticeLinearFunctions n))
      C(complexEllInfinityUnitSphere n, ℝ) := by
  exact ContinuousMap.selfAdjointBanachLatEquiv.toVecLatEquiv.toVecLatHom.comp
    ((restrict (n := n)).comp latticeLinearInclusion).toSelfAdjointVecLatHom

/-- Restriction of a self-adjoint lattice-linear function is evaluated by taking its pointwise
real part. -/
private theorem selfAdjointLatticeLinearRestriction_apply
    (f : selfAdjoint (complexLatticeLinearFunctions n))
    (z : complexEllInfinityUnitSphere n) :
    selfAdjointLatticeLinearRestriction f z =
      ((f : complexLatticeLinearFunctions n) (z : Fin n → ℂ)).re := by
  rfl

/-- The restriction of the modulus of a coordinate projection is the pointwise coordinate norm.
-/
private theorem restriction_modulus_coordinate (i : Fin n)
    (z : complexEllInfinityUnitSphere n) :
    selfAdjointLatticeLinearRestriction
      (ComplexVectorLattice.modulus (ComplexLatticeLinearFunction.coordinate i)) z =
        ‖(z : Fin n → ℂ) i‖ := by
  rw [selfAdjointLatticeLinearRestriction_apply]
  change (((complexLatticeLinearFunctions n).subtype
    ((ComplexVectorLattice.modulus (ComplexLatticeLinearFunction.coordinate i) :
      selfAdjoint (complexLatticeLinearFunctions n)) : complexLatticeLinearFunctions n))
        (z : Fin n → ℂ)).re = _
  rw [ComplexVecLatHom.map_modulus, ContinuousMap.modulus_apply]
  rfl

/-- The restriction of the real part of a coordinate projection is the pointwise coordinate real
part. -/
private theorem restriction_realPart_coordinate (i : Fin n)
    (z : complexEllInfinityUnitSphere n) :
    selfAdjointLatticeLinearRestriction (ℜ (ComplexLatticeLinearFunction.coordinate i)) z =
      ((z : Fin n → ℂ) i).re := by
  rw [selfAdjointLatticeLinearRestriction_apply]
  change (((complexLatticeLinearFunctions n).subtype
    (ℜ (ComplexLatticeLinearFunction.coordinate i) : complexLatticeLinearFunctions n))
      (z : Fin n → ℂ)).re = _
  rw [ComplexVecLatHom.map_realPart, ContinuousMap.realPart_apply_re]
  rfl

/-- The restriction of the imaginary part of a coordinate projection is the pointwise coordinate
imaginary part. -/
private theorem restriction_imaginaryPart_coordinate (i : Fin n)
    (z : complexEllInfinityUnitSphere n) :
    selfAdjointLatticeLinearRestriction (ℑ (ComplexLatticeLinearFunction.coordinate i)) z =
      ((z : Fin n → ℂ) i).im := by
  rw [selfAdjointLatticeLinearRestriction_apply]
  change (((complexLatticeLinearFunctions n).subtype
    (ℑ (ComplexLatticeLinearFunction.coordinate i) : complexLatticeLinearFunctions n))
      (z : Fin n → ℂ)).re = _
  rw [ComplexVecLatHom.map_imaginaryPart, ContinuousMap.imaginaryPart_apply_re]
  rfl

/-- The greatest coordinate norm of a point on the unit sphere is one. -/
private theorem isGreatest_coord_norm (z : complexEllInfinityUnitSphere n) :
    IsGreatest (Set.range fun i : Fin n ↦ ‖(z : Fin n → ℂ) i‖) 1 := by
  have hnorm := norm_coe_sphere z
  haveI : Nonempty (Fin n) := by
    have hz : (z : Fin n → ℂ) ≠ 0 := norm_ne_zero_iff.mp (by
      rw [hnorm]
      exact one_ne_zero)
    obtain ⟨i, _⟩ := Function.ne_iff.mp hz
    exact ⟨i⟩
  obtain ⟨i, hi⟩ := (IsGreatest.pi_norm (z : Fin n → ℂ)).1
  refine ⟨⟨i, hi.trans hnorm⟩, ?_⟩
  rintro _ ⟨j, rfl⟩
  exact (norm_le_pi_norm (z : Fin n → ℂ) j).trans_eq hnorm

/-- At any two points of the unit sphere, some self-adjoint lattice-linear function takes the
value one at both points. -/
private theorem exists_latticeLinear_twoPointUnit
    (y z : complexEllInfinityUnitSphere n) :
    ∃ u : selfAdjoint (complexLatticeLinearFunctions n),
      selfAdjointLatticeLinearRestriction u y = 1 ∧
        selfAdjointLatticeLinearRestriction u z = 1 := by
  have hy := isGreatest_coord_norm y
  have hz := isGreatest_coord_norm z
  obtain ⟨iy, hiy⟩ := hy.1
  obtain ⟨iz, hiz⟩ := hz.1
  change ‖(y : Fin n → ℂ) iy‖ = 1 at hiy
  change ‖(z : Fin n → ℂ) iz‖ = 1 at hiz
  let u := ComplexVectorLattice.modulus (ComplexLatticeLinearFunction.coordinate iy) ⊔
    ComplexVectorLattice.modulus (ComplexLatticeLinearFunction.coordinate iz)
  refine ⟨u, ?_, ?_⟩
  · change selfAdjointLatticeLinearRestriction
      (ComplexVectorLattice.modulus (ComplexLatticeLinearFunction.coordinate iy) ⊔
        ComplexVectorLattice.modulus (ComplexLatticeLinearFunction.coordinate iz)) y = 1
    rw [map_sup, ContinuousMap.sup_apply, restriction_modulus_coordinate,
      restriction_modulus_coordinate, hiy, max_eq_left (hy.2 ⟨iz, rfl⟩)]
  · change selfAdjointLatticeLinearRestriction
      (ComplexVectorLattice.modulus (ComplexLatticeLinearFunction.coordinate iy) ⊔
        ComplexVectorLattice.modulus (ComplexLatticeLinearFunction.coordinate iz)) z = 1
    rw [map_sup, ContinuousMap.sup_apply, restriction_modulus_coordinate,
      restriction_modulus_coordinate, hiz, max_eq_right (hz.2 ⟨iy, rfl⟩)]

/-- Self-adjoint lattice-linear restrictions separate distinct points of the unit sphere. -/
private theorem exists_latticeLinear_separating
    {y z : complexEllInfinityUnitSphere n} (hyz : y ≠ z) :
    ∃ q : selfAdjoint (complexLatticeLinearFunctions n),
      selfAdjointLatticeLinearRestriction q y ≠
        selfAdjointLatticeLinearRestriction q z := by
  have hyz_val : (y : Fin n → ℂ) ≠ (z : Fin n → ℂ) := by
    exact fun h ↦ hyz (Subtype.ext h)
  obtain ⟨k, hk⟩ := Function.ne_iff.mp hyz_val
  by_cases hre : ((y : Fin n → ℂ) k).re = ((z : Fin n → ℂ) k).re
  · have him : ((y : Fin n → ℂ) k).im ≠ ((z : Fin n → ℂ) k).im := by
      exact fun h ↦ hk (Complex.ext hre h)
    refine ⟨ℑ (ComplexLatticeLinearFunction.coordinate k), ?_⟩
    simpa only [restriction_imaginaryPart_coordinate] using him
  · refine ⟨ℜ (ComplexLatticeLinearFunction.coordinate k), ?_⟩
    simpa only [restriction_realPart_coordinate] using hre

/-- Self-adjoint lattice-linear restrictions interpolate arbitrary real values
at any two sphere points. -/
private theorem latticeLinearRestriction_twoPointInterpolation
    (v : complexEllInfinityUnitSphere n → ℝ)
    (y z : complexEllInfinityUnitSphere n) :
    ∃ f : selfAdjoint (complexLatticeLinearFunctions n),
      selfAdjointLatticeLinearRestriction f y = v y ∧
        selfAdjointLatticeLinearRestriction f z = v z := by
  classical
  obtain ⟨u, huy, huz⟩ := exists_latticeLinear_twoPointUnit y z
  let R := selfAdjointLatticeLinearRestriction (n := n)
  change R u y = 1 at huy
  change R u z = 1 at huz
  by_cases hyz : y = z
  · subst z
    refine ⟨(v y) • u, ?_, ?_⟩ <;>
      change R ((v y) • u) y = v y
    all_goals simp only [map_smul, ContinuousMap.smul_apply, huy, smul_eq_mul, mul_one]
  · obtain ⟨q, hq⟩ := exists_latticeLinear_separating hyz
    let c := (v z - v y) / (R q z - R q y)
    let g := c • (q - (R q y) • u) + (v y) • u
    refine ⟨g, ?_, ?_⟩
    · change R (c • (q - (R q y) • u) + (v y) • u) y = v y
      simp only [map_add, map_smul, map_sub, ContinuousMap.add_apply,
        ContinuousMap.smul_apply, ContinuousMap.sub_apply, huy, smul_eq_mul]
      ring
    · change R (c • (q - (R q y) • u) + (v y) • u) z = v z
      simp only [map_add, map_smul, map_sub, ContinuousMap.add_apply,
        ContinuousMap.smul_apply, ContinuousMap.sub_apply, huz, smul_eq_mul]
      have hden : R q z - R q y ≠ 0 := sub_ne_zero.mpr hq.symm
      dsimp [c]
      field_simp
      ring

/-- Restrictions of self-adjoint lattice-linear functions are dense in the real-valued
continuous functions on the unit sphere. -/
private theorem denseRange_selfAdjointLatticeLinearRestriction :
    DenseRange (selfAdjointLatticeLinearRestriction (n := n)) := by
  let R := selfAdjointLatticeLinearRestriction (n := n)
  let L : Set C(complexEllInfinityUnitSphere n, ℝ) := Set.range R
  have hL_nonempty : L.Nonempty := ⟨R 0, 0, rfl⟩
  have hL_inf : ∀ f ∈ L, ∀ g ∈ L, f ⊓ g ∈ L := by
    rintro _ ⟨f, rfl⟩ _ ⟨g, rfl⟩
    exact ⟨f ⊓ g, R.map_inf' f g⟩
  have hL_sup : ∀ f ∈ L, ∀ g ∈ L, f ⊔ g ∈ L := by
    rintro _ ⟨f, rfl⟩ _ ⟨g, rfl⟩
    exact ⟨f ⊔ g, R.map_sup' f g⟩
  have hL_sep : L.SeparatesPointsStrongly := by
    intro v y z
    obtain ⟨f, hy, hz⟩ := latticeLinearRestriction_twoPointInterpolation v y z
    exact ⟨R f, ⟨f, rfl⟩, hy, hz⟩
  rw [denseRange_iff_closure_range]
  exact ContinuousMap.sublattice_closure_eq_top L hL_nonempty hL_inf hL_sup hL_sep

/-- The distance between self-adjoint functions on the unit sphere is preserved by identifying
their values with real numbers. -/
private theorem norm_selfAdjointRestriction_sub
    (f : selfAdjoint (complexLatticeLinearFunctions n))
    (g : selfAdjoint C(complexEllInfinityUnitSphere n, ℂ)) :
    ‖restrict (latticeLinearInclusion (f : complexLatticeLinearFunctions n)) -
        (g : C(complexEllInfinityUnitSphere n, ℂ))‖ =
      ‖selfAdjointLatticeLinearRestriction f -
        ContinuousMap.selfAdjointBanachLatEquiv g‖ := by
  let T := ((restrict (n := n)).comp latticeLinearInclusion).toSelfAdjointVecLatHom
  let e := (ContinuousMap.selfAdjointBanachLatEquiv
    (K := complexEllInfinityUnitSphere n)).toLinearIsometryEquiv
  change ‖T f - g‖ = ‖e (T f) - e g‖
  rw [← map_sub, e.norm_map]

/-- Every continuous complex-valued function on the unit sphere can be uniformly approximated by
a lattice-linear restriction. -/
private theorem exists_latticeLinearRestriction_close
    (g : C(complexEllInfinityUnitSphere n, ℂ)) (ε : ℝ) (hε : 0 < ε) :
    ∃ f : complexLatticeLinearFunctions n,
      dist g (restrict (latticeLinearInclusion f)) < ε := by
  let e := ContinuousMap.selfAdjointBanachLatEquiv
    (K := complexEllInfinityUnitSphere n)
  obtain ⟨u, hu⟩ := Metric.denseRange_iff.mp
    denseRange_selfAdjointLatticeLinearRestriction (e (ℜ g)) (ε / 2) (half_pos hε)
  obtain ⟨v, hv⟩ := Metric.denseRange_iff.mp
    denseRange_selfAdjointLatticeLinearRestriction (e (ℑ g)) (ε / 2) (half_pos hε)
  let A := (restrict (n := n)).comp latticeLinearInclusion
  have hu' : ‖A (u : complexLatticeLinearFunctions n) -
      (ℜ g : C(complexEllInfinityUnitSphere n, ℂ))‖ < ε / 2 := by
    rw [show A (u : complexLatticeLinearFunctions n) =
      restrict (latticeLinearInclusion (u : complexLatticeLinearFunctions n)) from rfl,
      norm_selfAdjointRestriction_sub]
    rw [dist_comm, dist_eq_norm] at hu
    exact hu
  have hv' : ‖A (v : complexLatticeLinearFunctions n) -
      (ℑ g : C(complexEllInfinityUnitSphere n, ℂ))‖ < ε / 2 := by
    rw [show A (v : complexLatticeLinearFunctions n) =
      restrict (latticeLinearInclusion (v : complexLatticeLinearFunctions n)) from rfl,
      norm_selfAdjointRestriction_sub]
    rw [dist_comm, dist_eq_norm] at hv
    exact hv
  refine ⟨(u : complexLatticeLinearFunctions n) + Complex.I •
    (v : complexLatticeLinearFunctions n), ?_⟩
  change dist g (A ((u : complexLatticeLinearFunctions n) +
    Complex.I • (v : complexLatticeLinearFunctions n))) < ε
  rw [dist_comm, dist_eq_norm, map_add, map_smul]
  have heq : A (u : complexLatticeLinearFunctions n) +
      Complex.I • A (v : complexLatticeLinearFunctions n) - g =
        (A (u : complexLatticeLinearFunctions n) -
          (ℜ g : C(complexEllInfinityUnitSphere n, ℂ))) +
        Complex.I • (A (v : complexLatticeLinearFunctions n) -
          (ℑ g : C(complexEllInfinityUnitSphere n, ℂ))) := by
    conv_lhs => rw [← realPart_add_I_smul_imaginaryPart g]
    module
  rw [heq]
  calc
    _ ≤ ‖A (u : complexLatticeLinearFunctions n) -
        (ℜ g : C(complexEllInfinityUnitSphere n, ℂ))‖ +
        ‖Complex.I • (A (v : complexLatticeLinearFunctions n) -
          (ℑ g : C(complexEllInfinityUnitSphere n, ℂ)))‖ := norm_add_le _ _
    _ = ‖A (u : complexLatticeLinearFunctions n) -
        (ℜ g : C(complexEllInfinityUnitSphere n, ℂ))‖ +
        ‖A (v : complexLatticeLinearFunctions n) -
          (ℑ g : C(complexEllInfinityUnitSphere n, ℂ))‖ := by
      rw [norm_smul, Complex.norm_I, one_mul]
    _ < ε / 2 + ε / 2 := add_lt_add hu' hv'
    _ = ε := add_halves ε

/-- Restrictions of complex lattice-linear functions to the unit sphere of `(ℂⁿ, ‖·‖_∞)` are dense
in the continuous complex-valued functions on that sphere. -/
theorem denseRange_restrict_latticeLinearInclusion :
    DenseRange (fun f : complexLatticeLinearFunctions n ↦
      restrict (latticeLinearInclusion f)) := by
  exact Metric.denseRange_iff.mpr exists_latticeLinearRestriction_close

end ComplexPosHomFunction

/-! ### Positively homogeneous functional calculus -/

namespace ComplexPosHomFunction

variable {n : ℕ}

/-- Restriction identifies self-adjoint positively homogeneous functions with real-valued
continuous functions on the unit sphere as real vector lattices. -/
private noncomputable def selfAdjointSphereRealEquiv :
    VecLatEquiv (selfAdjoint (complexPosHomFunctions n))
      C(complexEllInfinityUnitSphere n, ℝ) :=
  (selfAdjointSphereEquiv (n := n)).trans
    ContinuousMap.selfAdjointBanachLatEquiv.toVecLatEquiv

/-- The real-valued restriction of a modulus is the pointwise norm of the original function. -/
private theorem selfAdjointSphereRealEquiv_modulus_apply
    (f : complexPosHomFunctions n) (x : complexEllInfinityUnitSphere n) :
    selfAdjointSphereRealEquiv (ComplexVectorLattice.modulus f) x =
      ‖f (x : Fin n → ℂ)‖ := by
  change ((restrict ((ComplexVectorLattice.modulus f : selfAdjoint _) :
    complexPosHomFunctions n)) x).re = _
  rw [ComplexVecLatHom.map_modulus, ContinuousMap.modulus_apply, Complex.ofReal_re,
    restrict_apply]

/-- The modulus of the radial extension of the constant-one function restricts to one on the
unit sphere. -/
private theorem selfAdjointSphereRealEquiv_unit_apply
    (x : complexEllInfinityUnitSphere n) :
    selfAdjointSphereRealEquiv
      (ComplexVectorLattice.modulus (extend (1 : C(complexEllInfinityUnitSphere n, ℂ)))) x =
        1 := by
  rw [selfAdjointSphereRealEquiv_modulus_apply]
  have h : extend (1 : C(complexEllInfinityUnitSphere n, ℂ)) (x : Fin n → ℂ) = 1 := by
    simpa only [restrict_apply, ContinuousMap.one_apply] using
      congrArg (fun g : C(complexEllInfinityUnitSphere n, ℂ) ↦ g x) (restrict_extend 1)
  rw [h, norm_one]

/-- The modulus of a positively homogeneous function is bounded by its norm times the modulus of
the radial extension of the constant-one function. -/
private theorem modulus_le_norm_smul_unit (f : complexPosHomFunctions n) :
    ComplexVectorLattice.modulus f ≤ ‖f‖ •
      ComplexVectorLattice.modulus (extend (1 : C(complexEllInfinityUnitSphere n, ℂ))) := by
  let e := selfAdjointSphereRealEquiv (n := n)
  apply e.toOrderIso.le_iff_le.mp
  change e.toVecLatHom (ComplexVectorLattice.modulus f) ≤ e.toVecLatHom
    (‖f‖ • ComplexVectorLattice.modulus (extend (1 : C(complexEllInfinityUnitSphere n, ℂ))))
  rw [map_smul, ContinuousMap.le_def]
  intro x
  rw [ContinuousMap.smul_apply]
  change selfAdjointSphereRealEquiv (ComplexVectorLattice.modulus f) x ≤
    ‖f‖ • selfAdjointSphereRealEquiv
      (ComplexVectorLattice.modulus (extend (1 : C(complexEllInfinityUnitSphere n, ℂ)))) x
  rw [selfAdjointSphereRealEquiv_modulus_apply, selfAdjointSphereRealEquiv_unit_apply,
    smul_eq_mul, mul_one]
  simpa only [restrict_apply, norm_restrict] using
    ContinuousMap.norm_coe_le_norm (restrict f) x

/-- Pointwise substitution of a continuous tuple into positively homogeneous functions. -/
private noncomputable def continuousMapPullback
    {K : Type*} [TopologicalSpace K] (z : Fin n → C(K, ℂ)) :
    ComplexVecLatHom (complexPosHomFunctions n) C(K, ℂ) := by
  let q : C(K, Fin n → ℂ) := ⟨fun t i ↦ z i t, continuous_pi fun i ↦ (z i).continuous⟩
  refine
    { toLinearMap := (ContinuousMap.compRightAlgHom ℂ ℂ q).toLinearMap.comp
        (complexPosHomFunctions n).toSubmodule.subtype
      map_modulus' := ?_ }
  intro f
  apply ContinuousMap.ext
  intro t
  change (((ComplexVectorLattice.modulus f : selfAdjoint _) :
    complexPosHomFunctions n) : C(Fin n → ℂ, ℂ)) (q t) =
      ((ComplexVectorLattice.modulus (f.val.comp q) : selfAdjoint C(K, ℂ)) : C(K, ℂ)) t
  rw [(complexPosHomFunctions n).coe_modulus, ContinuousMap.modulus_apply,
    ContinuousMap.modulus_apply, ContinuousMap.comp_apply]

/-- Pointwise substitution sends each coordinate projection to the corresponding tuple entry. -/
private theorem continuousMapPullback_coordinate
    {K : Type*} [TopologicalSpace K] (z : Fin n → C(K, ℂ)) (i : Fin n) :
    continuousMapPullback z (coordinate i) = z i := by
  exact ContinuousMap.ext fun _ ↦ rfl

variable {Z : Type*} [AddCommGroup Z] [Module ℂ Z]
  [StarAddMonoid Z] [StarModule ℂ Z]
  [Lattice (selfAdjoint Z)] [IsOrderedAddMonoid (selfAdjoint Z)]
  [ComplexVectorLattice Z]

/-- The real scalar action supplied by the vector lattice structure. -/
local instance instSMulSelfAdjoint : SMul ℝ (selfAdjoint Z) :=
  VectorLattice.toModule.toSMul

/-- Distributivity of the real scalar action supplied by the vector lattice structure. -/
local instance instDistribSMulSelfAdjoint : DistribSMul ℝ (selfAdjoint Z) :=
  VectorLattice.toModule.toDistribSMul

/-- The real multiplicative action supplied by the vector lattice structure. -/
local instance instMulActionSelfAdjoint : MulAction ℝ (selfAdjoint Z) :=
  VectorLattice.toModule.toMulAction

/-- The modulus of the image of a positively homogeneous function is bounded by its norm times
the image of the modulus of the radial extension of the constant-one function. -/
private theorem modulus_map_le_norm_smul_unit
    (V : ComplexVecLatHom (complexPosHomFunctions n) Z) (f : complexPosHomFunctions n) :
    ComplexVectorLattice.modulus (V f) ≤ ‖f‖ • V.toSelfAdjointVecLatHom
      (ComplexVectorLattice.modulus (extend (1 : C(complexEllInfinityUnitSphere n, ℂ)))) := by
  let T := V.toSelfAdjointVecLatHom
  have h : ComplexVectorLattice.modulus (V f) = T (ComplexVectorLattice.modulus f) := by
    apply Subtype.ext
    exact (V.map_modulus f).symm
  rw [h]
  exact (T.monotone (modulus_le_norm_smul_unit f)).trans_eq (map_smul T _ _)

/-- The zero complex lattice homomorphism. -/
private noncomputable def zeroComplexVecLatHom :
    ComplexVecLatHom (complexPosHomFunctions n) Z := by
  refine { toLinearMap := 0, map_modulus' := ?_ }
  simp

/-- The modulus of the difference of two homomorphism values is bounded by the function norm
times the sum of the images of the modulus of the radial extension of one. -/
private theorem modulus_sub_map_le_norm_smul_unit
    (V W : ComplexVecLatHom (complexPosHomFunctions n) Z) (f : complexPosHomFunctions n) :
    ComplexVectorLattice.modulus (V f - W f) ≤ ‖f‖ •
      (V.toSelfAdjointVecLatHom
        (ComplexVectorLattice.modulus (extend (1 : C(complexEllInfinityUnitSphere n, ℂ)))) +
       W.toSelfAdjointVecLatHom
        (ComplexVectorLattice.modulus (extend (1 : C(complexEllInfinityUnitSphere n, ℂ))))) := by
  calc
    _ ≤ ComplexVectorLattice.modulus (V f) + ComplexVectorLattice.modulus (W f) := by
      simpa only [sub_eq_add_neg, ComplexVectorLattice.modulus_neg] using
        ComplexVectorLattice.modulus_add_le (V f) (-(W f))
    _ ≤ ‖f‖ • V.toSelfAdjointVecLatHom
        (ComplexVectorLattice.modulus (extend (1 : C(complexEllInfinityUnitSphere n, ℂ)))) +
        ‖f‖ • W.toSelfAdjointVecLatHom
        (ComplexVectorLattice.modulus (extend (1 : C(complexEllInfinityUnitSphere n, ℂ)))) :=
      add_le_add (modulus_map_le_norm_smul_unit V f) (modulus_map_le_norm_smul_unit W f)
    _ = _ := (smul_add _ _ _).symm

/-- The homomorphism induced on the self-adjoint parts preserves the lattice-valued modulus. -/
private theorem toSelfAdjointVecLatHom_modulus
    (V : ComplexVecLatHom (complexPosHomFunctions n) Z) (f : complexPosHomFunctions n) :
    V.toSelfAdjointVecLatHom (ComplexVectorLattice.modulus f) =
      ComplexVectorLattice.modulus (V f) := by
  apply Subtype.ext
  exact V.map_modulus f

variable [IsUniformlyCompleteComplexVectorLattice Z]

/-- Construct the calculus through the complex representation of a nonzero principal ideal,
together with its coordinate identities. -/
private noncomputable def functionalCalculusOfPosData
    (z : Fin n → Z) (h : 0 < ∑ i, ComplexVectorLattice.modulus (z i)) :
    { T : ComplexVecLatHom (complexPosHomFunctions n) Z //
      ∀ i, T (coordinate i) = z i } := by
  let e := ∑ i, ComplexVectorLattice.modulus (z i)
  letI := OrderIdeal.principalNormedAddCommGroup e
  letI : Lattice ↥(OrderIdeal.principal e) := OrderIdeal.instLatticePrincipal e
  letI : IsOrderedAddMonoid ↥(OrderIdeal.principal e) :=
    OrderIdeal.instIsOrderedAddMonoidPrincipal e
  letI : AMSpaceWithUnit ↥(OrderIdeal.principal e) :=
    OrderIdeal.principalAMSpaceWithUnit h.le
      (IsUniformlyCompleteVectorLattice.complete_principal e h)
  letI : IsUniformlyCompleteComplexVectorLattice
      (Complexification ↥(OrderIdeal.principal e)) :=
    isUniformlyCompleteComplexVectorLattice_of_complexBanachLattice _
  let u : Fin n → Complexification ↥(OrderIdeal.principal e) := fun i ↦
    ⟨⟨ℜ (z i), (ComplexLatticeLinearFunction.parts_mem_principal_sum_modulus z i).1⟩,
      ⟨ℑ (z i), (ComplexLatticeLinearFunction.parts_mem_principal_sum_modulus z i).2⟩⟩
  let j := ComplexVecLatHom.ofSelfAdjointVecLatHom
    ((OrderIdeal.principal e).subtype.comp
      Complexification.selfAdjointBanachLatEquiv.toVecLatEquiv.toVecLatHom)
  let k := OrderIdeal.complexPrincipalKakutaniEquiv h
  refine ⟨j.comp (k.symm.toComplexVecLatHom.comp
    (continuousMapPullback (fun i ↦ k (u i)))), ?_⟩
  intro i
  simp only [ComplexVecLatHom.comp_apply, continuousMapPullback_coordinate,
    ComplexBanachLatEquiv.toComplexVecLatHom_apply, ComplexBanachLatEquiv.symm_apply_apply]
  change ((Complexification.selfAdjointEquiv (ℜ (u i))).val : Z) +
    Complex.I • ((Complexification.selfAdjointEquiv (ℑ (u i))).val : Z) = z i
  rw [Complexification.selfAdjointEquiv_realPart,
    Complexification.selfAdjointEquiv_imaginaryPart]
  exact realPart_add_I_smul_imaginaryPart (z i)

/-- Combine the zero and positive-principal-ideal constructions. -/
private noncomputable def functionalCalculusData (z : Fin n → Z) :
    { T : ComplexVecLatHom (complexPosHomFunctions n) Z //
      ∀ i, T (coordinate i) = z i } := by
  classical
  by_cases h : ∑ i, ComplexVectorLattice.modulus (z i) = 0
  · refine ⟨zeroComplexVecLatHom, ?_⟩
    intro i
    change 0 = z i
    exact (ComplexVectorLattice.modulus_eq_zero_iff (z i)).mp
      ((Finset.sum_eq_zero_iff_of_nonneg
        (fun j _ ↦ ComplexVectorLattice.modulus_nonneg (z j))).mp h i
          (Finset.mem_univ i)) |>.symm
  · exact functionalCalculusOfPosData z
      (lt_of_le_of_ne
        (Finset.sum_nonneg fun i _ ↦ ComplexVectorLattice.modulus_nonneg (z i))
        (Ne.symm h))

/-- The **positively homogeneous functional calculus** associated to a tuple `z₁,...,zₙ ∈ Z`
in a complex vector lattice with uniformly complete self-adjoint part. -/
noncomputable def functionalCalculus (z : Fin n → Z) :
    ComplexVecLatHom (complexPosHomFunctions n) Z :=
  (functionalCalculusData z).val

/-- The positively homogeneous functional calculus sends the `i`-th coordinate
function to `z i`. -/
@[simp]
theorem functionalCalculus_coordinate (z : Fin n → Z) (i : Fin n) :
    functionalCalculus z (coordinate i) = z i := by
  exact (functionalCalculusData z).property i

/-- On lattice-linear functions, the positively homogeneous calculus agrees with
the lattice-linear functional calculus. -/
@[simp]
theorem functionalCalculus_latticeLinear (z : Fin n → Z)
    (f : complexLatticeLinearFunctions n) :
    functionalCalculus z (latticeLinearInclusion f) =
      ComplexLatticeLinearFunction.functionalCalculus z f := by
  have h := ComplexLatticeLinearFunction.eq_functionalCalculus_of_map_coordinate z
    ((functionalCalculus z).comp latticeLinearInclusion) (fun i ↦
      functionalCalculus_coordinate z i)
  exact DFunLike.congr_fun h f

/-- Two complex lattice homomorphisms on positively homogeneous functions are equal if they
agree on lattice-linear functions. -/
private theorem eq_of_eq_latticeLinear
    (V W : ComplexVecLatHom (complexPosHomFunctions n) Z)
    (hVW : ∀ g : complexLatticeLinearFunctions n,
      V (latticeLinearInclusion g) = W (latticeLinearInclusion g)) : V = W := by
  apply ComplexVecLatHom.ext
  intro f
  let u := ComplexVectorLattice.modulus
    (extend (1 : C(complexEllInfinityUnitSphere n, ℂ)))
  let e := V.toSelfAdjointVecLatHom u + W.toSelfAdjointVecLatHom u
  have he : 0 ≤ e := add_nonneg
    ((ComplexVectorLattice.modulus_nonneg (V (extend 1))).trans_eq
      (toSelfAdjointVecLatHom_modulus V (extend 1)).symm)
    ((ComplexVectorLattice.modulus_nonneg (W (extend 1))).trans_eq
      (toSelfAdjointVecLatHom_modulus W (extend 1)).symm)
  have hzero : ComplexVectorLattice.modulus (V f - W f) = 0 :=
    IsVLArchimedean.eq_zero_of_nonneg_of_forall_nsmul_le
      (ComplexVectorLattice.modulus_nonneg _) fun k ↦ by
      rcases k with _ | k
      · simpa only [zero_nsmul] using he
      · have hk : (0 : ℝ) < ((k + 1 : ℕ) : ℝ)⁻¹ := by positivity
        obtain ⟨g, hg⟩ := Metric.denseRange_iff.mp
          denseRange_restrict_latticeLinearInclusion (restrict f) _ hk
        let d := f - latticeLinearInclusion g
        have hdnorm : ‖d‖ < ((k + 1 : ℕ) : ℝ)⁻¹ := by
          change ‖restrict (f - latticeLinearInclusion g)‖ < _
          rw [map_sub]
          rw [dist_eq_norm] at hg
          exact hg
        have hdiff : V f - W f = V d - W d := by
          simp only [d, map_sub]
          rw [hVW g]
          abel
        have hde : ComplexVectorLattice.modulus (V f - W f) ≤
            ((k + 1 : ℕ) : ℝ)⁻¹ • e := by
          rw [hdiff]
          exact (modulus_sub_map_le_norm_smul_unit V W d).trans
            (smul_le_smul_of_nonneg_right hdnorm.le he)
        calc
          (k + 1) • ComplexVectorLattice.modulus (V f - W f) ≤
              (k + 1) • (((k + 1 : ℕ) : ℝ)⁻¹ • e) :=
            nsmul_le_nsmul_right hde (k + 1)
          _ = e := by
            rw [← Nat.cast_smul_eq_nsmul ℝ, smul_smul,
              mul_inv_cancel₀ (Nat.cast_ne_zero.mpr (Nat.succ_ne_zero k)), one_smul]
  exact sub_eq_zero.mp ((ComplexVectorLattice.modulus_eq_zero_iff _).mp hzero)

/-- The **positively homogeneous functional calculus** associated to `z₁,...,zₙ ∈ Z` is the
**unique** complex vector lattice homomorphism from `complexPosHomFunctions n` to `Z`
such that `coordinate i ↦ z i`. -/
theorem eq_functionalCalculus_of_map_coordinate (z : Fin n → Z)
    (V : ComplexVecLatHom (complexPosHomFunctions n) Z)
    (hV : ∀ i, V (coordinate i) = z i) : V = functionalCalculus z := by
  have h := ComplexLatticeLinearFunction.eq_functionalCalculus_of_map_coordinate z
    (V.comp latticeLinearInclusion) (fun i ↦ hV i)
  apply eq_of_eq_latticeLinear
  intro g
  exact (DFunLike.congr_fun h g).trans (functionalCalculus_latticeLinear z g).symm

/-- The positively homogeneous functional calculus at the zero tuple is zero. -/
@[simp]
theorem functionalCalculus_zero (f : complexPosHomFunctions n) :
    functionalCalculus (fun _ : Fin n ↦ (0 : Z)) f = 0 := by
  have h := eq_functionalCalculus_of_map_coordinate (fun _ : Fin n ↦ (0 : Z))
    (zeroComplexVecLatHom (n := n) (Z := Z)) (fun _ ↦ rfl)
  exact (DFunLike.congr_fun h f).symm

/-- The positively homogeneous functional calculus on continuous complex-valued functions
is computed pointwise. -/
theorem functionalCalculus_continuousMap_apply
    {K : Type*} [TopologicalSpace K] [IsUniformlyCompleteComplexVectorLattice C(K, ℂ)]
    (z : Fin n → C(K, ℂ)) (f : complexPosHomFunctions n) (t : K) :
    functionalCalculus z f t = f (fun i ↦ z i t) := by
  have h := eq_functionalCalculus_of_map_coordinate z (continuousMapPullback z)
    (continuousMapPullback_coordinate z)
  rw [← h]
  rfl

variable {W : Type*} [AddCommGroup W] [Module ℂ W]
  [StarAddMonoid W] [StarModule ℂ W]
  [Lattice (selfAdjoint W)] [IsOrderedAddMonoid (selfAdjoint W)]
  [ComplexVectorLattice W] [IsUniformlyCompleteComplexVectorLattice W]

/-- Positively homogeneous functional calculus is preserved by complex vector lattice homomorphisms:
`T (functionalCalculus z f) = functionalCalculus (Tz) f`. -/
theorem functionalCalculus_map (T : ComplexVecLatHom Z W) (z : Fin n → Z)
    (f : complexPosHomFunctions n) :
    T (functionalCalculus z f) = functionalCalculus (fun i ↦ T (z i)) f := by
  have h := eq_functionalCalculus_of_map_coordinate (fun i ↦ T (z i))
    (T.comp (functionalCalculus z)) (by
      intro i
      simp only [ComplexVecLatHom.comp_apply, functionalCalculus_coordinate])
  exact DFunLike.congr_fun h f

end ComplexPosHomFunction

/-! ### Composition and substitution in positively homogeneous functional calculus -/

namespace ComplexPosHomFunction

variable {m n : ℕ}

/-- Compose a positively homogeneous function with a tuple of positively homogeneous functions. -/
noncomputable def comp (f : complexPosHomFunctions m)
    (g : Fin m → complexPosHomFunctions n) : complexPosHomFunctions n := by
  refine ⟨continuousMapPullback (fun i ↦ (g i).val) f, ?_⟩
  intro c hc z
  change f (fun i ↦ g i (c • z)) = c • f (fun i ↦ g i z)
  have hg : (fun i ↦ g i (c • z)) = c • (fun i ↦ g i z) :=
    funext fun i ↦ map_smul_of_nonneg (g i) c hc z
  rw [hg, map_smul_of_nonneg f c hc]

/-- Pointwise evaluation of a composition of positively homogeneous functions. -/
@[simp]
theorem comp_apply (f : complexPosHomFunctions m)
    (g : Fin m → complexPosHomFunctions n) (z : Fin n → ℂ) :
    comp f g z = f (fun i ↦ g i z) := by
  rfl

/-- Composition with a tuple of positively homogeneous functions defines a complex vector
lattice homomorphism. -/
private noncomputable def compositionHom (g : Fin m → complexPosHomFunctions n) :
    ComplexVecLatHom (complexPosHomFunctions m) (complexPosHomFunctions n) := by
  let P := continuousMapPullback (fun i ↦ (g i).val)
  refine
    { toLinearMap := P.toLinearMap.codRestrict (complexPosHomFunctions n).toSubmodule
        (fun f ↦ (comp f g).property)
      map_modulus' := ?_ }
  intro f
  apply Subtype.ext
  change P ((ComplexVectorLattice.modulus f : selfAdjoint _) : complexPosHomFunctions m) =
    (((ComplexVectorLattice.modulus (comp f g) : selfAdjoint _) :
      complexPosHomFunctions n) : C(Fin n → ℂ, ℂ))
  rw [(complexPosHomFunctions n).coe_modulus]
  exact P.map_modulus f

variable {Z : Type*} [AddCommGroup Z] [Module ℂ Z]
  [StarAddMonoid Z] [StarModule ℂ Z]
  [Lattice (selfAdjoint Z)] [IsOrderedAddMonoid (selfAdjoint Z)]
  [ComplexVectorLattice Z] [IsUniformlyCompleteComplexVectorLattice Z]

/-- Substitution of positively homogeneous functions commutes with their functional calculus. -/
@[simp]
theorem functionalCalculus_comp (z : Fin n → Z)
    (g : Fin m → complexPosHomFunctions n) (f : complexPosHomFunctions m) :
    functionalCalculus (fun i ↦ functionalCalculus z (g i)) f =
      functionalCalculus z (comp f g) := by
  letI : IsUniformlyCompleteComplexVectorLattice (complexPosHomFunctions n) :=
    isUniformlyCompleteComplexVectorLattice_of_complexBanachLattice _
  let V := compositionHom g
  have hV : ∀ i, V (coordinate i) = g i := by
    intro i
    apply ext
    intro x
    change comp (coordinate i) g x = g i x
    rw [comp_apply, coordinate_apply]
  have hcalc : functionalCalculus g = V :=
    (eq_functionalCalculus_of_map_coordinate g V hV).symm
  rw [← functionalCalculus_map (functionalCalculus z) g f, hcalc]
  rfl

end ComplexPosHomFunction
