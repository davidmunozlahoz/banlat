import Mathlib.Topology.Algebra.UniformFilterBasis
import BanLat.QuasiNormed.Basic

/-!
# Topology of quasi-normed spaces

This file constructs the **topology** associated to every quasi-seminorm in terms of
the open balls that it determines. It also characterizes convergence, Cauchy filter
property and proves that the topology generated by a quasi-norm is Hausdorff.

It also derives the continuity of scalar multiplication for homogeneous quasi-seminorms
and introduces the topological closure of a submodule of a quasi-normed space.
For normed spaces, this closure is shown to agree with the usual norm-closure.
-/

open Filter Set

open scoped Pointwise Topology

/-!
## Open balls form an additive-group filter basis
-/

namespace IsQuasiSeminorm

variable {E : Type*} [AddCommGroup E] [Norm E]

/-- The open ball of radius `r` centered at `x` associated to a norm `‖·‖`. -/
def ball (x : E) (r : ℝ) : Set E :=
  {y | ‖y - x‖ < r}

/-- Membership in an open ball associated with `‖·‖`. -/
@[simp]
theorem mem_ball {x y : E} {r : ℝ} : y ∈ ball x r ↔ ‖y - x‖ < r :=
  Iff.rfl

/-- The open balls centered at zero of strictly positive radius. -/
def basisSets (E : Type*) [AddCommGroup E] [Norm E] : Set (Set E) :=
  {U | ∃ r : ℝ, 0 < r ∧ U = ball 0 r}

/-- The collection of open balls of strictly positive radius associated with `‖·‖` is nonempty. -/
theorem basisSets_nonempty : (basisSets E).Nonempty := by
  exact ⟨ball 0 1, 1, zero_lt_one, rfl⟩

/-- The intersection of any two open balls of strictly positive radius contains an open ball of
strictly positive radius. -/
theorem basisSets_inter (U V : Set E) (hU : U ∈ basisSets E) (hV : V ∈ basisSets E) :
    ∃ W ∈ basisSets E, W ⊆ U ∩ V := by
  obtain ⟨r, hr, rfl⟩ := hU
  obtain ⟨s, hs, rfl⟩ := hV
  refine ⟨ball 0 (min r s), ⟨min r s, lt_min hr hs, rfl⟩, ?_⟩
  intro x hx
  exact ⟨hx.trans_le (min_le_left r s), hx.trans_le (min_le_right r s)⟩

variable [IsQuasiSeminorm E]

/-- Every quasi-seminorm open ball of strictly positive radius contains zero. -/
theorem basisSets_zero (U : Set E) (hU : U ∈ basisSets E) : (0 : E) ∈ U := by
  obtain ⟨r, hr, rfl⟩ := hU
  simpa [ball] using hr

/-- Every quasi-seminorm open ball of strictly positive radius contains
the sum of two sufficiently small open balls. -/
theorem basisSets_add (U : Set E) (hU : U ∈ basisSets E) :
    ∃ V ∈ basisSets E, V + V ⊆ U := by
  obtain ⟨r, hr, rfl⟩ := hU
  obtain ⟨K, hK⟩ := exists_quasi_triangle_constant (E := E)
  let q := r / (2 * K)
  have hq : 0 < q := div_pos hr (mul_pos zero_lt_two hK.pos)
  refine ⟨ball 0 q, ⟨q, hq, rfl⟩, ?_⟩
  rintro z ⟨x, hx, y, hy, rfl⟩
  simp only [ball, mem_setOf_eq, sub_zero] at hx hy ⊢
  have hlt : K * (‖x‖ + ‖y‖) < K * (q + q) :=
    mul_lt_mul_of_pos_left (add_lt_add hx hy) hK.pos
  have hqeq : K * (q + q) = r := by
    dsimp [q]
    field_simp [ne_of_gt hK.pos]
    norm_num
  exact (hK.norm_add_le x y).trans_lt (hlt.trans_eq hqeq)

/-- Every quasi-seminorm open ball is invariant under negation. -/
theorem basisSets_neg (U : Set E) (hU : U ∈ basisSets E) :
    ∃ V ∈ basisSets E, V ⊆ (fun x : E ↦ -x) ⁻¹' U := by
  obtain ⟨r, hr, rfl⟩ := hU
  refine ⟨ball 0 r, ⟨r, hr, rfl⟩, ?_⟩
  intro x hx
  simpa [ball] using hx

/-- The *additive-group filter basis* induced by the quasi-seminorm open balls at zero. -/
@[implicit_reducible]
noncomputable def addGroupFilterBasis (E : Type*) [AddCommGroup E] [Norm E]
    [IsQuasiSeminorm E] : AddGroupFilterBasis E :=
  addGroupFilterBasisOfComm (basisSets E) basisSets_nonempty basisSets_inter basisSets_zero
    basisSets_add basisSets_neg

/-- The topology induced by a quasi-seminorm. -/
@[implicit_reducible]
noncomputable def topology (E : Type*) [AddCommGroup E] [Norm E] [IsQuasiSeminorm E] :
    TopologicalSpace E :=
  (addGroupFilterBasis E).topology

/-- The uniform structure induced by a quasi-seminorm. -/
@[implicit_reducible]
noncomputable def uniformSpace (E : Type*) [AddCommGroup E] [Norm E] [IsQuasiSeminorm E] :
    UniformSpace E :=
  (addGroupFilterBasis E).uniformSpace

/-!
## Neighborhoods and uniformity bases
-/

omit [IsQuasiSeminorm E] in
/-- Translating an open ball associated with `‖·‖` at zero
gives the open ball centered at the translation point. -/
theorem image_add_ball_zero (x : E) (r : ℝ) :
    (fun y ↦ x + y) '' ball 0 r = ball x r := by
  ext z
  constructor
  · rintro ⟨y, hy, rfl⟩
    simpa only [ball, mem_setOf_eq, add_sub_cancel_left, sub_zero] using hy
  · intro hz
    refine ⟨z - x, ?_, by abel_nf⟩
    simpa only [ball, mem_setOf_eq, sub_zero] using hz

/-- The quasi-seminorm open balls of strictly positive radius
form a neighborhood basis at zero. -/
theorem nhds_zero_hasBasis :
    HasBasis (@nhds E (topology E) 0) (fun r : ℝ ↦ 0 < r) (ball 0) := by
  refine (addGroupFilterBasis E).nhds_zero_hasBasis.to_hasBasis ?_ ?_
  · intro U hU
    obtain ⟨r, hr, rfl⟩ := hU
    exact ⟨r, hr, Subset.rfl⟩
  · intro r hr
    exact ⟨ball 0 r, ⟨r, hr, rfl⟩, Subset.rfl⟩

/-- The quasi-seminorm open balls of strictly positive radius
form a neighborhood basis at every point. -/
theorem nhds_hasBasis (x : E) :
    HasBasis (@nhds E (topology E) x) (fun r : ℝ ↦ 0 < r) (ball x) := by
  refine (addGroupFilterBasis E).nhds_hasBasis x |>.to_hasBasis ?_ ?_
  · intro U hU
    obtain ⟨r, hr, rfl⟩ := hU
    exact ⟨r, hr, (image_add_ball_zero x r).superset⟩
  · intro r hr
    exact ⟨ball 0 r, ⟨r, hr, rfl⟩, (image_add_ball_zero x r).subset⟩

/-- The sets of pairs with arbitrarily small quasi-seminorm
difference form a basis of the induced uniformity. -/
theorem uniformity_hasBasis :
    HasBasis (@uniformity E (uniformSpace E)) (fun r : ℝ ↦ 0 < r)
      (fun r ↦ {p : E × E | ‖p.2 - p.1‖ < r}) := by
  letI : UniformSpace E := uniformSpace E
  haveI : IsUniformAddGroup E := (addGroupFilterBasis E).isUniformAddGroup
  rw [uniformity_eq_comap_nhds_zero E]
  simpa only [ball, preimage_setOf_eq, sub_zero] using
    (nhds_zero_hasBasis (E := E)).comap (fun p : E × E ↦ p.2 - p.1)

/-- The entourages with radii `1 / (n + 1)` form a countable basis of the induced uniformity. -/
theorem uniformity_hasBasis_inv_nat_succ :
    HasBasis (@uniformity E (uniformSpace E)) (fun _ : ℕ ↦ True)
      (fun n ↦ {p : E × E | ‖p.2 - p.1‖ < 1 / ((n : ℝ) + 1)}) := by
  refine uniformity_hasBasis.to_hasBasis ?_ ?_
  · intro r hr
    obtain ⟨n, hn⟩ := exists_nat_one_div_lt hr
    exact ⟨n, trivial, fun _ hp ↦ hp.trans_le hn.le⟩
  · intro n _
    exact ⟨1 / ((n : ℝ) + 1), by positivity, Set.Subset.rfl⟩

/-- The uniformity induced by a quasi-seminorm is countably generated. -/
instance instIsCountablyGeneratedUniformity :
    IsCountablyGenerated (@uniformity E (uniformSpace E)) :=
  uniformity_hasBasis_inv_nat_succ.isCountablyGenerated

/-!
## Convergence and Cauchy filters
-/

/-- Convergence in the quasi-seminorm topology is the usual convergence
in the quasi-seminorm sense. -/
theorem tendsto_nhds_iff {ι : Type*} {f : ι → E} {l : Filter ι} {x : E} :
    Tendsto f l (@nhds E (topology E) x) ↔
      ∀ ε > 0, ∀ᶠ i in l, ‖f i - x‖ < ε := by
  rw [(nhds_hasBasis x).tendsto_right_iff]
  rfl

/-- A filter is Cauchy for the induced uniformity exactly when it is
nontrivial and contains sets of arbitrarily small quasi-seminorm diameter. -/
theorem cauchy_iff {F : Filter E} :
    @Cauchy E (uniformSpace E) F ↔
      F.NeBot ∧ ∀ ε > 0, ∃ M ∈ F, ∀ x ∈ M, ∀ y ∈ M, ‖y - x‖ < ε := by
  rw [(addGroupFilterBasis E).cauchy_iff]
  apply and_congr Iff.rfl
  constructor
  · intro h ε hε
    obtain ⟨M, hM, hM_small⟩ := h (ball 0 ε) ⟨ε, hε, rfl⟩
    refine ⟨M, hM, ?_⟩
    intro x hx y hy
    simpa only [ball, mem_setOf_eq, sub_zero] using hM_small x hx y hy
  · intro h U hU
    obtain ⟨ε, hε, rfl⟩ := hU
    obtain ⟨M, hM, hM_small⟩ := h ε hε
    refine ⟨M, hM, ?_⟩
    intro x hx y hy
    simpa only [ball, mem_setOf_eq, sub_zero] using hM_small x hx y hy

/-- A sequence is Cauchy if, and only if, it verifies the usual `ε-N` definition. -/
theorem cauchySeq_iff {u : ℕ → E} :
    @CauchySeq E ℕ (uniformSpace E) _ u ↔
      ∀ ε > 0, ∃ N, ∀ m ≥ N, ∀ n ≥ N, ‖u n - u m‖ < ε := by
  letI : UniformSpace E := uniformSpace E
  simpa only [mem_setOf_eq] using
    (uniformity_hasBasis (E := E)).cauchySeq_iff (u := u)

/-!
## Compatibility with normed structures
-/

/-- On a seminormed additive group, the quasi-seminorm topology is the existing norm topology. -/
theorem topology_eq (E : Type*) [SeminormedAddCommGroup E] :
    topology E = (inferInstance : TopologicalSpace E) := by
  apply TopologicalSpace.ext_nhds
  intro x
  apply (nhds_hasBasis x).eq_of_same_basis
  refine (NormedAddGroup.nhds_basis_norm_lt x).congr (fun _ ↦ Iff.rfl) ?_
  intro r _
  ext y
  change ‖-y + x‖ < r ↔ ‖y - x‖ < r
  rw [show -y + x = x - y by abel, norm_sub_rev]

/-- On a seminormed additive group, the quasi-seminorm uniformity is the norm uniformity. -/
theorem uniformSpace_eq (E : Type*) [SeminormedAddCommGroup E] :
    uniformSpace E = (inferInstance : UniformSpace E) := by
  let u₀ : UniformSpace E := inferInstance
  let t₀ : TopologicalSpace E := u₀.toTopologicalSpace
  let B := addGroupFilterBasis E
  change @IsTopologicalAddGroup.rightUniformSpace E _ B.topology B.isTopologicalAddGroup = _
  suffices ∀ (t : TopologicalSpace E) (h : @IsTopologicalAddGroup E t _),
      t = t₀ → @IsTopologicalAddGroup.rightUniformSpace E _ t h = u₀ by
    exact this B.topology B.isTopologicalAddGroup (topology_eq E)
  intro t h ht
  subst t
  exact @IsUniformAddGroup.rightUniformSpace_eq E u₀ _ inferInstance

end IsQuasiSeminorm

/-!
## Separation and Hausdorffness
-/

namespace IsQuasiNorm

variable {E : Type*} [AddCommGroup E] [Norm E] [IsQuasiNorm E]

/-- The topology induced by a quasi-norm is Hausdorff. -/
theorem t2Space : @T2Space E (IsQuasiSeminorm.topology E) := by
  letI : TopologicalSpace E := IsQuasiSeminorm.topology E
  change T2Space E
  apply ((IsQuasiSeminorm.addGroupFilterBasis E).t2Space_iff rfl).2
  ext x
  constructor
  · intro hx
    simp only [mem_sInter] at hx
    rw [mem_singleton_iff]
    by_contra hx0
    have hpos : 0 < ‖x‖ := IsQuasiNorm.norm_pos hx0
    have hxball : x ∈ IsQuasiSeminorm.ball 0 ‖x‖ :=
      hx _ ⟨‖x‖, hpos, rfl⟩
    rw [IsQuasiSeminorm.ball, mem_setOf_eq, sub_zero] at hxball
    exact (lt_irrefl ‖x‖) hxball
  · intro hx
    rw [mem_singleton_iff] at hx
    subst x
    rw [mem_sInter]
    exact fun _ hU ↦ (IsQuasiSeminorm.addGroupFilterBasis E).zero hU

/-- The topology induced by a quasi-norm is a Hausdorff topology. -/
instance instT2Space : @T2Space E (IsQuasiSeminorm.topology E) :=
  t2Space

end IsQuasiNorm

/-!
## Continuous scalar multiplication
-/

namespace IsQuasiSeminorm

variable {𝕜 E : Type*} [SeminormedRing 𝕜] [AddCommGroup E] [Norm E] [IsQuasiSeminorm E]
  [Module 𝕜 E] [NormSMulClass 𝕜 E]

/-- Scalar multiplication is continuous for the topology induced by a homogeneous quasi-seminorm. -/
theorem continuousSMul : @ContinuousSMul 𝕜 E _ _ (topology E) := by
  letI : TopologicalSpace E := topology E
  haveI : IsTopologicalAddGroup E := (addGroupFilterBasis E).isTopologicalAddGroup
  apply ContinuousSMul.of_nhds_zero
  · rw [nhds_zero_hasBasis.tendsto_right_iff]
    intro r hr
    apply mem_of_superset
      (prod_mem_prod (Metric.ball_mem_nhds (0 : 𝕜) zero_lt_one)
        (nhds_zero_hasBasis.mem_of_mem hr))
    rintro ⟨a, x⟩ ⟨ha, hx⟩
    simp only [mem_ball, sub_zero] at hx ⊢
    change ‖a • x‖ < r
    rw [norm_smul]
    rw [Metric.mem_ball, dist_zero_right] at ha
    nlinarith [norm_nonneg a, IsQuasiSeminorm.norm_nonneg x]
  · intro x
    rw [nhds_zero_hasBasis.tendsto_right_iff]
    intro r hr
    let q := r / (‖x‖ + 1)
    have hxnonneg : 0 ≤ ‖x‖ := IsQuasiSeminorm.norm_nonneg x
    have hq : 0 < q := div_pos hr (by positivity)
    filter_upwards [Metric.ball_mem_nhds (0 : 𝕜) hq] with a ha
    simp only [mem_ball, sub_zero, norm_smul]
    rw [Metric.mem_ball, dist_zero_right] at ha
    have hqeq : (‖x‖ + 1) * q = r := by
      dsimp [q]
      field_simp
    nlinarith [norm_nonneg a]
  · intro a
    rw [nhds_zero_hasBasis.tendsto_right_iff]
    intro r hr
    let q := r / (‖a‖ + 1)
    have hq : 0 < q := div_pos hr (by positivity)
    filter_upwards [nhds_zero_hasBasis.mem_of_mem hq] with x hx
    simp only [mem_ball, sub_zero] at hx ⊢
    rw [norm_smul]
    have hqeq : (‖a‖ + 1) * q = r := by
      dsimp [q]
      field_simp
    nlinarith [norm_nonneg a, IsQuasiSeminorm.norm_nonneg x]

/-- The topology induced by a homogeneous quasi-seminorm makes scalar multiplication
continuous. -/
instance instContinuousSMul :
    @ContinuousSMul 𝕜 E _ _ (topology E) :=
  continuousSMul

end IsQuasiSeminorm

/-!
## Closures of submodules
-/

namespace Submodule

variable {𝕜 E : Type*} [NormedField 𝕜] [AddCommGroup E] [Norm E]
  [IsQuasiSeminorm E] [QuasiNormedSpace 𝕜 E]

/-- The closure of a submodule in the topology induced by the ambient quasi-seminorm. -/
noncomputable def quasiTopologicalClosure (S : Submodule 𝕜 E) : Submodule 𝕜 E := by
  letI : TopologicalSpace E := IsQuasiSeminorm.topology E
  letI : IsTopologicalAddGroup E :=
    (IsQuasiSeminorm.addGroupFilterBasis E).isTopologicalAddGroup
  exact S.topologicalClosure

/-- The quasi-topological closure of a submodule has the expected underlying set. -/
@[simp, norm_cast]
theorem quasiTopologicalClosure_coe (S : Submodule 𝕜 E) :
    (S.quasiTopologicalClosure : Set E) =
      @closure E (IsQuasiSeminorm.topology E) (S : Set E) := by
  rfl

/-- A submodule is contained in its closure for the quasi-seminorm topology. -/
theorem le_quasiTopologicalClosure (S : Submodule 𝕜 E) : S ≤ S.quasiTopologicalClosure := by
  change (S : Set E) ⊆ @closure E (IsQuasiSeminorm.topology E) (S : Set E)
  exact @subset_closure E (IsQuasiSeminorm.topology E) (S : Set E)

/-- The closure of a submodule in the quasi-seminorm topology is closed in that topology. -/
theorem isClosed_quasiTopologicalClosure (S : Submodule 𝕜 E) :
    @IsClosed E (IsQuasiSeminorm.topology E) (S.quasiTopologicalClosure : Set E) := by
  rw [quasiTopologicalClosure_coe]
  exact @isClosed_closure E (IsQuasiSeminorm.topology E) (S : Set E)

/-- The quasi-topological closure is the least closed submodule containing the given submodule. -/
theorem quasiTopologicalClosure_minimal (S : Submodule 𝕜 E) {T : Submodule 𝕜 E}
    (h : S ≤ T) (hT : @IsClosed E (IsQuasiSeminorm.topology E) (T : Set E)) :
    S.quasiTopologicalClosure ≤ T := by
  change @closure E (IsQuasiSeminorm.topology E) (S : Set E) ⊆ (T : Set E)
  exact @closure_minimal E (IsQuasiSeminorm.topology E) (S : Set E) (T : Set E) h hT

/-- Taking the quasi-topological closure is a monotone operation. -/
@[gcongr]
theorem quasiTopologicalClosure_mono {S T : Submodule 𝕜 E} (h : S ≤ T) :
    S.quasiTopologicalClosure ≤ T.quasiTopologicalClosure :=
  S.quasiTopologicalClosure_minimal (h.trans T.le_quasiTopologicalClosure)
    T.isClosed_quasiTopologicalClosure

end Submodule

namespace Submodule

variable {𝕜 E : Type*} [NormedField 𝕜] [SeminormedAddCommGroup E] [NormedSpace 𝕜 E]

/-- In a normed space, quasi-topological closure agrees with the usual
topological (norm-)closure. -/
theorem quasiTopologicalClosure_eq_topologicalClosure (S : Submodule 𝕜 E) :
    S.quasiTopologicalClosure = S.topologicalClosure := by
  ext x
  change x ∈ @closure E (IsQuasiSeminorm.topology E) (S : Set E) ↔
    x ∈ closure (S : Set E)
  rw [IsQuasiSeminorm.topology_eq E]

end Submodule
