import BanLat.Free.FBL
import BanLat.Pushout.Basic

/-!
# Construction of push-outs of Banach lattices

The push-out is the quotient of the free Banach lattice on `X₁ ⊕₁ X₂` by the closed
order ideal imposing the lattice relations on each summand and identifying the two
images of `X₀`. The free extension of a compatible pair of maps then factors through the
quotient, giving the universal property with bounded operator norm.
-/

noncomputable section

universe u₀ u₁ u₂ v

namespace BanachLattice

variable {X₀ : Type u₀} {X₁ : Type u₁} {X₂ : Type u₂}
  [NormedAddCommGroup X₀] [Lattice X₀] [IsOrderedAddMonoid X₀] [BanachLattice X₀]
  [NormedAddCommGroup X₁] [Lattice X₁] [IsOrderedAddMonoid X₁] [BanachLattice X₁]
  [NormedAddCommGroup X₂] [Lattice X₂] [IsOrderedAddMonoid X₂] [BanachLattice X₂]

namespace Pushout

private def sumInl : X₁ →L[ℝ] WithLp 1 (X₁ × X₂) :=
  (WithLp.prodContinuousLinearEquiv 1 ℝ X₁ X₂).symm.toContinuousLinearMap.comp
    (ContinuousLinearMap.inl ℝ X₁ X₂)

private def sumInr : X₂ →L[ℝ] WithLp 1 (X₁ × X₂) :=
  (WithLp.prodContinuousLinearEquiv 1 ℝ X₁ X₂).symm.toContinuousLinearMap.comp
    (ContinuousLinearMap.inr ℝ X₁ X₂)

variable (T₁ : VecLatHom X₀ X₁) (T₂ : VecLatHom X₀ X₂)

/-- The relations imposing lattice preservation on each summand and agreement on `X₀`. -/
private def relations : Set (FBL (WithLp 1 (X₁ × X₂))) :=
  Set.range (fun x : X₁ ↦ FBL.of (sumInl |x|) - |FBL.of (sumInl x)|) ∪
  Set.range (fun y : X₂ ↦ FBL.of (sumInr |y|) - |FBL.of (sumInr y)|) ∪
  Set.range (fun z : X₀ ↦ FBL.of (sumInl (T₁ z)) - FBL.of (sumInr (T₂ z)))

/-- The closed order ideal generated by the push-out relations. -/
private def ideal : ClosedOrderIdeal (FBL (WithLp 1 (X₁ × X₂))) where
  toOrderIdeal := (OrderIdeal.generated (relations T₁ T₂)).topologicalClosure
  isClosed' := (OrderIdeal.generated (relations T₁ T₂)).toSubmodule.isClosed_topologicalClosure

end Pushout

/-- The push-out Banach lattice, constructed as a quotient of the free Banach lattice on
the `ℓ¹` sum. -/
def Pushout (T₁ : VecLatHom X₀ X₁) (T₂ : VecLatHom X₀ X₂) :=
  FBL (WithLp 1 (X₁ × X₂)) ⧸ (Pushout.ideal T₁ T₂).toOrderIdeal.toSubmodule

namespace Pushout

variable (T₁ : VecLatHom X₀ X₁) (T₂ : VecLatHom X₀ X₂)

/-- The push-out carries the quotient norm. -/
instance instNormedAddCommGroup : NormedAddCommGroup (Pushout T₁ T₂) :=
  (ideal T₁ T₂).toOrderIdeal.quotientNormedAddCommGroup (ideal T₁ T₂).isClosed

/-- The push-out carries the quotient lattice operations. -/
instance instLattice : Lattice (Pushout T₁ T₂) :=
  (ideal T₁ T₂).toOrderIdeal.instQuotientLattice

/-- Addition on the push-out respects the quotient order. -/
instance instIsOrderedAddMonoid : IsOrderedAddMonoid (Pushout T₁ T₂) :=
  (ideal T₁ T₂).toOrderIdeal.instQuotientIsOrderedAddMonoid

/-- The quotient by the closed relation ideal is a Banach lattice. -/
instance instBanachLattice : BanachLattice (Pushout T₁ T₂) :=
  (ideal T₁ T₂).toOrderIdeal.quotientBanachLattice (ideal T₁ T₂).isClosed

private lemma relations_subset_ideal :
    relations T₁ T₂ ⊆ (ideal T₁ T₂ : Set (FBL (WithLp 1 (X₁ × X₂)))) :=
  fun _ hx ↦ (OrderIdeal.generated (relations T₁ T₂)).toSubmodule.le_topologicalClosure
    (OrderIdeal.subset_generated _ hx)

private def quotientMap : VecLatHom (FBL (WithLp 1 (X₁ × X₂))) (Pushout T₁ T₂) :=
  (ideal T₁ T₂).toOrderIdeal.mkQVecLatHom

/-- The canonical lattice homomorphism from the first input to the push-out. -/
def inl : VecLatHom X₁ (Pushout T₁ T₂) :=
  VecLatHom.ofAbs
    ((quotientMap T₁ T₂).toLinearMap.comp (FBL.ofLinear.comp sumInl.toLinearMap))
    (fun x ↦ ((Submodule.Quotient.eq _).mpr
      (relations_subset_ideal T₁ T₂ (Or.inl (Or.inl ⟨x, rfl⟩)))).trans
        ((quotientMap T₁ T₂).map_abs _))

/-- The canonical lattice homomorphism from the second input to the push-out. -/
def inr : VecLatHom X₂ (Pushout T₁ T₂) :=
  VecLatHom.ofAbs
    ((quotientMap T₁ T₂).toLinearMap.comp (FBL.ofLinear.comp sumInr.toLinearMap))
    (fun x ↦ ((Submodule.Quotient.eq _).mpr
      (relations_subset_ideal T₁ T₂ (Or.inl (Or.inr ⟨x, rfl⟩)))).trans
        ((quotientMap T₁ T₂).map_abs _))

/-- The two canonical maps agree on the image of the common domain. -/
theorem commutes : (inl T₁ T₂).comp T₁ = (inr T₁ T₂).comp T₂ :=
  DFunLike.ext _ _ fun x ↦ (Submodule.Quotient.eq _).mpr
    (relations_subset_ideal T₁ T₂ (Or.inr ⟨x, rfl⟩))

/-- The first canonical map is contractive. -/
theorem norm_inl_le : ‖(inl T₁ T₂).toContinuousLinearMap‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x ↦ ?_)
  change ‖(ideal T₁ T₂).toOrderIdeal.mkQ (FBL.of (sumInl x))‖ ≤ 1 * ‖x‖
  simpa [sumInl] using
    (Submodule.Quotient.norm_mk_le
      (S := (ideal T₁ T₂).toOrderIdeal.toSubmodule)
      (FBL.of (sumInl x))).trans_eq (FBL.norm_of (sumInl x))

/-- The second canonical map is contractive. -/
theorem norm_inr_le : ‖(inr T₁ T₂).toContinuousLinearMap‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun x ↦ ?_)
  change ‖(ideal T₁ T₂).toOrderIdeal.mkQ (FBL.of (sumInr x))‖ ≤ 1 * ‖x‖
  simpa [sumInr] using
    (Submodule.Quotient.norm_mk_le
      (S := (ideal T₁ T₂).toOrderIdeal.toSubmodule)
      (FBL.of (sumInr x))).trans_eq (FBL.norm_of (sumInr x))

variable {Y : Type v} [NormedAddCommGroup Y] [Lattice Y]
  [IsOrderedAddMonoid Y] [BanachLattice Y]

private def sumMap (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y) :
    WithLp 1 (X₁ × X₂) →L[ℝ] Y :=
  (R₁.toContinuousLinearMap.coprod R₂.toContinuousLinearMap).comp
    (WithLp.prodContinuousLinearEquiv 1 ℝ X₁ X₂).toContinuousLinearMap

private lemma sumMap_inl (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y) (x : X₁) :
    sumMap R₁ R₂ (sumInl x) = R₁ x := by
  simp [sumMap, sumInl]

private lemma sumMap_inr (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y) (x : X₂) :
    sumMap R₁ R₂ (sumInr x) = R₂ x := by
  simp [sumMap, sumInr]

private lemma norm_sumMap_le (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y) :
    ‖sumMap R₁ R₂‖ ≤ max ‖R₁.toContinuousLinearMap‖ ‖R₂.toContinuousLinearMap‖ := by
  refine ContinuousLinearMap.opNorm_le_bound _
    ((norm_nonneg R₁.toContinuousLinearMap).trans (le_max_left _ _)) (fun z ↦ ?_)
  refine (norm_add_le _ _).trans
    ((add_le_add (R₁.toContinuousLinearMap.le_opNorm z.fst)
      (R₂.toContinuousLinearMap.le_opNorm z.snd)).trans ?_)
  simpa only [WithLp.prod_norm_eq_of_L1, mul_add] using
    add_le_add
      (mul_le_mul_of_nonneg_right
        (le_max_left ‖R₁.toContinuousLinearMap‖ ‖R₂.toContinuousLinearMap‖) (norm_nonneg z.fst))
      (mul_le_mul_of_nonneg_right
        (le_max_right ‖R₁.toContinuousLinearMap‖ ‖R₂.toContinuousLinearMap‖) (norm_nonneg z.snd))

private lemma relations_subset_ker_lift (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y)
    (hR : R₁.comp T₁ = R₂.comp T₂) :
    relations T₁ T₂ ⊆
      (OrderIdeal.ofKerVecLatHom (FBL.lift (sumMap R₁ R₂)) : Set _) := by
  rintro z ((⟨x, rfl⟩ | ⟨y, rfl⟩) | ⟨x, rfl⟩)
  all_goals change FBL.lift (sumMap R₁ R₂) _ = 0
  all_goals simp only [map_sub, VecLatHom.map_abs, FBL.lift_of,
    sumMap_inl, sumMap_inr, sub_self, sub_eq_zero]
  exact DFunLike.congr_fun hR x

private lemma ideal_le_ker_lift (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y)
    (hR : R₁.comp T₁ = R₂.comp T₂) :
    (ideal T₁ T₂).toOrderIdeal.toSubmodule ≤
      (FBL.lift (sumMap R₁ R₂)).toLinearMap.ker :=
  Submodule.topologicalClosure_minimal _
    (OrderIdeal.generated_le (J := OrderIdeal.ofKerVecLatHom (FBL.lift (sumMap R₁ R₂)))
      (relations_subset_ker_lift T₁ T₂ R₁ R₂ hR))
    (FBL.liftContinuousLinearMap (sumMap R₁ R₂)).isClosed_ker

/-- The unique lattice homomorphism induced by a compatible pair of maps. -/
def lift (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y)
    (hR : R₁.comp T₁ = R₂.comp T₂) : VecLatHom (Pushout T₁ T₂) Y :=
  (ideal T₁ T₂).toOrderIdeal.liftQVecLatHom (FBL.lift (sumMap R₁ R₂))
    (ideal_le_ker_lift T₁ T₂ R₁ R₂ hR)

/-- The induced map agrees with the first input map. -/
@[simp]
theorem lift_inl (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y)
    (hR : R₁.comp T₁ = R₂.comp T₂) (x : X₁) :
    lift T₁ T₂ R₁ R₂ hR (inl T₁ T₂ x) = R₁ x :=
  (FBL.lift_of (sumMap R₁ R₂) (sumInl x)).trans (sumMap_inl R₁ R₂ x)

/-- The induced map agrees with the second input map. -/
@[simp]
theorem lift_inr (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y)
    (hR : R₁.comp T₁ = R₂.comp T₂) (x : X₂) :
    lift T₁ T₂ R₁ R₂ hR (inr T₁ T₂ x) = R₂ x :=
  (FBL.lift_of (sumMap R₁ R₂) (sumInr x)).trans (sumMap_inr R₁ R₂ x)

private lemma norm_lift_le_free (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y)
    (hR : R₁.comp T₁ = R₂.comp T₂) :
    ‖(lift T₁ T₂ R₁ R₂ hR).toContinuousLinearMap‖ ≤
      ‖FBL.liftContinuousLinearMap (sumMap R₁ R₂)‖ :=
  let F := FBL.liftContinuousLinearMap (sumMap R₁ R₂)
  let f : NormedAddGroupHom (FBL (WithLp 1 (X₁ × X₂))) Y :=
    { F.toLinearMap.toAddMonoidHom with bound' := ⟨‖F‖, F.le_opNorm⟩ }
  have hf : ‖f‖ ≤ ‖F‖ := f.opNorm_le_bound (norm_nonneg _) F.le_opNorm
  ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg F) fun x ↦
    (QuotientAddGroup.norm_lift_apply_le f
      (fun _ hx ↦ ideal_le_ker_lift T₁ T₂ R₁ R₂ hR hx) x).trans
      (mul_le_mul_of_nonneg_right hf (norm_nonneg x))

/-- The induced map has operator norm at most the largest of the two input norms. -/
theorem norm_lift_le (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y)
    (hR : R₁.comp T₁ = R₂.comp T₂) :
    ‖(lift T₁ T₂ R₁ R₂ hR).toContinuousLinearMap‖ ≤
      max ‖R₁.toContinuousLinearMap‖ ‖R₂.toContinuousLinearMap‖ :=
  (norm_lift_le_free T₁ T₂ R₁ R₂ hR).trans
    ((FBL.norm_lift (sumMap R₁ R₂)).le.trans (norm_sumMap_le R₁ R₂))

private lemma sumInl_add_sumInr (z : WithLp 1 (X₁ × X₂)) :
    sumInl z.fst + sumInr z.snd = z :=
  WithLp.ofLp_injective 1
    (show (z.ofLp.1, (0 : X₂)) + (0, z.ofLp.2) = z.ofLp from by
      simp only [Prod.mk_add_mk, add_zero, zero_add])

private lemma comp_quotientMap_eq (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y)
    (R : VecLatHom (Pushout T₁ T₂) Y)
    (h₁ : R.comp (inl T₁ T₂) = R₁) (h₂ : R.comp (inr T₁ T₂) = R₂) :
    R.comp (quotientMap T₁ T₂) = FBL.lift (sumMap R₁ R₂) := by
  refine FBL.lift_unique _ _ (fun z ↦ ?_)
  let A := (R.comp (quotientMap T₁ T₂)).toLinearMap.comp FBL.ofLinear
  exact calc
    A z = A (sumInl z.fst + sumInr z.snd) := congrArg A (sumInl_add_sumInr z).symm
    _ = A (sumInl z.fst) + A (sumInr z.snd) := A.map_add _ _
    _ = R₁ z.fst + R₂ z.snd :=
      congrArg₂ (· + ·) (DFunLike.congr_fun h₁ z.fst) (DFunLike.congr_fun h₂ z.snd)

/-- A lattice homomorphism from the push-out is determined by its restrictions to both inputs. -/
theorem lift_unique (R₁ : VecLatHom X₁ Y) (R₂ : VecLatHom X₂ Y)
    (hR : R₁.comp T₁ = R₂.comp T₂) (R : VecLatHom (Pushout T₁ T₂) Y)
    (h₁ : R.comp (inl T₁ T₂) = R₁) (h₂ : R.comp (inr T₁ T₂) = R₂) :
    R = lift T₁ T₂ R₁ R₂ hR :=
  DFunLike.ext _ _ fun z ↦ Quotient.inductionOn' z fun x ↦
    DFunLike.congr_fun (comp_quotientMap_eq T₁ T₂ R₁ R₂ R h₁ h₂) x

/-- The quotient construction satisfies the norm-controlled push-out universal property. -/
theorem is_pushout :
    IsPushout.{u₀, u₁, u₂, max u₁ u₂, v} T₁ T₂ (inl T₁ T₂) (inr T₁ T₂) where
  commutes := commutes T₁ T₂
  norm_inl_le := norm_inl_le T₁ T₂
  norm_inr_le := norm_inr_le T₁ T₂
  exists_lift _ _ _ _ _ R₁ R₂ hR :=
    ⟨lift T₁ T₂ R₁ R₂ hR,
      DFunLike.ext _ _ (lift_inl T₁ T₂ R₁ R₂ hR),
      DFunLike.ext _ _ (lift_inr T₁ T₂ R₁ R₂ hR),
      norm_lift_le T₁ T₂ R₁ R₂ hR, lift_unique T₁ T₂ R₁ R₂ hR⟩

end Pushout

end BanachLattice
