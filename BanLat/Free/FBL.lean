import BanLat.Free.FBLp

/-!
# The free Banach lattice generated by a normed space

The free Banach lattice `FBL E` is `FBLp 1 E`, with its inherited norm and pointwise
lattice operations on positively homogeneous functions on `E*`. Its canonical embedding
and dense algebraic free sublattice come from the general construction. Every bounded
linear map from `E` into a Banach lattice extends uniquely to a lattice homomorphism
with the same operator norm. Restriction to the weak-star closed dual unit ball is
provided explicitly by `restrictToBall`. The identity lattice isometry with `FBLp 1 E`
is bundled as `FBLp.fblEquiv`.
-/

noncomputable section

universe u v

/-- The free Banach lattice over a real normed space, defined as the free p-convex
Banach lattice at exponent one. Its elements are functions on the entire dual. -/
abbrev FBL (E : Type u) [NormedAddCommGroup E] [NormedSpace ℝ E] : Type u :=
  FBLp 1 E

namespace FBL

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The canonical embedding of `E` into its free Banach lattice. -/
def of (x : E) : FBL E := FBLp.of 1 x

/-- A canonical generator evaluates a dual functional at its generating vector. -/
@[simp]
theorem of_apply (x : E) (φ : StrongDual ℝ E) : of x φ = φ x := rfl

/-- The canonical embedding, bundled as a real-linear map. -/
def ofLinear : E →ₗ[ℝ] FBL E := (FBLp.of 1).toLinearMap

/-- The linear map agrees with the canonical embedding on each vector. -/
@[simp]
theorem ofLinear_apply (x : E) : ofLinear x = of x := rfl

/-- The canonical embedding preserves the norm of every vector. -/
theorem norm_of (x : E) : ‖of x‖ = ‖x‖ := (FBLp.of 1).norm_map x

/-- The canonical embedding, bundled as a linear isometry. -/
def ofLinearIsometry : E →ₗᵢ[ℝ] FBL E := FBLp.of 1

/-- The linear isometry agrees with the canonical embedding on each vector. -/
@[simp]
theorem ofLinearIsometry_apply (x : E) : ofLinearIsometry x = of x := rfl

/-- Distinct vectors give distinct canonical generators. -/
theorem of_injective : Function.Injective (of : E → FBL E) := (FBLp.of 1).injective

/-- The algebraic free vector lattice embeds into `FBL E` through the general construction. -/
def ofFVLv : FVLv E →ₗ[ℝ] FBL E := (FBLp.ofFVLv 1).toLinearMap

/-- The algebraic embedding preserves the generators associated with vectors of `E`. -/
@[simp]
theorem ofFVLv_of (x : E) : ofFVLv (FVLv.of x) = of x := FBLp.ofFVLv_of 1 x

/-- The algebraic free vector lattice is norm dense in the free Banach lattice. -/
theorem denseRange_ofFVLv : DenseRange (ofFVLv (E := E)) := FBLp.denseRange_ofFVLv 1

/-- Restrict a free lattice function to the weak-star closed dual unit ball.
The restriction is continuous for the weak-star topology on that ball. -/
def restrictToBall (f : FBL E) : C(FVLv.dualUnitBall E, ℝ) :=
  ⟨fun φ ↦ f (WeakDual.toStrongDual φ.1),
    (FBLp.weakStar_continuous_bounded 1 f 1).comp_continuous
      continuous_subtype_val (fun φ ↦ mem_closedBall_zero_iff.mp φ.2)⟩

/-- The restriction evaluates the original function at the underlying dual functional. -/
@[simp]
theorem restrictToBall_apply (f : FBL E) (φ : FVLv.dualUnitBall E) :
    restrictToBall f φ = f (WeakDual.toStrongDual φ.1) := rfl

/-- Restricting a canonical generator gives its usual evaluation function on the dual ball. -/
@[simp]
theorem restrictToBall_of (x : E) : restrictToBall (of x) = FVLv.dualEval E x := rfl

variable {X : Type v} [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
  [BanachLattice X]

/-- The bounded lattice extension of an operator from `E`, obtained from the universal
property of `FBLp 1 E`. -/
def liftContinuousLinearMap (T : E →L[ℝ] X) : FBL E →L[ℝ] X :=
  (FBLp.universal_property_one T).choose

/-- The extension of an operator from `E`, bundled as a vector lattice homomorphism. -/
def lift (T : E →L[ℝ] X) : VecLatHom (FBL E) X :=
  VecLatHom.ofIsVecLatHom (liftContinuousLinearMap T)
    (FBLp.universal_property_one T).choose_spec.1

/-- The continuous linear and vector lattice bundles have the same underlying map. -/
@[simp]
theorem liftContinuousLinearMap_apply (T : E →L[ℝ] X) (f : FBL E) :
    liftContinuousLinearMap T f = lift T f := rfl

/-- The lattice extension agrees with the original operator on every generator. -/
@[simp]
theorem lift_of (T : E →L[ℝ] X) (x : E) : lift T (of x) = T x :=
  (FBLp.universal_property_one T).choose_spec.2.1 x

/-- The lattice extension has exactly the operator norm of the original map. -/
theorem norm_lift (T : E →L[ℝ] X) : ‖liftContinuousLinearMap T‖ = ‖T‖ := by
  apply le_antisymm (FBLp.universal_property_one T).choose_spec.2.2.1
  change ‖T‖ ≤ ‖liftContinuousLinearMap T‖
  exact T.opNorm_le_bound (norm_nonneg _) fun x ↦ by
    simpa only [liftContinuousLinearMap_apply, lift_of, norm_of] using
      (liftContinuousLinearMap T).le_opNorm (of x)

/-- A lattice homomorphism from `FBL E` is uniquely determined by its values on generators. -/
theorem lift_unique (T : E →L[ℝ] X) (S : VecLatHom (FBL E) X)
    (h : ∀ x : E, S (of x) = T x) : S = lift T :=
  let M : FBL E →L[ℝ] X :=
    { toLinearMap := S.toLinearMap
      cont := Positive.continuous (Positive.monotone_iff.mp S.monotone) }
  DFunLike.ext S (lift T) fun f ↦ DFunLike.congr_fun
    ((FBLp.universal_property_one T).choose_spec.2.2.2 M S.isVecLatHom h) f

/-- Every bounded linear map from `E` into a Banach lattice has a unique lattice extension
to `FBL E`, and the extension preserves the operator norm. -/
theorem exists_unique_lift (T : E →L[ℝ] X) :
    ∃! S : FBL E →L[ℝ] X,
      IsVecLatHom (S : FBL E → X) ∧ (∀ x : E, S (of x) = T x) ∧
        ‖S‖ = ‖T‖ :=
  ⟨liftContinuousLinearMap T, ⟨(lift T).isVecLatHom, lift_of T, norm_lift T⟩,
    fun S hS ↦ (FBLp.universal_property_one T).choose_spec.2.2.2 S hS.1 hS.2.1⟩

end FBL

namespace FBLp

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The identity lattice isometry between `FBLp 1 E` and its specialization `FBL E`. -/
def fblEquiv : BanachLatEquiv (FBLp 1 E) (FBL E) := BanachLatEquiv.refl _

/-- The identity equivalence preserves the canonical generators. -/
@[simp]
theorem fblEquiv_of (x : E) : fblEquiv (of 1 x) = FBL.of x := rfl

/-- The identity equivalence preserves evaluation at every dual functional. -/
@[simp]
theorem fblEquiv_apply (f : FBLp 1 E) (φ : StrongDual ℝ E) : fblEquiv f φ = f φ := rfl

end FBLp
