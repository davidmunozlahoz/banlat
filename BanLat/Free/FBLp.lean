/-!
# Free p-convex Banach lattices

For a real normed space `E` and `1 ≤ p ≤ ∞`, `FBLp p E` is the closed vector sublattice
of `FunctionSpace p E` generated by the evaluation functions `φ ↦ φ x`. The canonical
evaluation map embeds `E` isometrically, and the algebraic free vector lattice `FVLv E`
embeds as a norm dense sublattice. The resulting Banach lattice is p-convex with constant
one. Its defining property, `universal_property`, extends every bounded linear map
`S : E →L[ℝ] X` into a p-convex Banach lattice uniquely to a continuous lattice
homomorphism from `FBLp p E` to `X`, with norm at most `‖S‖` times the optimal
p-convexity constant of `X`. At `p = 1`, the universal property applies to every Banach lattice.
-/

noncomputable section

open scoped ENNReal Topology
open Filter Set

universe u v w

namespace FBLp

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]
  (p : ℝ≥0∞) [Fact (1 ≤ p)]

/-- The closure, in the free p-norm, of the vector sublattice generated by `φ ↦ φ x`
as `x` ranges over `E`. This realizes the free lattice inside `FunctionSpace p E`. -/
def freeSublattice (p : ℝ≥0∞) [Fact (1 ≤ p)] (E : Type u)
    [NormedAddCommGroup E] [NormedSpace ℝ E] : VectorSublattice (FunctionSpace p E) :=
  (VectorSublattice.generated
    (Set.range (functionSpaceEval p : E → FunctionSpace p E))).topologicalClosure

end FBLp

/-- The free p-convex Banach lattice over `E`, realized as homogeneous functions on its dual.
Its elements are limits in the free p-norm of finite vector lattice expressions in
evaluation functions, and its lattice operations are pointwise. -/
abbrev FBLp (p : ℝ≥0∞) [Fact (1 ≤ p)] (E : Type u)
    [NormedAddCommGroup E] [NormedSpace ℝ E] : Type u := FBLp.freeSublattice p E

namespace FBLp

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]
  (p : ℝ≥0∞) [Fact (1 ≤ p)]

/-- View an element of `FBLp p E` as its underlying function on the continuous dual.
Thus `f φ` evaluates the free lattice element `f` at the functional `φ`. -/
instance (p : ℝ≥0∞) [Fact (1 ≤ p)] : CoeFun (FBLp p E) (fun _ ↦ StrongDual ℝ E → ℝ) :=
  ⟨fun f ↦ f.1.1⟩

/-- The closed sublattice generated by evaluations inherits the free p-norm and pointwise
order from `FunctionSpace p E`. Closedness supplies completeness of `FBLp p E`. -/
instance freeBanachLattice (p : ℝ≥0∞) [Fact (1 ≤ p)] : BanachLattice (FBLp p E) :=
  VectorSublattice.banachLatticeCoe _
    (VectorSublattice.isClosed_topologicalClosure _)

/-- Membership of function defined on the dual in the free p-convex lattice:
`InFree p f` means that some element of `FBLp p E` agrees with `f` at every functional. -/
def InFree (p : ℝ≥0∞) [Fact (1 ≤ p)] (f : StrongDual ℝ E → ℝ) : Prop :=
  ∃ g : FBLp p E, ∀ φ, g φ = f φ

/-- The canonical linear isometry `E → FBLp p E`, sending `x` to `φ ↦ φ x`.
Its range generates the free lattice as a closed vector sublattice. -/
def of (p : ℝ≥0∞) [Fact (1 ≤ p)] : E →ₗᵢ[ℝ] FBLp p E where
  toFun x := ⟨functionSpaceEval p x, by
    exact (VectorSublattice.le_topologicalClosure _)
      (VectorSublattice.subset_generated _ (Set.mem_range_self x))⟩
  map_add' := by
    intro x y
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    exact map_add φ x y
  map_smul' := by
    intro c x
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    exact map_smul φ c x
  norm_map' := by
    intro x
    change (freeNormExt p (fun φ : StrongDual ℝ E ↦ φ x)).toReal = ‖x‖
    rw [freeNormExt_eval_eq, ENNReal.toReal_ofReal (norm_nonneg x)]

/-- Regard `‖φ‖⁻¹ • φ` as an element of the weak-star closed dual unit ball.
Nonzero functionals are sent to the unit sphere, and the zero functional is sent to zero. -/
def normalizedDual (φ : StrongDual ℝ E) : FVLv.dualUnitBall E :=
  ⟨StrongDual.toWeakDual (‖φ‖⁻¹ • φ), by
    change ‖φ‖⁻¹ • φ ∈ Metric.closedBall (0 : StrongDual ℝ E) 1
    exact inv_norm_smul_mem_unitClosedBall φ⟩

/-- Extend the dual-unit-ball model of `v : FVLv E` radially to the entire dual:
the value at `φ` is `‖φ‖` times the value at its normalization, with value zero at `φ = 0`. -/
def fvlFunction (v : FVLv E) (φ : StrongDual ℝ E) : ℝ := ‖φ‖ * v (normalizedDual φ)

private def radialEval (φ : StrongDual ℝ E) : VecLatHom (FVLv E) ℝ where
  toFun v := fvlFunction v φ
  map_add' := by
    intro v w
    simp [fvlFunction, mul_add]
  map_smul' := by
    intro c v
    simp [fvlFunction, mul_left_comm]
  map_sup' := by
    intro v w
    simp [fvlFunction, mul_max_of_nonneg, norm_nonneg]
  map_inf' := by
    intro v w
    simp [fvlFunction, mul_min_of_nonneg, norm_nonneg]

private lemma radialEval_of (φ : StrongDual ℝ E) (x : E) :
    radialEval φ (FVLv.of x) = φ x := by
  change ‖φ‖ * (FVLv.of x) (normalizedDual φ) = φ x
  rw [FVLv.of_apply]
  change ‖φ‖ * (‖φ‖⁻¹ • φ) x = φ x
  change ‖φ‖ * (‖φ‖⁻¹ * φ x) = φ x
  by_cases hφ : φ = 0
  · subst φ
    simp
  · rw [← mul_assoc, mul_inv_cancel₀ (norm_ne_zero_iff.mpr hφ), one_mul]

private def liftToFree : VecLatHom (FVLv E) (FBLp p E) :=
  FVLv.lift (of p).toLinearMap

/-- Evaluation at a dual functional is a vector lattice homomorphism on `FBLp p E`.
The linear and lattice operations are evaluated pointwise. -/
def evalVecLatHom (φ : StrongDual ℝ E) : VecLatHom (FBLp p E) ℝ where
  toFun f := f φ
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

private def evalFVLv (ψ : FVLv.dualUnitBall E) : VecLatHom (FVLv E) ℝ where
  toFun v := v ψ
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

private lemma radialEval_eq_liftToFree (φ : StrongDual ℝ E) (v : FVLv E) :
    fvlFunction v φ = liftToFree p v φ := by
  let ev : VecLatHom (FBLp p E) ℝ := {
    toFun := fun f ↦ f φ
    map_add' := by intros; rfl
    map_smul' := by intros; rfl
    map_sup' := by intros; rfl
    map_inf' := by intros; rfl }
  have hleft : radialEval φ = FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    exact radialEval_of φ x
  have hright : ev.comp (liftToFree p) = FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    change liftToFree p (FVLv.of x) φ = φ x
    rw [liftToFree, FVLv.lift_of]
    rfl
  have h := DFunLike.congr_fun (hleft.trans hright.symm) v
  exact h

/-- The canonical vector lattice homomorphism `FVLv E → FBLp p E`, given by radial extension
of the functions on the dual unit ball. It is injective, has dense range, and preserves
the generators corresponding to vectors of `E`. -/
def ofFVLv : VecLatHom (FVLv E) (FBLp p E) where
  toFun v := by
    let hmem : fvlFunction v ∈ finiteNormSublattice p E := by
      have hfun : fvlFunction v = (liftToFree p v).1.1 :=
        funext fun φ ↦ radialEval_eq_liftToFree p φ v
      rw [hfun]
      exact (liftToFree p v).1.2
    have hmemFree : (⟨fvlFunction v, hmem⟩ : FunctionSpace p E) ∈ freeSublattice p E := by
      have heq : (⟨fvlFunction v, hmem⟩ : FunctionSpace p E) = (liftToFree p v).1 := by
        apply Subtype.ext
        exact funext fun φ ↦ radialEval_eq_liftToFree p φ v
      rw [heq]
      exact (liftToFree p v).2
    exact ⟨⟨fvlFunction v, hmem⟩, hmemFree⟩
  map_add' := by
    intro v w
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    change fvlFunction (v + w) φ = fvlFunction v φ + fvlFunction w φ
    simp [fvlFunction, mul_add]
  map_smul' := by
    intro c v
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    change fvlFunction (c • v) φ = c * fvlFunction v φ
    simp [fvlFunction, mul_left_comm]
  map_sup' := by
    intro v w
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    change fvlFunction (v ⊔ w) φ = max (fvlFunction v φ) (fvlFunction w φ)
    simp [fvlFunction, mul_max_of_nonneg, norm_nonneg]
  map_inf' := by
    intro v w
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    change fvlFunction (v ⊓ w) φ = min (fvlFunction v φ) (fvlFunction w φ)
    simp [fvlFunction, mul_min_of_nonneg, norm_nonneg]

private lemma ofFVLv_eq_liftToFree :
    (ofFVLv p (E := E)) = liftToFree p := by
  apply DFunLike.ext
  intro v
  apply Subtype.ext
  apply Subtype.ext
  funext φ
  exact radialEval_eq_liftToFree p φ v

/-- The map from the free vector lattice sends the generator `FVLv.of x` to `of p x`.
Thus both constructions contain the same canonical copy of the generating space. -/
theorem ofFVLv_of (x : E) :
    ofFVLv p (FVLv.of x) = of p x := by
  rw [ofFVLv_eq_liftToFree]
  exact FVLv.lift_of (of p).toLinearMap x

/-- On the closed dual unit ball, the canonical image of `v : FVLv E` agrees with
its original function representation, for every exponent `p`. -/
theorem ofFVLv_apply_ball (v : FVLv E)
    (ψ : FVLv.dualUnitBall E) :
    ofFVLv p v (WeakDual.toStrongDual ψ.1) = v ψ := by
  let φ : StrongDual ℝ E := WeakDual.toStrongDual ψ.1
  have hleft : (evalVecLatHom p φ).comp (ofFVLv p) =
      FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    rw [VecLatHom.comp_apply, ofFVLv_of]
    rfl
  have hright : evalFVLv ψ = FVLv.lift (φ : E →ₗ[ℝ] ℝ) := by
    apply FVLv.lift_unique
    intro x
    change (FVLv.of x) ψ = φ x
    rw [FVLv.of_apply]
    rfl
  exact DFunLike.congr_fun (hleft.trans hright.symm) v

private lemma continuous_llExpr_dual_eval {n : ℕ} (x : Fin n → E) (e : LLexpr n) :
    Continuous (fun φ : StrongDual ℝ E ↦ LLexpr.eval (fun i ↦ φ (x i)) e) := by
  induction e with
  | zero => exact continuous_const
  | var i => exact (ContinuousLinearMap.apply ℝ ℝ (x i)).continuous
  | add e₁ e₂ h₁ h₂ => exact h₁.add h₂
  | smul c e h => exact continuous_const.mul h
  | sup e₁ e₂ h₁ h₂ => exact h₁.sup h₂
  | inf e₁ e₂ h₁ h₂ => exact h₁.inf h₂

private lemma continuous_llExpr_weak_eval {n : ℕ} (x : Fin n → E) (e : LLexpr n) :
    Continuous (fun φ : WeakDual ℝ E ↦ LLexpr.eval (fun i ↦ φ (x i)) e) := by
  induction e with
  | zero => exact continuous_const
  | var i => exact WeakDual.eval_continuous (x i)
  | add e₁ e₂ h₁ h₂ => exact h₁.add h₂
  | smul c e h => exact continuous_const.mul h
  | sup e₁ e₂ h₁ h₂ => exact h₁.sup h₂
  | inf e₁ e₂ h₁ h₂ => exact h₁.inf h₂

private lemma ofFVLv_expr_apply {n : ℕ} (x : Fin n → E)
    (e : LLexpr n) (φ : StrongDual ℝ E) :
    ofFVLv p (LLexpr.eval (fun i ↦ FVLv.of (x i)) e) φ =
      LLexpr.eval (fun i ↦ φ (x i)) e := by
  have hmap := LLexpr.map_eval ((evalVecLatHom p φ).comp (ofFVLv p))
    (fun i ↦ FVLv.of (x i)) e
  change ofFVLv p (LLexpr.eval (fun i ↦ FVLv.of (x i)) e) φ =
    LLexpr.eval (fun i ↦ ofFVLv p (FVLv.of (x i)) φ) e at hmap
  simpa [ofFVLv_of, of, functionSpaceEval] using hmap

private lemma ofFVLv_norm_continuous (v : FVLv E) :
    Continuous (fun φ : StrongDual ℝ E ↦ ofFVLv p v φ) := by
  obtain ⟨n, x, e, he⟩ := FVLv.exists_eval_of_eq v
  rw [← he]
  have hfun : (fun φ : StrongDual ℝ E ↦
      ofFVLv p (LLexpr.eval (fun i ↦ FVLv.of (x i)) e) φ) =
      (fun φ : StrongDual ℝ E ↦ LLexpr.eval (fun i ↦ φ (x i)) e) := by
    funext φ
    exact ofFVLv_expr_apply p x e φ
  rw [hfun]
  exact continuous_llExpr_dual_eval x e

private lemma ofFVLv_weakstar_continuous (v : FVLv E) :
    Continuous (fun φ : WeakDual ℝ E ↦ ofFVLv p v (WeakDual.toStrongDual φ)) := by
  obtain ⟨n, x, e, he⟩ := FVLv.exists_eval_of_eq v
  rw [← he]
  have hfun : (fun φ : WeakDual ℝ E ↦
      ofFVLv p (LLexpr.eval (fun i ↦ FVLv.of (x i)) e)
        (WeakDual.toStrongDual φ)) =
      (fun φ : WeakDual ℝ E ↦ LLexpr.eval (fun i ↦ φ (x i)) e) := by
    funext φ
    simpa only [WeakDual.toStrongDual_apply] using
      ofFVLv_expr_apply p x e (WeakDual.toStrongDual φ)
  rw [hfun]
  exact continuous_llExpr_weak_eval x e

private lemma free_apply_sub_le (f g : FBLp p E) (φ : StrongDual ℝ E) :
    |f φ - g φ| ≤ ‖φ‖ * ‖f - g‖ := by
  have h := functionSpace_apply_abs_le p (f.1 - g.1) φ
  change |f φ - g φ| ≤ ‖φ‖ * ‖f - g‖ at h
  exact h

/-- Explicit function formulas for the two canonical maps: `of p x` evaluates functionals
at `x`, while `ofFVLv p v` is the radial extension of the dual-unit-ball function `v`. -/
theorem model_evaluation (x : E) (v : FVLv E) (φ : StrongDual ℝ E) :
    of p x φ = φ x ∧ ofFVLv p v φ = fvlFunction v φ := by
  exact ⟨rfl, rfl⟩

/-- The free lattice order is determined by evaluations on the entire continuous dual:
`f ≤ g` holds exactly when `f φ ≤ g φ` for every functional `φ`. -/
theorem free_le_iff (f g : FBLp p E) :
    f ≤ g ↔ ∀ φ, f φ ≤ g φ := by rfl

/-- Applying `freeNormExt p` to the underlying function recovers the norm of an element of the
free p-convex Banach lattice, viewed in `ℝ≥0∞`.
This identifies the inherited norm with its defining formula. -/
theorem freeNormExt_eq_norm (f : FBLp p E) :
    freeNormExt p f = ENNReal.ofReal ‖f‖ := by
  exact (ENNReal.ofReal_toReal (ne_of_lt f.1.2.2)).symm

/-- The map `ofFVLv p` is injective and sends every generator to its canonical
evaluation function, identifying `FVLv E` with a vector sublattice of `FBLp p E`. -/
theorem ofFVLv_embedding : Function.Injective (ofFVLv p (E := E)) ∧
    ∀ x : E, ofFVLv p (FVLv.of x) = of p x := by
  refine ⟨?_, ofFVLv_of p⟩
  intro v w h
  apply Subtype.ext
  apply ContinuousMap.ext
  intro ψ
  have heq := congrArg (fun f : FBLp p E ↦ f (WeakDual.toStrongDual ψ.1)) h
  simpa only [ofFVLv_apply_ball] using heq

private lemma generated_mem_range_ofFVLv (y : FunctionSpace p E)
    (hy : y ∈ (VectorSublattice.generated
      (Set.range (functionSpaceEval p : E → FunctionSpace p E)) : Set (FunctionSpace p E))) :
    ∃ v : FVLv E, (ofFVLv p v : FunctionSpace p E) = y := by
  rw [LLexpr.generated_eq_iUnion_combinations
    (Set.range (functionSpaceEval p : E → FunctionSpace p E))] at hy
  simp only [Set.mem_iUnion, LLexpr.combinations, Set.mem_range] at hy
  obtain ⟨n, z, e, hz⟩ := hy
  choose x hx using fun i : Fin n ↦ (z i).2
  refine ⟨LLexpr.eval (fun i : Fin n ↦ FVLv.of (x i)) e, ?_⟩
  have hmap : ofFVLv p (LLexpr.eval (fun i : Fin n ↦ FVLv.of (x i)) e) =
      LLexpr.eval (fun i : Fin n ↦ of p (x i)) e := by
    simpa only [ofFVLv_of] using
      LLexpr.map_eval (ofFVLv p) (fun i : Fin n ↦ FVLv.of (x i)) e
  calc
    ((ofFVLv p (LLexpr.eval (fun i : Fin n ↦ FVLv.of (x i)) e) : FBLp p E) : FunctionSpace p E) =
        ((LLexpr.eval (fun i : Fin n ↦ of p (x i)) e : FBLp p E) : FunctionSpace p E) := by
      rw [hmap]
    _ = LLexpr.eval (fun i : Fin n ↦ ((of p (x i) : FBLp p E) : FunctionSpace p E)) e :=
      LLexpr.coe_eval_vectorSublattice (freeSublattice p E)
        (fun i : Fin n ↦ of p (x i)) e
    _ = LLexpr.eval (fun i : Fin n ↦ functionSpaceEval p (x i)) e := by
      congr
    _ = LLexpr.eval (fun i : Fin n ↦ (z i : FunctionSpace p E)) e := by
      congr
      funext i
      rw [hx i]
    _ = (y : FunctionSpace p E) := hz

/-- Every element of `FBLp p E` can be approximated in the free p-norm by elements of
`FVLv E`, equivalently by finite vector lattice expressions in the generators. -/
theorem denseRange_ofFVLv : DenseRange (ofFVLv p (E := E)) := by
  let G := VectorSublattice.generated (Set.range (functionSpaceEval p : E → FunctionSpace p E))
  let C := freeSublattice p E
  have hGC : G ≤ C := (VectorSublattice.generated
    (Set.range (functionSpaceEval p : E → FunctionSpace p E))).le_topologicalClosure
  let ι : G → FBLp p E := Set.inclusion hGC
  have hι_dense : DenseRange ι := by
    change DenseRange (Set.inclusion hGC)
    exact (denseRange_inclusion_iff hGC).2 (by
      change (G.topologicalClosure : Set (FunctionSpace p E)) ⊆ _
      rw [VectorSublattice.topologicalClosure_coe])
  have hι_range : Set.range ι ⊆ Set.range (ofFVLv p (E := E)) := by
    rintro _ ⟨y, rfl⟩
    obtain ⟨v, hv⟩ := generated_mem_range_ofFVLv p (y : FunctionSpace p E) y.2
    exact ⟨v, Subtype.ext hv⟩
  exact Dense.mono hι_range hι_dense

private def realPosHomEval {n : ℕ} (x : Fin n → ℝ) : VecLatHom (posHomFunctions n) ℝ where
  toFun f := f x
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

private lemma realPosHomFunctionalCalculus [IsUniformlyCompleteVectorLattice ℝ]
    {n : ℕ} (x : Fin n → ℝ)
    (h : posHomFunctions n) : PosHomFunction.functionalCalculus x h = h x := by
  have heq := PosHomFunction.eq_functionalCalculus_of_map_coordinate x
    (realPosHomEval x) (by intro i; rfl)
  exact (DFunLike.congr_fun heq h).symm

/-- Evaluating a lattice q-sum at an element of the dual gives the scalar `ℓ^q` norm of the
evaluations on this element. The exponent `q` may differ from the exponent `p` defining the
free lattice. -/
theorem latticePSum_apply (q : ℝ≥0∞) [Fact (1 ≤ q)] {n : ℕ}
    (f : Fin n → FBLp p E) (φ : StrongDual ℝ E) :
    latticePSum q f φ = ‖WithLp.toLp q (fun i ↦ f i φ)‖ := by
  letI := isUniformlyCompleteVectorLattice_of_banachLattice (FBLp p E)
  letI := isUniformlyCompleteVectorLattice_of_banachLattice ℝ
  change evalVecLatHom p φ (PosHomFunction.functionalCalculus f (pSumFunction q n)) = _
  calc
    evalVecLatHom p φ (PosHomFunction.functionalCalculus f (pSumFunction q n)) =
        PosHomFunction.functionalCalculus (fun i ↦ evalVecLatHom p φ (f i))
          (pSumFunction q n) := by
      exact PosHomFunction.functionalCalculus_map (evalVecLatHom p φ) f
        (pSumFunction q n)
    _ = ‖WithLp.toLp q (fun i ↦ f i φ)‖ := by
      rw [realPosHomFunctionalCalculus]
      rfl

private lemma norm_swap {n m : ℕ} (a : Fin n → Fin m → ℝ) :
    ‖WithLp.toLp p (fun i ↦ ‖WithLp.toLp p (a i)‖)‖ =
      ‖WithLp.toLp p (fun j ↦ ‖WithLp.toLp p (fun i ↦ a i j)‖)‖ := by
  by_cases hp : p = ∞
  · subst p
    simp only [PiLp.norm_toLp]
    simp only [Pi.norm_def, nnnorm, Real.norm_eq_abs, NNReal.abs_eq]
    exact congrArg NNReal.toReal
      (Finset.sup_comm Finset.univ Finset.univ (fun i j ↦ ‖a i j‖₊))
  · have hp0 : 0 < p.toReal := ENNReal.toReal_pos_iff.mpr
      ⟨lt_of_lt_of_le zero_lt_one (Fact.out : 1 ≤ p), lt_top_iff_ne_top.mpr hp⟩
    simp only [PiLp.norm_eq_sum hp0, Real.norm_eq_abs, one_div]
    simp only [abs_of_nonneg (Real.rpow_nonneg
      (Finset.sum_nonneg fun _ _ ↦ Real.rpow_nonneg (abs_nonneg _) _) _),
      Real.rpow_inv_rpow (Finset.sum_nonneg fun _ _ ↦
        Real.rpow_nonneg (abs_nonneg _) _) hp0.ne']
    rw [Finset.sum_comm]

private lemma freeNormExt_latticePSum_le {n : ℕ}
    (f : Fin n → FBLp p E) :
    freeNormExt p (latticePSum p f : FBLp p E).1.1 ≤
      ENNReal.ofReal (‖WithLp.toLp p (fun i ↦ ‖f i‖)‖) := by
  by_cases htop : p = ⊤
  · rw [freeNormExt, if_pos htop]
    refine iSup_le fun φ ↦ iSup_le fun hφ ↦ ?_
    apply ENNReal.ofReal_le_ofReal
    rw [latticePSum_apply, abs_of_nonneg (norm_nonneg _)]
    apply norm_le_norm_of_abs_le_abs
    intro i
    change |f i φ| ≤ |‖f i‖|
    have hnorm : ‖(f i).1‖ = ‖f i‖ := rfl
    simpa only [abs_of_nonneg (norm_nonneg (f i)), hnorm] using
      (functionSpace_unit_eval_le p (f i).1 φ hφ)
  · rw [freeNormExt, if_neg htop]
    refine iSup_le fun m ↦ iSup_le fun φ ↦ iSup_le fun hφ ↦ ?_
    apply ENNReal.ofReal_le_ofReal
    simp_rw [latticePSum_apply]
    rw [norm_swap]
    apply norm_le_norm_of_abs_le_abs
    intro i
    change |‖WithLp.toLp p (fun j ↦ f i (φ j))‖| ≤ |‖f i‖|
    have hle := functionSpace_admissible_eval_le p htop (f i).1 φ hφ
    have hnorm : ‖(f i).1‖ = ‖f i‖ := rfl
    simpa only [abs_of_nonneg (norm_nonneg _),
      abs_of_nonneg (norm_nonneg (f i)), hnorm] using hle

/-- The identity on `FBLp p E` satisfies the p-convexity inequality with constant one:
the norm of a finite lattice p-sum is bounded by the ℓᵖ sum of the individual norms. -/
theorem convexWith_id : ConvexWith p 1 (ContinuousLinearMap.id ℝ (FBLp p E)) := by
  refine ⟨zero_le_one, ?_⟩
  intro n f
  rw [one_mul]
  change (freeNormExt p (latticePSum p f : FBLp p E).1.1).toReal ≤ _
  exact ENNReal.toReal_le_of_le_ofReal (norm_nonneg _)
    (freeNormExt_latticePSum_le p f)

/-- The free Banach lattice `FBLp p E` is p-convex, witnessed by the constant-one
estimate for its identity operator. -/
theorem isPConvex : IsPConvex p (FBLp p E) := ⟨1, convexWith_id p⟩

variable {F : Type v} [NormedAddCommGroup F] [NormedSpace ℝ F]

private lemma normAdmissible_comp_scaled {n : ℕ}
    (T : F →L[ℝ] E) (hT : 0 < ‖T‖) (φ : Fin n → StrongDual ℝ E)
    (hφ : NormAdmissible p φ) :
    NormAdmissible p (fun i ↦ ‖T‖⁻¹ • (φ i).comp T) := by
  intro x hx
  have hfun : (fun i ↦ (‖T‖⁻¹ • (φ i).comp T) x) =
      (fun i ↦ ‖T‖⁻¹ * φ i (T x)) := by
    funext i
    rfl
  rw [hfun]
  change ‖‖T‖⁻¹ • WithLp.toLp p (fun i ↦ φ i (T x))‖ ≤ 1
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hT)]
  have hadm := normAdmissible_eval_le_norm p φ hφ (T x)
  have hop := T.le_opNorm x
  have hle : ‖T x‖ ≤ ‖T‖ := by
    calc
      ‖T x‖ ≤ ‖T‖ * ‖x‖ := hop
      _ ≤ ‖T‖ * 1 := mul_le_mul_of_nonneg_left hx (norm_nonneg T)
      _ = ‖T‖ := mul_one _
  calc
    ‖T‖⁻¹ * ‖WithLp.toLp p (fun i ↦ φ i (T x))‖ ≤ ‖T‖⁻¹ * ‖T x‖ :=
      mul_le_mul_of_nonneg_left hadm (le_of_lt (inv_pos.mpr hT))
    _ ≤ ‖T‖⁻¹ * ‖T‖ := mul_le_mul_of_nonneg_left hle (le_of_lt (inv_pos.mpr hT))
    _ = 1 := inv_mul_cancel₀ hT.ne'

private lemma freeNormExt_comp_le (T : F →L[ℝ] E)
    (f : StrongDual ℝ F → ℝ) (hf : PosHomogeneous f) :
    freeNormExt p (fun φ : StrongDual ℝ E ↦ f (φ.comp T)) ≤
      ENNReal.ofReal ‖T‖ * freeNormExt p f := by
  by_cases hT0 : ‖T‖ = 0
  · have hT : T = 0 := norm_eq_zero.mp hT0
    have hf0 : f 0 = 0 := by
      have h := hf 0 (le_refl 0) (0 : StrongDual ℝ F)
      simpa using h
    have hfun : (fun φ : StrongDual ℝ E ↦ f (φ.comp T)) = fun _ ↦ 0 := by
      funext φ
      simp [hT, hf0]
    rw [hfun, freeNormExt_zero, hT0, ENNReal.ofReal_zero, zero_mul]
  · have hT : 0 < ‖T‖ := lt_of_le_of_ne (norm_nonneg T) (Ne.symm hT0)
    by_cases htop : p = ⊤
    · rw [freeNormExt, if_pos htop]
      refine iSup_le fun φ ↦ iSup_le fun hφ ↦ ?_
      let ψ : StrongDual ℝ F := ‖T‖⁻¹ • φ.comp T
      have hcomp : ‖φ.comp T‖ ≤ ‖T‖ := by
        calc
          ‖φ.comp T‖ ≤ ‖φ‖ * ‖T‖ := φ.opNorm_comp_le T
          _ ≤ 1 * ‖T‖ := mul_le_mul_of_nonneg_right hφ (norm_nonneg T)
          _ = ‖T‖ := one_mul _
      have hψ : ‖ψ‖ ≤ 1 := by
        dsimp [ψ]
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hT)]
        calc
          ‖T‖⁻¹ * ‖φ.comp T‖ ≤ ‖T‖⁻¹ * ‖T‖ :=
            mul_le_mul_of_nonneg_left hcomp (le_of_lt (inv_pos.mpr hT))
          _ = 1 := inv_mul_cancel₀ hT.ne'
      have hscaled : ‖T‖ • ψ = φ.comp T := by
        dsimp [ψ]
        rw [smul_smul, mul_inv_cancel₀ hT.ne', one_smul]
      have hval : f (φ.comp T) = ‖T‖ * f ψ := by
        rw [← hscaled, hf ‖T‖ (le_of_lt hT) ψ]
      have hle := ofReal_abs_le_freeNormExt p f ψ hψ
      calc
        ENNReal.ofReal |f (φ.comp T)| =
            ENNReal.ofReal ‖T‖ * ENNReal.ofReal |f ψ| := by
          rw [hval, abs_mul, abs_of_nonneg (norm_nonneg T),
            ENNReal.ofReal_mul (norm_nonneg T)]
        _ ≤ ENNReal.ofReal ‖T‖ * freeNormExt p f :=
          mul_le_mul_of_nonneg_left hle (by positivity)
    · rw [freeNormExt, if_neg htop]
      refine iSup_le fun n ↦ iSup_le fun φ ↦ iSup_le fun hφ ↦ ?_
      let ψ : Fin n → StrongDual ℝ F := fun i ↦ ‖T‖⁻¹ • (φ i).comp T
      have hψ : NormAdmissible p ψ := normAdmissible_comp_scaled p T hT φ hφ
      have hscaled (i : Fin n) : ‖T‖ • ψ i = (φ i).comp T := by
        dsimp [ψ]
        rw [smul_smul, mul_inv_cancel₀ hT.ne', one_smul]
      have hfun : (fun i ↦ f ((φ i).comp T)) = fun i ↦ ‖T‖ * f (ψ i) := by
        funext i
        rw [← hscaled i, hf ‖T‖ (le_of_lt hT) (ψ i)]
      have hle : ENNReal.ofReal (‖WithLp.toLp p (fun i ↦ f (ψ i))‖) ≤
          freeNormExt p f := by
        rw [freeNormExt, if_neg htop]
        exact le_iSup_of_le n (le_iSup_of_le ψ (le_iSup_of_le hψ le_rfl))
      calc
        ENNReal.ofReal (‖WithLp.toLp p (fun i ↦ f ((φ i).comp T))‖) =
            ENNReal.ofReal ‖T‖ *
              ENNReal.ofReal (‖WithLp.toLp p (fun i ↦ f (ψ i))‖) := by
          rw [hfun, show ‖WithLp.toLp p (fun i ↦ ‖T‖ * f (ψ i))‖ =
              |‖T‖| * ‖WithLp.toLp p (fun i ↦ f (ψ i))‖ from
              norm_smul ‖T‖ (WithLp.toLp p (fun i ↦ f (ψ i))), abs_of_pos hT,
            ENNReal.ofReal_mul (norm_nonneg T)]
        _ ≤ ENNReal.ofReal ‖T‖ * freeNormExt p f :=
          mul_le_mul_of_nonneg_left hle (by positivity)

private lemma freeNormExt_comp_norm_le (T : F →L[ℝ] E)
    (f : FBLp p F) :
    (freeNormExt p (fun φ : StrongDual ℝ E ↦ f (φ.comp T))).toReal ≤ ‖T‖ * ‖f‖ := by
  have hle := freeNormExt_comp_le p T f.1.1 f.1.2.1
  have hnorm : freeNormExt p f.1.1 = ENNReal.ofReal ‖f‖ :=
    freeNormExt_eq_norm p f
  rw [hnorm, ← ENNReal.ofReal_mul (norm_nonneg T)] at hle
  exact ENNReal.toReal_le_of_le_ofReal
    (mul_nonneg (norm_nonneg T) (norm_nonneg f)) hle

/-- Composition with the adjoint of `T : F →L[ℝ] E` sends `f` to `φ ↦ f (φ.comp T)`.
This defines a vector lattice homomorphism between the ambient spaces of positively
homogeneous functions with finite free p-norm. -/
def compFunctionSpace (T : F →L[ℝ] E) :
    VecLatHom (FunctionSpace p F) (FunctionSpace p E) where
  toFun f := ⟨fun φ ↦ f (φ.comp T), by
    refine ⟨?_, ?_⟩
    · intro a ha φ
      change f ((a • φ).comp T) = a * f (φ.comp T)
      have hcomp : (a • φ).comp T = a • (φ.comp T) := by
        ext x
        rfl
      rw [hcomp]
      exact f.2.1 a ha (φ.comp T)
    · exact (freeNormExt_comp_le p T f.1 f.2.1).trans_lt
        (ENNReal.mul_lt_top ENNReal.ofReal_lt_top f.2.2)⟩
  map_add' := by
    intro f g
    apply Subtype.ext
    funext φ
    rfl
  map_smul' := by
    intro c f
    apply Subtype.ext
    funext φ
    rfl
  map_sup' := by
    intro f g
    apply Subtype.ext
    funext φ
    rfl
  map_inf' := by
    intro f g
    apply Subtype.ext
    funext φ
    rfl

/-- Composition with the adjoint of `T : F →L[ℝ] E` maps the closed sublattice generated
by evaluations from `F` into the one generated by evaluations from `E`.
Thus `compFunctionSpace p T` restricts to a map `FBLp p F → FBLp p E`. -/
theorem compFunctionSpace_mem_free (T : F →L[ℝ] E)
    (f : FBLp p F) : compFunctionSpace p T f.1 ∈ freeSublattice p E := by
  let D : VectorSublattice (FunctionSpace p F) := {
    toSubmodule := {
      carrier := {h | compFunctionSpace p T h ∈ freeSublattice p E}
      zero_mem' := by
        change compFunctionSpace p T (0 : FunctionSpace p F) ∈ freeSublattice p E
        rw [map_zero]
        exact (freeSublattice p E).zero_mem
      add_mem' := by
        intro h k hh hk
        change compFunctionSpace p T (h + k) ∈ freeSublattice p E
        rw [map_add]
        exact (freeSublattice p E).add_mem hh hk
      smul_mem' := by
        intro c h hh
        change compFunctionSpace p T (c • h) ∈ freeSublattice p E
        rw [map_smul]
        exact (freeSublattice p E).smul_mem c hh }
    sup_mem' := by
      intro h k hh hk
      change compFunctionSpace p T (h ⊔ k) ∈ freeSublattice p E
      exact (freeSublattice p E).sup_mem hh hk }
  have hDclosed : IsClosed (D : Set (FunctionSpace p F)) := by
    change IsClosed ((compFunctionSpace p T) ⁻¹'
      (freeSublattice p E : Set (FunctionSpace p E)))
    exact (VectorSublattice.isClosed_topologicalClosure _).preimage
      (Positive.continuous (Positive.monotone_iff.mp (compFunctionSpace p T).monotone))
  have hgenerated :
      VectorSublattice.generated (Set.range (functionSpaceEval p : F → FunctionSpace p F)) ≤ D := by
    apply VectorSublattice.generated_le
    rintro _ ⟨x, rfl⟩
    change compFunctionSpace p T (functionSpaceEval p x) ∈ freeSublattice p E
    have heq : compFunctionSpace p T (functionSpaceEval p x) = functionSpaceEval p (T x) := by
      apply Subtype.ext
      funext φ
      rfl
    rw [heq]
    exact (of p (T x)).2
  have hclosure := VectorSublattice.topologicalClosure_minimal hgenerated hDclosed
  have hf : (f.1 : FunctionSpace p F) ∈ D := hclosure f.2
  exact hf

private def inducedLinearMap (T : F →L[ℝ] E) : FBLp p F →ₗ[ℝ] FBLp p E where
  toFun f := ⟨compFunctionSpace p T f.1, compFunctionSpace_mem_free p T f⟩
  map_add' := fun _ _ ↦ Subtype.ext rfl
  map_smul' := fun _ _ ↦ Subtype.ext rfl

/-- A bounded linear map `T : F →L[ℝ] E` induces a continuous lattice homomorphism
`FBLp p F → FBLp p E` by sending `f` to `φ ↦ f (φ.comp T)`. -/
def induced (T : F →L[ℝ] E) : FBLp p F →L[ℝ] FBLp p E :=
  (inducedLinearMap p T).mkContinuous ‖T‖ (freeNormExt_comp_norm_le p T)

/-- The continuous linear map induced by `T` also preserves suprema and infima.
It therefore gives a vector lattice homomorphism between the corresponding free lattices. -/
theorem induced_isVecLatHom (T : F →L[ℝ] E) : IsVecLatHom (induced p T) where
  map_add := (induced p T).map_add
  map_smul := (induced p T).map_smul
  map_sup' := fun _ _ ↦ Subtype.ext rfl
  map_inf' := fun _ _ ↦ Subtype.ext rfl

/-- At `φ : E*`, the induced map evaluates `f` at the pullback `φ.comp T : F*`.
This is the pointwise formula for the action of `T` on free lattice functions. -/
@[simp]
theorem induced_apply (T : F →L[ℝ] E)
    (f : FBLp p F) (φ : StrongDual ℝ E) : induced p T f φ = f (φ.comp T) := by rfl

/-- The map induced by `T` has operator norm exactly `‖T‖` and sends `of p x` to `of p (T x)`.
Thus it extends `T` between the canonical isometric copies of the generating spaces. -/
theorem induced_norm_generators (T : F →L[ℝ] E) :
    ‖(induced p T)‖ = ‖T‖ ∧
    ∀ x, induced p T (of p x) = of p (T x) := by
  have hgen (x : F) : induced p T (of p x) = of p (T x) := by
    apply Subtype.ext
    apply Subtype.ext
    funext φ
    rfl
  have hupper : ‖(induced p T)‖ ≤ ‖T‖ :=
    (induced p T).opNorm_le_bound (norm_nonneg T) (by
      intro f
      change (freeNormExt p (fun φ : StrongDual ℝ E ↦ f (φ.comp T))).toReal ≤ ‖T‖ * ‖f‖
      exact freeNormExt_comp_norm_le p T f)
  have hlower : ‖T‖ ≤ ‖(induced p T)‖ :=
    T.opNorm_le_bound (norm_nonneg _) (by
      intro x
      calc
        ‖T x‖ = ‖of p (T x)‖ := ((of p).norm_map (T x)).symm
        _ = ‖induced p T (of p x)‖ := by rw [hgen]
        _ ≤ ‖(induced p T)‖ * ‖of p x‖ :=
          (induced p T).le_opNorm (of p x)
        _ = ‖(induced p T)‖ * ‖x‖ := by
          rw [(of p).norm_map])
  exact ⟨le_antisymm hupper hlower, hgen⟩

/-- Evaluating a free lattice element on an admissible dual family gives an ℓᵖ norm
bounded by its free p-norm. At infinity, this bounds the maximum absolute evaluation. -/
theorem norm_eval_le {n : ℕ} (f : FBLp p E)
    (φ : Fin n → StrongDual ℝ E) (hφ : NormAdmissible p φ) :
    ‖WithLp.toLp p (fun i ↦ f (φ i))‖ ≤ ‖f‖ := by
  by_cases hp : p = ∞
  · subst p
    have hnorm (i : Fin n) : ‖φ i‖ ≤ 1 :=
      (φ i).opNorm_le_bound zero_le_one (fun x ↦ by
        simpa only [one_mul] using
          (PiLp.norm_apply_le (WithLp.toLp ∞ (fun j ↦ φ j x)) i).trans
            (normAdmissible_eval_le_norm ∞ φ hφ x))
    simpa only [PiLp.norm_toLp] using
      (pi_norm_le_iff_of_nonneg (x := fun i ↦ f (φ i)) (norm_nonneg f)).2
        (fun i ↦ functionSpace_unit_eval_le ∞ f.1 (φ i) (hnorm i))
  · exact functionSpace_admissible_eval_le p hp f.1 φ hφ

variable {X : Type w} [NormedAddCommGroup X] [Lattice X]
  [IsOrderedAddMonoid X] [BanachLattice X]

/-- For a positive functional `ψ`, the ℓᵖ norm of the tuple `(ψ (x i))` is bounded by
`ψ (latticePSum p x)`. The vectors `x i` need not be positive. -/
theorem positive_dual_scalarPSum_le {n : ℕ} (x : Fin n → X)
    (ψ : StrongDual ℝ X) (hψ : 0 ≤ ψ) :
    ‖WithLp.toLp p (fun i ↦ ψ (x i))‖ ≤ ψ (latticePSum p x) := by
  letI := isUniformlyCompleteVectorLattice_of_banachLattice X
  let y : PiLp p (fun _ : Fin n ↦ ℝ) := WithLp.toLp p (fun i ↦ ψ (x i))
  obtain ⟨l, hl, hly⟩ := exists_dual_vector'' ℝ y
  let a : Fin n → ℝ := fun i ↦ l (PiLp.single p i 1)
  have hlin (z : Fin n → ℝ) :
      ∑ i, a i * z i = l (WithLp.toLp p z) := by
    have hz := (PiLp.basisFun p ℝ (Fin n)).sum_repr (WithLp.toLp p z)
    simpa [a, map_sum, map_smul, smul_eq_mul, mul_comm] using congrArg l hz
  have hpoint : (∑ i, a i • PosHomFunction.coordinate i) ≤ pSumFunction p n := by
    intro z
    change (∑ i, a i • PosHomFunction.coordinate i : posHomFunctions n) z ≤ ‖WithLp.toLp p z‖
    change ((posHomFunctions n).toSubmodule.subtype
      (∑ i, a i • PosHomFunction.coordinate i)) z ≤ _
    simp only [map_sum, map_smul, ContinuousMap.sum_apply,
      ContinuousMap.smul_apply, smul_eq_mul]
    change (∑ i, a i * z i) ≤ ‖WithLp.toLp p z‖
    rw [hlin]
    exact (le_abs_self _).trans ((l.le_opNorm _).trans
      (by simpa only [one_mul] using mul_le_mul_of_nonneg_right hl (norm_nonneg _)))
  have hcalc := (PosHomFunction.functionalCalculus x).monotone hpoint
  simp only [map_sum, map_smul, PosHomFunction.functionalCalculus_coordinate] at hcalc
  have hbound := StrongDual.apply_le_apply_of_nonneg hψ hcalc
  simp only [map_sum, map_smul, smul_eq_mul] at hbound
  rw [hlin] at hbound
  change l y ≤ ψ (latticePSum p x) at hbound
  simpa [hly, y] using hbound

private lemma positive_dual_family_pSum_le {C : ℝ}
    (hC : ConvexWith p C (ContinuousLinearMap.id ℝ X)) {m n : ℕ} (ψ : Fin m → StrongDual ℝ X)
    (hψ : ∀ i, 0 ≤ ψ i) (x : Fin n → X) :
    ∑ i, ‖WithLp.toLp p (fun j ↦ ψ i (x j))‖ ≤
      ‖∑ i, ψ i‖ * C * ‖WithLp.toLp p (fun j ↦ ‖x j‖)‖ := by
  have h := Finset.sum_le_sum (s := Finset.univ)
    (fun i _ ↦ positive_dual_scalarPSum_le p x (ψ i) (hψ i))
  calc
    ∑ i, ‖WithLp.toLp p (fun j ↦ ψ i (x j))‖ ≤ ∑ i, ψ i (latticePSum p x) := h
    _ = (∑ i, ψ i) (latticePSum p x) := by simp
    _ ≤ ‖∑ i, ψ i‖ * ‖latticePSum p x‖ :=
      (le_abs_self _).trans ((∑ i, ψ i).le_opNorm _)
    _ ≤ ‖∑ i, ψ i‖ * (C * ‖WithLp.toLp p (fun j ↦ ‖x j‖)‖) :=
      mul_le_mul_of_nonneg_left (hC.2 n x) (norm_nonneg _)
    _ = _ := by ring

private lemma mem_convexHull_exists_fin {d : ℕ} {s : Set (Fin d → ℝ)}
    {a : Fin d → ℝ} (ha : a ∈ convexHull ℝ s) :
    ∃ n : ℕ, ∃ c : Fin n → ℝ, ∃ z : Fin n → (Fin d → ℝ),
      (∀ j, 0 ≤ c j) ∧ (∑ j, c j = 1) ∧ (∀ j, z j ∈ s) ∧ ∑ j, c j • z j = a := by
  obtain ⟨ι, _, c, z, hc, hsum, hz, ha⟩ := mem_convexHull_iff_exists_fintype.mp ha
  let e := Fintype.equivFin ι
  refine ⟨Fintype.card ι, c ∘ e.symm, z ∘ e.symm, fun j ↦ hc _, ?_, fun j ↦ hz _, ?_⟩
  · simpa only [Function.comp_apply] using (e.symm.sum_comp c).trans hsum
  · simpa only [Function.comp_apply] using
      (e.symm.sum_comp (fun j ↦ c j • z j)).trans ha

private lemma positive_dual_convexHull_pSum_le (hp : (p < ∞)) {C : ℝ}
    (hC : ConvexWith p C (ContinuousLinearMap.id ℝ X)) {m : ℕ} (ψ : Fin m → StrongDual ℝ X)
    (hψ : ∀ i, 0 ≤ ψ i) {a : Fin m → ℝ}
    (ha : a ∈ convexHull ℝ ((fun x : X ↦ fun i ↦ |ψ i x| ^ p.toReal) ''
      Metric.closedBall 0 1)) :
    ∑ i, (a i) ^ (1 / p.toReal) ≤ ‖∑ i, ψ i‖ * C := by
  obtain ⟨n, c, z, hc, hsum, hz, rfl⟩ := mem_convexHull_exists_fin ha
  choose x hx hz using hz
  let y : Fin n → X := fun j ↦ c j ^ (1 / p.toReal) • x j
  have hp0 : 0 < p.toReal := ENNReal.toReal_pos_iff.mpr
    ⟨lt_of_lt_of_le zero_lt_one (Fact.out : 1 ≤ p), hp⟩
  have hpow (j : Fin n) : (c j ^ (1 / p.toReal)) ^ p.toReal = c j := by
    simpa only [one_div] using Real.rpow_inv_rpow (hc j) hp0.ne'
  have hcoord (i : Fin m) : (∑ j, c j • z j) i = ∑ j, |ψ i (y j)| ^ p.toReal := by
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    apply Finset.sum_congr rfl
    intro j _
    rw [← hz j]
    simp only [y, map_smul, smul_eq_mul, abs_mul,
      abs_of_nonneg (Real.rpow_nonneg (hc j) _)]
    rw [Real.mul_rpow (Real.rpow_nonneg (hc j) _) (abs_nonneg _), hpow]
  have hynorm : ‖WithLp.toLp p (fun j ↦ ‖y j‖)‖ ≤ 1 := by
    have hle : ‖WithLp.toLp p (fun j ↦ ‖y j‖)‖ ≤
        ‖WithLp.toLp p (fun j ↦ c j ^ (1 / p.toReal))‖ := by
      apply norm_le_norm_of_abs_le_abs
      intro j
      change |‖y j‖| ≤ |c j ^ (1 / p.toReal)|
      rw [abs_of_nonneg (norm_nonneg (y j))]
      simp only [y, norm_smul, Real.norm_eq_abs,
        abs_of_nonneg (Real.rpow_nonneg (hc j) _)]
      exact mul_le_of_le_one_right (Real.rpow_nonneg (hc j) _)
        (mem_closedBall_zero_iff.mp (hx j))
    convert hle using 1
    simp only [PiLp.norm_eq_sum hp0, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (hc _) _), hpow, hsum, Real.one_rpow]
  have h := positive_dual_family_pSum_le p hC ψ hψ y
  have hb := h.trans (mul_le_of_le_one_right
    (mul_nonneg (norm_nonneg _) hC.1) hynorm)
  simpa only [hcoord, PiLp.norm_eq_sum hp0, Real.norm_eq_abs] using hb

private lemma exists_positive_diagonal_weights {n : ℕ} {r δ : ℝ}
    (hr : 0 < r) (hδ : 0 < δ) (K : Set (Fin n → ℝ))
    (hK : IsCompact K) (hne : K.Nonempty) (hconv : Convex ℝ K)
    (hpos : ∀ a ∈ K, ∀ i, 0 ≤ a i) :
    ∃ a ∈ K, ∀ b ∈ K,
      ∑ i, (a i + δ) ^ (r - 1) * b i ≤
        ∑ i, (a i + δ) ^ (r - 1) * a i := by
  let g : (Fin n → ℝ) → ℝ := fun a ↦ ∑ i, (a i + δ) ^ r
  have hg : Continuous g := by
    exact continuous_finsetSum _ (fun i _ ↦
      ((continuous_apply i).add continuous_const).rpow_const (fun _ ↦ Or.inr hr.le))
  obtain ⟨a, ha, hmax⟩ := hK.exists_isMaxOn hne hg.continuousOn
  have hd (i : Fin n) : HasFDerivAt (fun b : Fin n → ℝ ↦ (b i + δ) ^ r)
      ((r * (a i + δ) ^ (r - 1)) •
        (ContinuousLinearMap.proj i : (Fin n → ℝ) →L[ℝ] ℝ)) a := by
    exact (((ContinuousLinearMap.proj i : (Fin n → ℝ) →L[ℝ] ℝ).hasFDerivAt
      (x := a)).add_const δ).rpow_const
      (Or.inl (ne_of_gt (add_pos_of_nonneg_of_pos (hpos a ha i) hδ)))
  have hdg := HasFDerivAt.fun_sum (u := Finset.univ) (fun i _ ↦ hd i)
  refine ⟨a, ha, ?_⟩
  intro b hb
  have hdir := hmax.localize.hasFDerivWithinAt_nonpos hdg.hasFDerivWithinAt
    (sub_mem_posTangentConeAt_of_segment_subset (hconv.segment_subset ha hb))
  simp only [sum_apply, smul_apply,
    ContinuousLinearMap.proj_apply, Pi.sub_apply, smul_eq_mul] at hdir
  simp_rw [mul_assoc, mul_sub] at hdir
  rw [Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.mul_sum] at hdir
  nlinarith

private lemma positive_dual_diagonal_bound (hp : (p < ∞)) {C δ : ℝ}
    (hC : ConvexWith p C (ContinuousLinearMap.id ℝ X)) (hδ : 0 < δ)
    {m : ℕ} (ψ : Fin m → StrongDual ℝ X)
    (hψ : ∀ i, 0 ≤ ψ i) :
    ∃ a : Fin m → ℝ, (∀ i, 0 ≤ a i) ∧
      (∑ i, (a i) ^ (1 / p.toReal) ≤ ‖∑ i, ψ i‖ * C) ∧
      ∀ x : X, ‖x‖ ≤ 1 →
        ∑ i, (a i + δ) ^ (1 / p.toReal - 1) * |ψ i x| ^ p.toReal ≤
          ∑ i, (a i + δ) ^ (1 / p.toReal) := by
  let A : Set (Fin m → ℝ) := (fun x : X ↦ fun i ↦ |ψ i x| ^ p.toReal) ''
    Metric.closedBall 0 1
  let K := closure (convexHull ℝ A)
  let b : Fin m → ℝ := fun i ↦ ‖ψ i‖ ^ p.toReal
  have hA : A ⊆ Icc 0 b := by
    rintro _ ⟨x, hx, rfl⟩
    constructor
    · intro i
      exact Real.rpow_nonneg (abs_nonneg _) _
    · intro i
      apply Real.rpow_le_rpow (abs_nonneg _) _ ENNReal.toReal_nonneg
      exact ((ψ i).le_opNorm x).trans
        (mul_le_of_le_one_right (norm_nonneg _) (mem_closedBall_zero_iff.mp hx))
  have hKsub : K ⊆ Icc 0 b := closure_minimal (convexHull_min hA (convex_Icc _ _))
    isClosed_Icc
  have hK : IsCompact K := isCompact_Icc.of_isClosed_subset isClosed_closure hKsub
  have hne : K.Nonempty := by
    have hmem : (fun i ↦ |ψ i (0 : X)| ^ p.toReal) ∈ A :=
      ⟨0, mem_closedBall_zero_iff.mpr (by simp), rfl⟩
    exact ⟨_, subset_closure (subset_convexHull ℝ A hmem)⟩
  have hp0 : 0 < p.toReal := ENNReal.toReal_pos_iff.mpr
    ⟨lt_of_lt_of_le zero_lt_one (Fact.out : 1 ≤ p), hp⟩
  have hg : Continuous (fun a : Fin m → ℝ ↦ ∑ i, (a i) ^ (1 / p.toReal)) :=
    continuous_finsetSum _ (fun i _ ↦ (continuous_apply i).rpow_const
      (fun _ ↦ Or.inr (by positivity)))
  have hbound : ∀ a ∈ K, ∑ i, (a i) ^ (1 / p.toReal) ≤ ‖∑ i, ψ i‖ * C := by
    apply closure_minimal
    · exact fun a ha ↦ positive_dual_convexHull_pSum_le p hp hC ψ hψ ha
    · exact isClosed_le hg continuous_const
  obtain ⟨a, ha, hw⟩ := exists_positive_diagonal_weights (one_div_pos.mpr hp0) hδ
    K hK hne (convex_convexHull ℝ A).closure (fun a ha i ↦ (hKsub ha).1 i)
  refine ⟨a, (hKsub ha).1, hbound a ha, ?_⟩
  intro x hx
  have hxK : (fun i ↦ |ψ i x| ^ p.toReal) ∈ K :=
    subset_closure (subset_convexHull ℝ A ⟨x, mem_closedBall_zero_iff.mpr hx, rfl⟩)
  apply (hw _ hxK).trans
  apply Finset.sum_le_sum
  intro i _
  have hai : 0 < a i + δ := add_pos_of_nonneg_of_pos ((hKsub ha).1 i) hδ
  calc
    (a i + δ) ^ (1 / p.toReal - 1) * a i ≤
        (a i + δ) ^ (1 / p.toReal - 1) * (a i + δ) :=
      mul_le_mul_of_nonneg_left (le_add_of_nonneg_right hδ.le) (Real.rpow_nonneg hai.le _)
    _ = (a i + δ) ^ (1 / p.toReal) := by
      rw [Real.rpow_sub_one hai.ne', div_mul_cancel₀ _ hai.ne']

/-- If a finite dual family has weak p-norm at most `D > 0`, its evaluations on `f`
have ℓᵖ norm at most `D * ‖f‖`. This extends the admissible-family bound by scaling. -/
theorem freeNorm_scaled_family_le {n : ℕ}
    (f : FBLp p E) (φ : Fin n → StrongDual ℝ E) {D : ℝ} (hD : 0 < D)
    (hφ : ∀ x : E, ‖x‖ ≤ 1 → ‖WithLp.toLp p (fun i ↦ φ i x)‖ ≤ D) :
    ‖WithLp.toLp p (fun i ↦ f (φ i))‖ ≤ D * ‖f‖ := by
  let θ : Fin n → StrongDual ℝ E := fun i ↦ D⁻¹ • φ i
  have hθ : NormAdmissible p θ := by
    intro x hx
    change ‖WithLp.toLp p (fun i ↦ D⁻¹ * φ i x)‖ ≤ 1
    change ‖D⁻¹ • WithLp.toLp p (fun i ↦ φ i x)‖ ≤ 1
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hD)]
    exact (mul_le_mul_of_nonneg_left (hφ x hx) (inv_nonneg.mpr hD.le)).trans
      (by rw [inv_mul_cancel₀ hD.ne'])
  have h := norm_eval_le p f θ hθ
  have hf : PosHomogeneous (fun η ↦ f η) := f.1.2.1
  have hscale (i : Fin n) : f (φ i) = D * f (θ i) := by
    rw [← hf D hD.le]
    simp [θ, smul_smul, hD.ne']
  simp_rw [hscale]
  change ‖D • WithLp.toLp p (fun i ↦ f (θ i))‖ ≤ D * ‖f‖
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos hD]
  exact mul_le_mul_of_nonneg_left h hD.le

private lemma scalarPSum_weighted_holder (hp : (p < ∞)) {n : ℕ}
    (d u : Fin n → ℝ) (hd : ∀ i, 0 < d i) :
    ∑ i, u i ≤ (∑ i, d i) ^ (1 - 1 / p.toReal) *
      ‖WithLp.toLp p (fun i ↦ d i ^ (1 / p.toReal - 1) * u i)‖ := by
  have hp1 : 1 ≤ p.toReal :=
    (ENNReal.toReal_le_toReal (by simp) (ne_of_lt hp)).mpr (Fact.out : 1 ≤ p)
  have hp0 : 0 < p.toReal := lt_of_lt_of_le zero_lt_one hp1
  have hpow (i : Fin n) :
      d i * (|u i| / d i) ^ p.toReal =
        |d i ^ (1 / p.toReal - 1) * u i| ^ p.toReal := by
    rw [abs_mul, abs_of_pos (Real.rpow_pos_of_pos (hd i) _),
      Real.mul_rpow (Real.rpow_nonneg (hd i).le _) (abs_nonneg _),
      ← Real.rpow_mul (hd i).le, Real.div_rpow (abs_nonneg _) (hd i).le]
    have he : (1 / p.toReal - 1) * p.toReal = 1 - p.toReal := by
      field_simp
    rw [he, Real.rpow_sub (hd i), Real.rpow_one]
    ring
  have h := Real.inner_le_weight_mul_Lp_of_nonneg Finset.univ hp1 d
    (fun i ↦ |u i| / d i) (fun i ↦ (hd i).le)
    (fun i ↦ div_nonneg (abs_nonneg _) (hd i).le)
  have hmul (i : Fin n) : d i * (|u i| / d i) = |u i| := by
    field_simp [(hd i).ne']
  simp_rw [hmul, hpow] at h
  apply (Finset.sum_le_sum (fun i _ ↦ le_abs_self (u i))).trans
  simpa only [PiLp.norm_eq_sum hp0, Real.norm_eq_abs, one_div] using h

private lemma free_positive_dual_sum_le_add (hp : (p < ∞)) {C δ : ℝ}
    (hC : ConvexWith p C (ContinuousLinearMap.id ℝ X)) (hδ : 0 < δ)
    {m : ℕ} (ψ : Fin m → StrongDual ℝ X)
    (hψ : ∀ i, 0 ≤ ψ i) (f : FBLp p X) :
    ∑ i, f (ψ i) ≤ (‖∑ i, ψ i‖ * C + m * δ ^ (1 / p.toReal)) * ‖f‖ := by
  by_cases hm : m = 0
  · subst m
    simp
  haveI : Nonempty (Fin m) := ⟨⟨0, Nat.pos_of_ne_zero hm⟩⟩
  obtain ⟨a, ha, hsum, hdiag⟩ := positive_dual_diagonal_bound p hp hC hδ ψ hψ
  let r := 1 / p.toReal
  let d : Fin m → ℝ := fun i ↦ (a i + δ) ^ r
  let B := ∑ i, d i
  have hp1 : 1 ≤ p.toReal :=
    (ENNReal.toReal_le_toReal (by simp) (ne_of_lt hp)).mpr (Fact.out : 1 ≤ p)
  have hp0 : 0 < p.toReal := lt_of_lt_of_le zero_lt_one hp1
  have hd (i : Fin m) : 0 < d i :=
    Real.rpow_pos_of_pos (add_pos_of_nonneg_of_pos (ha i) hδ) _
  have hB : 0 < B := Finset.sum_pos (fun i _ ↦ hd i) Finset.univ_nonempty
  let φ : Fin m → StrongDual ℝ X := fun i ↦ d i ^ (r - 1) • ψ i
  have hφpow (i : Fin m) (x : X) :
      |φ i x| ^ p.toReal = (a i + δ) ^ (r - 1) * |ψ i x| ^ p.toReal := by
    simp only [φ, smul_apply, smul_eq_mul, abs_mul,
      abs_of_pos (Real.rpow_pos_of_pos (hd i) _)]
    rw [Real.mul_rpow (Real.rpow_nonneg (hd i).le _) (abs_nonneg _),
      ← Real.rpow_mul (hd i).le]
    dsimp [d]
    rw [← Real.rpow_mul (le_of_lt (add_pos_of_nonneg_of_pos (ha i) hδ))]
    congr 2
    dsimp [r]
    field_simp
  have hφ : ∀ x : X, ‖x‖ ≤ 1 → ‖WithLp.toLp p (fun i ↦ φ i x)‖ ≤ B ^ r := by
    intro x hx
    simp only [PiLp.norm_eq_sum hp0, Real.norm_eq_abs]
    simp_rw [hφpow]
    exact Real.rpow_le_rpow
      (Finset.sum_nonneg (fun i _ ↦ mul_nonneg
        (Real.rpow_nonneg (add_nonneg (ha i) hδ.le) _) (Real.rpow_nonneg (abs_nonneg _) _)))
      (hdiag x hx) (by positivity)
  have hfree := freeNorm_scaled_family_le p f φ (Real.rpow_pos_of_pos hB r) hφ
  have hh := scalarPSum_weighted_holder p hp d (fun i ↦ f (ψ i)) hd
  have hf : PosHomogeneous (fun η ↦ f η) := f.1.2.1
  have heval (i : Fin m) : f (φ i) = d i ^ (r - 1) * f (ψ i) :=
    hf _ (Real.rpow_nonneg (hd i).le _) _
  have hmain : ∑ i, f (ψ i) ≤ B * ‖f‖ := by
    change ∑ i, f (ψ i) ≤ B ^ (1 - r) *
      ‖WithLp.toLp p (fun i ↦ d i ^ (r - 1) * f (ψ i))‖ at hh
    simp_rw [← heval] at hh
    calc
      ∑ i, f (ψ i) ≤ B ^ (1 - r) * ‖WithLp.toLp p (fun i ↦ f (φ i))‖ := hh
      _ ≤ B ^ (1 - r) * (B ^ r * ‖f‖) :=
        mul_le_mul_of_nonneg_left hfree (Real.rpow_nonneg hB.le _)
      _ = B * ‖f‖ := by rw [← mul_assoc, ← Real.rpow_add hB, sub_add_cancel, Real.rpow_one]
  have hBbound : B ≤ ‖∑ i, ψ i‖ * C + m * δ ^ r := by
    calc
      B ≤ ∑ i, ((a i) ^ r + δ ^ r) :=
        Finset.sum_le_sum (fun i _ ↦ Real.rpow_add_le_add_rpow (ha i) hδ.le
          (one_div_nonneg.mpr hp0.le) ((div_le_one hp0).mpr hp1))
      _ = (∑ i, (a i) ^ r) + m * δ ^ r := by simp [Finset.sum_add_distrib]
      _ ≤ ‖∑ i, ψ i‖ * C + m * δ ^ r := add_le_add hsum le_rfl
  exact hmain.trans (mul_le_mul_of_nonneg_right hBbound (norm_nonneg _))

private lemma free_positive_dual_sum_le_finite (hp : (p < ∞)) {C : ℝ}
    (hC : ConvexWith p C (ContinuousLinearMap.id ℝ X)) {m : ℕ} (ψ : Fin m → StrongDual ℝ X)
    (hψ : ∀ i, 0 ≤ ψ i) (f : FBLp p X) :
    ∑ i, f (ψ i) ≤ ‖∑ i, ψ i‖ * C * ‖f‖ := by
  have hp0 : 0 < p.toReal := ENNReal.toReal_pos_iff.mpr
    ⟨lt_of_lt_of_le zero_lt_one (Fact.out : 1 ≤ p), hp⟩
  have hlim : Tendsto (fun δ : ℝ ↦
      (‖∑ i, ψ i‖ * C + m * δ ^ (1 / p.toReal)) * ‖f‖)
      (𝓝[>] 0) (𝓝 (‖∑ i, ψ i‖ * C * ‖f‖)) := by
    have hr : 0 ≤ 1 / p.toReal := one_div_nonneg.mpr hp0.le
    have hcont : Continuous (fun δ : ℝ ↦
        (‖∑ i, ψ i‖ * C + m * δ ^ (1 / p.toReal)) * ‖f‖) := by
      fun_prop
    simpa only [Real.zero_rpow (ne_of_gt (one_div_pos.mpr hp0)), mul_zero, add_zero] using
      (hcont.continuousAt (x := 0)).tendsto.mono_left
        (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
  apply ge_of_tendsto hlim
  filter_upwards [self_mem_nhdsWithin] with δ hδ
  exact free_positive_dual_sum_le_add p hp hC hδ ψ hψ f

private lemma positive_dual_norm_sum_le_add {C : ℝ}
    (hC : ConvexWith ∞ C (ContinuousLinearMap.id ℝ X))
    {m : ℕ} (ψ : Fin m → StrongDual ℝ X) (hψ : ∀ i, 0 ≤ ψ i)
    (ε : ℝ) (hε : 0 < ε) : ∑ i, ‖ψ i‖ ≤ ‖∑ i, ψ i‖ * C + m * ε := by
  have hex (i : Fin m) : ∃ x : X, ‖x‖ ≤ 1 ∧ ‖ψ i‖ - ε ≤ ψ i |x| := by
    obtain ⟨x, hx, hval⟩ := (ψ i).exists_lt_apply_of_lt_opNorm (sub_lt_self _ hε)
    exact ⟨x, hx.le, hval.le.trans (StrongDual.abs_apply_le_apply_abs (hψ i) x)⟩
  choose x hx hval using hex
  have hscalar : ‖WithLp.toLp ∞ (fun i ↦ ‖x i‖)‖ ≤ 1 := by
    simpa only [PiLp.norm_toLp] using
      (pi_norm_le_iff_of_nonneg (x := fun i ↦ ‖x i‖) zero_le_one).2
        (fun i ↦ by simpa only [norm_norm] using hx i)
  have hz : ‖latticePSum ∞ x‖ ≤ C :=
    (hC.2 m x).trans (mul_le_of_le_one_right hC.1 hscalar)
  have hupper : ∑ i, ψ i |x i| ≤ ‖∑ i, ψ i‖ * C := by
    calc
      ∑ i, ψ i |x i| ≤ ∑ i, ψ i (latticePSum ∞ x) :=
        Finset.sum_le_sum (fun i _ ↦ StrongDual.apply_le_apply_of_nonneg (hψ i)
          (abs_le_latticePSum ∞ x i))
      _ = (∑ i, ψ i) (latticePSum ∞ x) := by simp
      _ ≤ ‖∑ i, ψ i‖ * ‖latticePSum ∞ x‖ :=
        (le_abs_self _).trans ((∑ i, ψ i).le_opNorm _)
      _ ≤ ‖∑ i, ψ i‖ * C := mul_le_mul_of_nonneg_left hz (norm_nonneg _)
  have hlower := Finset.sum_le_sum (s := Finset.univ) (fun i _ ↦ hval i)
  simp only [Finset.sum_sub_distrib, Finset.sum_const, Finset.card_fin, nsmul_eq_mul] at hlower
  linarith

/-- If `X` is infinity-convex with constant `C`, a finite family of positive functionals
satisfies `∑ i, ‖ψ i‖ ≤ C * ‖∑ i, ψ i‖`. -/
theorem positive_dual_norm_sum_le_infinity {C : ℝ}
    (hC : ConvexWith ∞ C (ContinuousLinearMap.id ℝ X))
    {m : ℕ} (ψ : Fin m → StrongDual ℝ X) (hψ : ∀ i, 0 ≤ ψ i) :
    ∑ i, ‖ψ i‖ ≤ ‖∑ i, ψ i‖ * C := by
  have hlim : Tendsto (fun ε : ℝ ↦ ‖∑ i, ψ i‖ * C + m * ε)
      (𝓝[>] 0) (𝓝 (‖∑ i, ψ i‖ * C)) := by
    have hc : Continuous (fun ε : ℝ ↦ ‖∑ i, ψ i‖ * C + m * ε) := by fun_prop
    simpa only [mul_zero, add_zero] using
      (hc.continuousAt (x := 0)).tendsto.mono_left
        (nhdsWithin_le_nhds (s := Ioi (0 : ℝ)))
  apply ge_of_tendsto hlim
  filter_upwards [self_mem_nhdsWithin] with ε hε
  exact positive_dual_norm_sum_le_add hC ψ hψ ε hε

/-- For a p-convex lattice `X` with constant `C`, a finite positive dual family satisfies
`∑ i, f (ψ i) ≤ ‖∑ i, ψ i‖ * C * ‖f‖` for `f : FBLp p X`. -/
theorem free_positive_dual_sum_le {C : ℝ} (hC : ConvexWith p C (ContinuousLinearMap.id ℝ X))
    {m : ℕ} (ψ : Fin m → StrongDual ℝ X) (hψ : ∀ i, 0 ≤ ψ i) (f : FBLp p X) :
    ∑ i, f (ψ i) ≤ ‖∑ i, ψ i‖ * C * ‖f‖ := by
  by_cases hp : (p < ∞)
  · exact free_positive_dual_sum_le_finite p hp hC ψ hψ f
  have hpinf : p = ∞ := not_lt_top_iff.mp hp
  subst p
  calc
    ∑ i, f (ψ i) ≤ ∑ i, ‖ψ i‖ * ‖f‖ := Finset.sum_le_sum (fun i _ ↦
      (le_abs_self _).trans (functionSpace_apply_abs_le ∞ f.1 (ψ i)))
    _ = (∑ i, ‖ψ i‖) * ‖f‖ := (Finset.sum_mul ..).symm
    _ ≤ ‖∑ i, ψ i‖ * C * ‖f‖ := mul_le_mul_of_nonneg_right
      (positive_dual_norm_sum_le_infinity hC ψ hψ) (norm_nonneg _)

private lemma free_positive_dual_finset_sum_le {C : ℝ}
    (hC : ConvexWith p C (ContinuousLinearMap.id ℝ X))
    {ι : Type*} (s : Finset ι) (ψ : ι → StrongDual ℝ X)
    (hψ : ∀ i ∈ s, 0 ≤ ψ i) (f : FBLp p X) :
    ∑ i ∈ s, f (ψ i) ≤ ‖∑ i ∈ s, ψ i‖ * C * ‖f‖ := by
  let e := Fintype.equivFin s
  have h := free_positive_dual_sum_le p hC
    (fun i ↦ ψ (e.symm i).1) (fun i ↦ hψ _ (e.symm i).2) f
  rw [e.symm.sum_comp (fun i : s ↦ f (ψ i.1)),
    e.symm.sum_comp (fun i : s ↦ ψ i.1), Finset.univ_eq_attach,
    Finset.sum_attach s (fun i ↦ f (ψ i)), Finset.sum_attach s ψ] at h
  exact h

private lemma positive_dual_linearCombination_le_eval {n : ℕ} (x : Fin n → X)
    (e : LLexpr n) (ψ : StrongDual ℝ X) (hψ : 0 ≤ ψ) (c : Fin n → ℝ)
    (hc : c ∈ (LLexpr.normalize e).pos.coeffs) :
    ψ (Fintype.linearCombination ℝ x c) ≤
      LLexpr.eval (fun i ↦ ψ (x i)) e + ψ ((LLexpr.normalize e).neg.eval x) := by
  have hlin (d : Fin n → ℝ) : ψ (Fintype.linearCombination ℝ x d) =
      Fintype.linearCombination ℝ (fun i ↦ ψ (x i)) d := by
    simp [Fintype.linearCombination_apply, map_sum, map_smul]
  have hA : ψ (Fintype.linearCombination ℝ x c) ≤
      (LLexpr.normalize e).pos.eval (fun i ↦ ψ (x i)) := by
    rw [hlin]
    exact Finset.le_sup' (f := Fintype.linearCombination ℝ (fun i ↦ ψ (x i))) hc
  have hB : (LLexpr.normalize e).neg.eval (fun i ↦ ψ (x i)) ≤
      ψ ((LLexpr.normalize e).neg.eval x) := by
    apply Finset.sup'_le
    intro d hd
    rw [← hlin]
    exact StrongDual.apply_le_apply_of_nonneg hψ
      (Finset.le_sup' (f := Fintype.linearCombination ℝ x) hd)
  rw [← LLexpr.normalize_eval, LLexpr.NormalForm.eval]
  linarith

private lemma positive_dual_fvl_lift_le {C : ℝ} (hC : ConvexWith p C (ContinuousLinearMap.id ℝ X))
    (S : E →L[ℝ] X) (v : FVLv E) (ψ : StrongDual ℝ X) (hψ : 0 ≤ ψ) :
    ψ (FVLv.lift S.toLinearMap v) ≤ ‖ψ‖ * C * ‖induced p S (ofFVLv p v)‖ := by
  obtain ⟨n, x, e, rfl⟩ := FVLv.exists_eval_of_eq v
  let y : Fin n → X := fun i ↦ S (x i)
  let N := LLexpr.normalize e
  let f : FBLp p X := induced p S (ofFVLv p (LLexpr.eval (fun i ↦ FVLv.of (x i)) e))
  have hf (θ : StrongDual ℝ X) : f θ = LLexpr.eval (fun i ↦ θ (y i)) e := by
    change ofFVLv p (LLexpr.eval (fun i ↦ FVLv.of (x i)) e) (θ.comp S) = _
    exact ofFVLv_expr_apply p x e (θ.comp S)
  have hlift : FVLv.lift S.toLinearMap (LLexpr.eval (fun i ↦ FVLv.of (x i)) e) =
      LLexpr.eval y e := by
    simpa [FVLv.lift_of, y] using
      LLexpr.map_eval (FVLv.lift S.toLinearMap) (fun i ↦ FVLv.of (x i)) e
  rw [hlift, ← LLexpr.normalize_eval, LLexpr.NormalForm.eval, map_sub]
  change ψ (N.pos.eval y) - ψ (N.neg.eval y) ≤ ‖ψ‖ * C * ‖f‖
  suffices hb : ψ (N.pos.eval y) ≤ ‖ψ‖ * C * ‖f‖ + ψ (N.neg.eval y) by linarith
  have hψOD : (0 : OrderDualSpace X) ≤ StrongDual.toOrderDualSpace ψ := by
    exact hψ
  apply (OrderBoundedHom.isLUB_apply_finset_sup N.pos.nonempty hψOD
    (Fintype.linearCombination ℝ y)).2
  rintro _ ⟨θ, hθpos, hθsum, rfl⟩
  let χ : (Fin n → ℝ) → StrongDual ℝ X := fun i ↦ StrongDual.ofOrderDualSpace (θ i)
  have hχpos : ∀ i ∈ N.pos.coeffs, 0 ≤ χ i := by
    intro i hi
    exact hθpos i hi
  have hχsum : ∑ i ∈ N.pos.coeffs, χ i = ψ := by
    change ∑ i ∈ N.pos.coeffs, StrongDual.equivOrderDualSpace.symm (θ i) = ψ
    rw [← map_sum, hθsum]
    exact StrongDual.equivOrderDualSpace.symm_apply_apply ψ
  have hbound := free_positive_dual_finset_sum_le p hC N.pos.coeffs χ hχpos f
  rw [hχsum] at hbound
  calc
    ∑ i ∈ N.pos.coeffs, θ i (Fintype.linearCombination ℝ y i) =
        ∑ i ∈ N.pos.coeffs, χ i (Fintype.linearCombination ℝ y i) := rfl
    _ ≤ ∑ i ∈ N.pos.coeffs, (f (χ i) + χ i (N.neg.eval y)) := by
      apply Finset.sum_le_sum
      intro i hi
      rw [hf]
      exact positive_dual_linearCombination_le_eval y e (χ i) (hχpos i hi) i hi
    _ = (∑ i ∈ N.pos.coeffs, f (χ i)) + ψ (N.neg.eval y) := by
      rw [Finset.sum_add_distrib, ← sum_apply, hχsum]
    _ ≤ ‖ψ‖ * C * ‖f‖ + ψ (N.neg.eval y) := add_le_add hbound le_rfl

/-- If `X` is p-convex with constant `C`, the algebraic lattice extension of `S : E →L[ℝ] X`
is bounded by `C * ‖S‖` for the free p-norm on `FVLv E`.
This is the norm estimate used to extend the algebraic map to `FBLp p E`. -/
theorem fvl_lift_pConvex_norm_le {C : ℝ} (hC : ConvexWith p C (ContinuousLinearMap.id ℝ X))
    (S : E →L[ℝ] X) (v : FVLv E) :
    ‖FVLv.lift S.toLinearMap v‖ ≤ (C * ‖S‖) * ‖ofFVLv p v‖ := by
  obtain ⟨ψ, hψ, hψnorm, hψval⟩ := StrongDual.exists_positive_dual_norming
    (x := |FVLv.lift S.toLinearMap v|) (abs_nonneg _)
  have h := positive_dual_fvl_lift_le p hC S |v| ψ hψ
  rw [VecLatHom.map_abs, hψval, norm_abs_eq_norm] at h
  have hop : ‖induced p S (ofFVLv p |v|)‖ ≤ ‖S‖ * ‖ofFVLv p v‖ := by
    have ho := (induced p S).le_opNorm (ofFVLv p |v|)
    rw [(induced_norm_generators p S).1, VecLatHom.map_abs, norm_abs_eq_norm] at ho
    simpa only [VecLatHom.map_abs] using ho
  calc
    ‖FVLv.lift S.toLinearMap v‖ ≤ ‖ψ‖ * C * ‖induced p S (ofFVLv p |v|)‖ := h
    _ ≤ 1 * C * ‖induced p S (ofFVLv p |v|)‖ :=
      mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hψnorm hC.1) (norm_nonneg _)
    _ ≤ C * (‖S‖ * ‖ofFVLv p v‖) := by
      simpa only [one_mul] using mul_le_mul_of_nonneg_left hop hC.1
    _ = (C * ‖S‖) * ‖ofFVLv p v‖ := by ring

/-- Two vectorlattice homomorphisms from `FBLp p E`
are equal if they agree on every generator `of p x`.
This gives uniqueness of continuous lattice extensions from the free lattice. -/
theorem continuousLinearMap_ext {X : Type w}
    [NormedAddCommGroup X] [Lattice X] [IsOrderedAddMonoid X] [BanachLattice X]
    (M N : FBLp p E →L[ℝ] X) (hMlat : IsVecLatHom M) (hNlat : IsVecLatHom N)
    (h : ∀ x : E, M (of p x) = N (of p x)) : M = N := by
  have hMN : (VecLatHom.ofIsVecLatHom M hMlat).comp (ofFVLv p) =
      (VecLatHom.ofIsVecLatHom N hNlat).comp (ofFVLv p) :=
    FVLv.hom_ext (fun x ↦ show M (ofFVLv p (FVLv.of x)) = N (ofFVLv p (FVLv.of x))
      from by simpa only [ofFVLv_of] using h x)
  have hfun : (M : FBLp p E → X) = (N : FBLp p E → X) :=
    (denseRange_ofFVLv p).equalizer M.continuous
      N.continuous (by
        funext v
        exact DFunLike.congr_fun hMN v)
  exact DFunLike.coe_injective hfun

private def liftAux (S : E →L[ℝ] X) : FBLp p E →L[ℝ] X :=
  (FVLv.lift S.toLinearMap).toLinearMap.extendOfNorm (ofFVLv p).toLinearMap

private lemma liftAux_ofFVLv (S : E →L[ℝ] X) {C : ℝ}
    (hb : ∀ v : FVLv E, ‖FVLv.lift S.toLinearMap v‖ ≤ C * ‖ofFVLv p v‖)
    (v : FVLv E) : liftAux p S (ofFVLv p v) = FVLv.lift S.toLinearMap v :=
  LinearMap.extendOfNorm_eq (f := (FVLv.lift S.toLinearMap).toLinearMap)
    (e := (ofFVLv p).toLinearMap) (denseRange_ofFVLv p) ⟨C, hb⟩ v

private lemma liftAux_map_sup (S : E →L[ℝ] X) {C : ℝ}
    (hb : ∀ v : FVLv E, ‖FVLv.lift S.toLinearMap v‖ ≤ C * ‖ofFVLv p v‖)
    (f g : FBLp p E) :
    liftAux p S (f ⊔ g) = liftAux p S f ⊔ liftAux p S g := by
  have h := ((denseRange_ofFVLv p (E := E)).prodMap
    (denseRange_ofFVLv p (E := E))).equalizer
    ((liftAux p S).continuous.comp (continuous_fst.sup continuous_snd))
    (((liftAux p S).continuous.comp continuous_fst).sup
      ((liftAux p S).continuous.comp continuous_snd)) (by
        funext z
        change liftAux p S (ofFVLv p z.1 ⊔ ofFVLv p z.2) =
          liftAux p S (ofFVLv p z.1) ⊔ liftAux p S (ofFVLv p z.2)
        rw [← show ofFVLv p (z.1 ⊔ z.2) = ofFVLv p z.1 ⊔ ofFVLv p z.2 from
          (ofFVLv p).map_sup' z.1 z.2, liftAux_ofFVLv p S hb,
          liftAux_ofFVLv p S hb, liftAux_ofFVLv p S hb]
        exact (FVLv.lift S.toLinearMap).map_sup' z.1 z.2)
  exact congrFun h (f, g)

private lemma liftAux_isVecLatHom (S : E →L[ℝ] X) {C : ℝ}
    (hb : ∀ v : FVLv E, ‖FVLv.lift S.toLinearMap v‖ ≤ C * ‖ofFVLv p v‖) :
    IsVecLatHom (liftAux p S) where
  map_add := (liftAux p S).map_add
  map_smul := (liftAux p S).map_smul
  map_sup' := liftAux_map_sup p S hb
  map_inf' f g := by
    simpa only [← map_neg, neg_sup, neg_neg] using
      congrArg (fun z : X ↦ -z) (liftAux_map_sup p S hb (-f) (-g))

/-- If the vector lattice extension of `S` is bounded by `C ≥ 0` for the free p-norm,
it extends uniquely to a continuous lattice homomorphism on `FBLp p E` of norm at most `C`.
The extension sends each canonical generator `of p x` to `S x`. -/
theorem universal_property_of_fvl_bound (S : E →L[ℝ] X) (C : ℝ) (hC : 0 ≤ C)
    (hb : ∀ v : FVLv E, ‖FVLv.lift S.toLinearMap v‖ ≤ C * ‖ofFVLv p v‖) :
    ∃ L : FBLp p E →L[ℝ] X, IsVecLatHom L ∧ (∀ x, L (of p x) = S x) ∧
      ‖L‖ ≤ C ∧ ∀ M : FBLp p E →L[ℝ] X,
        IsVecLatHom M → (∀ x, M (of p x) = S x) → M = L := by
  have hgen (x : E) : liftAux p S (of p x) = S x := by
    rw [← ofFVLv_of p x, liftAux_ofFVLv p S hb, FVLv.lift_of]
    rfl
  refine ⟨liftAux p S, liftAux_isVecLatHom p S hb, hgen, ?_, ?_⟩
  · exact LinearMap.opNorm_extendOfNorm_le
      (f := (FVLv.lift S.toLinearMap).toLinearMap) (e := (ofFVLv p).toLinearMap)
      (denseRange_ofFVLv p) hC hb
  · intro M hM hMS
    exact continuousLinearMap_ext p M (liftAux p S) hM (liftAux_isVecLatHom p S hb)
      (fun x ↦ (hMS x).trans (hgen x).symm)

/-- Every bounded linear map `S : E →L[ℝ] X` into a p-convex Banach lattice extends uniquely
to a continuous lattice homomorphism `L : FBLp p E →L[ℝ] X` with `L (of p x) = S x`.
Its norm is at most `convexityConstant p (ContinuousLinearMap.id ℝ X) * ‖S‖`. -/
theorem universal_property (hX : IsPConvex p X) (S : E →L[ℝ] X) :
    ∃ L : FBLp p E →L[ℝ] X, IsVecLatHom L ∧ (∀ x, L (of p x) = S x) ∧
      ‖L‖ ≤ convexityConstant p (ContinuousLinearMap.id ℝ X) * ‖S‖ ∧
      ∀ M : FBLp p E →L[ℝ] X,
        IsVecLatHom M → (∀ x, M (of p x) = S x) → M = L :=
  universal_property_of_fvl_bound p S
    (convexityConstant p (ContinuousLinearMap.id ℝ X) * ‖S‖)
    (mul_nonneg (IsPConvexOp.convexityConstant_nonneg hX) (norm_nonneg S))
    (fvl_lift_pConvex_norm_le p (IsPConvexOp.convexityConstant_spec hX) S)

/-- Every element of `FBLp p E` restricted to each closed ball of the dual `E^*` is
weak-star continuous. -/
theorem weakStar_continuous_bounded (f : FBLp p E) (R : ℝ) :
    ContinuousOn (fun φ : WeakDual ℝ E ↦ f (WeakDual.toStrongDual φ))
      {φ | ‖WeakDual.toStrongDual φ‖ ≤ R} := by
  apply continuousOn_of_uniform_approx_of_continuousOn
  intro U hU
  obtain ⟨ε, hε, hUε⟩ := Metric.mem_uniformity_dist.mp hU
  let B : ℝ := max R 0 + 1
  have hB : 0 < B := by dsimp [B]; positivity
  obtain ⟨v, hv⟩ := (denseRange_ofFVLv p).exists_dist_lt f
    (show 0 < ε / B by positivity)
  let g : FBLp p E := ofFVLv p v
  have hnorm : ‖f - g‖ < ε / B := by
    simpa only [g, dist_eq_norm] using hv
  refine ⟨(fun φ : WeakDual ℝ E ↦ g (WeakDual.toStrongDual φ)), ?_, ?_⟩
  · exact (ofFVLv_weakstar_continuous p v).continuousOn
  · intro φ hφ
    apply hUε
    rw [Real.dist_eq]
    have hbound : ‖WeakDual.toStrongDual φ‖ ≤ B := by
      have hRB : R ≤ B := by dsimp [B]; linarith [le_max_left R 0]
      exact hφ.trans hRB
    have hsmall : B * ‖f - g‖ < ε := by
      have hmul := mul_lt_mul_of_pos_left hnorm hB
      have hcalc : B * (ε / B) = ε := by field_simp
      rw [hcalc] at hmul
      exact hmul
    exact (free_apply_sub_le p f g (WeakDual.toStrongDual φ)).trans_lt
      ((mul_le_mul_of_nonneg_right hbound (norm_nonneg (f - g))).trans_lt hsmall)

/-- For Banach space `E`, every element of `FBLp p E` is continuous on the dual `E^*` equipped
with the bounded-weak-star topology. -/
theorem weakStar_continuous_compactlyGenerated [CompleteSpace E] (f : FBLp p E) :
    Continuous[TopologicalSpace.compactlyGenerated (WeakDual ℝ E), inferInstance]
      (fun φ : WeakDual ℝ E ↦ f (WeakDual.toStrongDual φ)) := by
  apply continuous_from_compactlyGenerated
  intro K g
  have hb : Bornology.IsBounded (Set.range (g : K → WeakDual ℝ E)) :=
    (WeakDual.isBounded_iff_isVonNBounded).mpr
      ((isCompact_range g.continuous).isVonNBounded ℝ)
  obtain ⟨R, hR⟩ := isBounded_iff_forall_norm_le.mp hb
  exact (weakStar_continuous_bounded p f R).comp_continuous g.continuous
    (fun k ↦ hR (g k) ⟨k, rfl⟩)

/-- The norm ball of radius `R` centered at zero, viewed as a subset of `WeakDual ℝ E`.
Membership uses the dual norm, while topological statements use the weak-star topology. -/
def weakDualNormBall (R : ℝ) : Set (WeakDual ℝ E) :=
  {φ | ‖WeakDual.toStrongDual φ‖ ≤ R}

private lemma isClosed_inter_dualNormBall (s : Set (WeakDual ℝ E))
    (h : @IsClosed (WeakDual ℝ E)
      (TopologicalSpace.compactlyGenerated.{u} (WeakDual ℝ E)) s) (R : ℝ) :
    IsClosed (s ∩ weakDualNormBall (E := E) R) := by
  have hk : ∀ (K : CompHaus.{u}) (g : C(K, WeakDual ℝ E)),
      IsClosed (g ⁻¹' s) := by
    rw [TopologicalSpace.compactlyGenerated, isClosed_coinduced,
      isClosed_sigma_iff] at h
    intro K g
    simpa only [Set.preimage_preimage] using h ⟨K, g⟩
  have hBclosed : IsClosed (weakDualNormBall (E := E) R) := by
    convert WeakDual.isClosed_closedBall (0 : StrongDual ℝ E) R using 1
    ext φ
    simp [weakDualNormBall, Metric.mem_closedBall, dist_zero_right]
  have hBcompact : IsCompact (weakDualNormBall (E := E) R) := by
    convert WeakDual.isCompact_closedBall (0 : StrongDual ℝ E) R using 1
    ext φ
    simp [weakDualNormBall, Metric.mem_closedBall, dist_zero_right]
  letI : CompactSpace (weakDualNormBall (E := E) R) :=
    isCompact_iff_compactSpace.mp hBcompact
  let K : CompHaus.{u} := CompHaus.of (weakDualNormBall (E := E) R)
  let g : C(K, WeakDual ℝ E) := ⟨Subtype.val, continuous_subtype_val⟩
  have hpre : IsClosed (g ⁻¹' s) := hk K g
  have himage : IsClosed
      ((Subtype.val : weakDualNormBall (E := E) R → WeakDual ℝ E) ''
        ((Subtype.val : weakDualNormBall (E := E) R → WeakDual ℝ E) ⁻¹' s)) :=
    hBclosed.isClosedMap_subtype_val _ hpre
  convert himage using 1
  ext φ
  simp [weakDualNormBall, and_comm]

/-- For Banach space `E`, closedness in the bounded-weak-star topology can be
tested on closed dual norm balls: a set is closed exactly when its intersection with
every such ball is weak-star closed in the dual. -/
theorem weakDual_isClosed_compactlyGenerated_iff [CompleteSpace E]
    (s : Set (WeakDual ℝ E)) :
    @IsClosed (WeakDual ℝ E)
      (TopologicalSpace.compactlyGenerated.{u} (WeakDual ℝ E)) s ↔
      ∀ R : ℝ, IsClosed (s ∩ weakDualNormBall (E := E) R) := by
  constructor
  · exact isClosed_inter_dualNormBall s
  · intro h
    rw [TopologicalSpace.compactlyGenerated, isClosed_coinduced,
      isClosed_sigma_iff]
    intro ⟨K, g⟩
    change IsClosed (g ⁻¹' s)
    have hb : Bornology.IsBounded (Set.range (g : K → WeakDual ℝ E)) :=
      (WeakDual.isBounded_iff_isVonNBounded).mpr
        ((isCompact_range g.continuous).isVonNBounded ℝ)
    obtain ⟨R, hR⟩ := isBounded_iff_forall_norm_le.mp hb
    have hs : g ⁻¹' s = g ⁻¹' (s ∩ weakDualNormBall (E := E) R) := by
      ext k
      have hk := hR (g k) ⟨k, rfl⟩
      change ‖WeakDual.toStrongDual (g k)‖ ≤ R at hk
      simp [weakDualNormBall, hk]
    rw [hs]
    exact (h R).preimage g.continuous

/-- Every element of `FBLp p E`, viewed as a function on the dual `E^*`, is continuous
for the dual norm topology. This holds for every exponent and without completeness of `E`. -/
theorem free_function_norm_continuous (f : FBLp p E) :
    Continuous (f : StrongDual ℝ E → ℝ) := by
  refine continuous_iff_continuousAt.mpr fun φ ↦ ?_
  have h : ContinuousOn (f : StrongDual ℝ E → ℝ) (Metric.closedBall 0 (‖φ‖ + 1)) :=
    (weakStar_continuous_bounded p f (‖φ‖ + 1)).comp
      NormedSpace.Dual.toWeakDual_continuous.continuousOn
      (fun ψ hψ ↦ mem_closedBall_zero_iff.mp hψ)
  exact h.continuousAt (Metric.closedBall_mem_nhds_of_mem (by
    simpa only [Metric.mem_ball, dist_zero_right] using lt_add_one ‖φ‖))

/-- Every bounded linear map into a Banach lattice extends uniquely from `FBLp 1 E`
to a continuous lattice homomorphism that agrees on generators and has norm at most `‖S‖`.
This is the ordinary free Banach lattice universal property. -/
theorem universal_property_one (S : E →L[ℝ] X) :
    ∃ L : FBLp 1 E →L[ℝ] X, IsVecLatHom L ∧
      (∀ x, L (of 1 x) = S x) ∧ ‖L‖ ≤ ‖S‖ ∧
      ∀ M : FBLp 1 E →L[ℝ] X, IsVecLatHom M →
        (∀ x, M (of 1 x) = S x) → M = L :=
  universal_property_of_fvl_bound 1 S ‖S‖ (norm_nonneg S)
    (fun v ↦ by simpa only [one_mul] using fvl_lift_pConvex_norm_le 1 convexWith_one_id S v)

private lemma latticePSum_scalar_eval (T : VecLatHom X ℝ)
    {n : ℕ} (x : Fin n → X) :
    T (latticePSum p x) = ‖WithLp.toLp p (fun i ↦ T (x i))‖ := by
  rw [latticePSum_map]
  letI := isUniformlyCompleteVectorLattice_of_banachLattice ℝ
  exact realPosHomFunctionalCalculus _ (pSumFunction p _)

private def piLpEvalVec (n : ℕ) (i : Fin n) :
    VecLatHom (PiLp p (fun _ : Fin n ↦ ℝ)) ℝ where
  toFun z := z i
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

private lemma convexWith_piLp (n : ℕ) :
    ConvexWith p 1 (ContinuousLinearMap.id ℝ (PiLp p (fun _ : Fin n ↦ ℝ))) := by
  refine ⟨zero_le_one, fun m f ↦ ?_⟩
  have h : latticePSum p f = WithLp.toLp p
      (fun j ↦ ‖WithLp.toLp p (fun i ↦ f i j)‖) :=
    PiLp.ext fun j ↦ latticePSum_scalar_eval p (piLpEvalVec p n j) f
  change ‖latticePSum p f‖ ≤ 1 * ‖WithLp.toLp p (fun i ↦ ‖f i‖)‖
  rw [h, one_mul, norm_swap]

/-- For an operator into finite-dimensional scalar ℓᵖ, its algebraic lattice lift is
bounded by `‖S‖` for the free p-norm, using the target's constant-one p-convexity. -/
theorem fvl_lift_piLp_norm_le (n : ℕ)
    (S : E →L[ℝ] PiLp p (fun _ : Fin n ↦ ℝ)) (v : FVLv E) :
    ‖FVLv.lift S.toLinearMap v‖ ≤ ‖S‖ * ‖ofFVLv p v‖ := by
  simpa only [one_mul] using fvl_lift_pConvex_norm_le p (convexWith_piLp p n) S v

/-- Every bounded linear map from `E` into finite-dimensional scalar ℓᵖ extends uniquely
to a continuous lattice homomorphism from `FBLp p E` with norm at most `‖S‖`.
The extension agrees with `S` on the canonical generators. -/
theorem universal_property_piLp (n : ℕ)
    (S : E →L[ℝ] PiLp p (fun _ : Fin n ↦ ℝ)) :
    ∃ L : FBLp p E →L[ℝ] PiLp p (fun _ : Fin n ↦ ℝ), IsVecLatHom L ∧
      (∀ x, L (of p x) = S x) ∧ ‖L‖ ≤ ‖S‖ ∧
      ∀ M : FBLp p E →L[ℝ] PiLp p (fun _ : Fin n ↦ ℝ), IsVecLatHom M →
        (∀ x, M (of p x) = S x) → M = L :=
  universal_property_of_fvl_bound p S ‖S‖ (norm_nonneg S) (fvl_lift_piLp_norm_le p n S)

private def continuousMapEval {K : Type*} [TopologicalSpace K] (k : K) :
    VecLatHom C(K, ℝ) ℝ where
  toFun f := f k
  map_add' := by intros; rfl
  map_smul' := by intros; rfl
  map_sup' := by intros; rfl
  map_inf' := by intros; rfl

private lemma convexWith_continuousMap {K : Type*}
    [TopologicalSpace K] [CompactSpace K] :
    ConvexWith p 1 (ContinuousLinearMap.id ℝ C(K, ℝ)) := by
  refine ⟨zero_le_one, fun n f ↦ ?_⟩
  change ‖latticePSum p f‖ ≤ 1 * ‖WithLp.toLp p (fun i ↦ ‖f i‖)‖
  rw [one_mul]
  apply (ContinuousMap.norm_le _ (norm_nonneg _)).mpr
  intro k
  change ‖continuousMapEval k (latticePSum p f)‖ ≤ _
  rw [latticePSum_scalar_eval, norm_norm]
  apply norm_le_norm_of_abs_le_abs
  intro i
  change |f i k| ≤ |‖f i‖|
  simpa only [Real.norm_eq_abs, abs_norm] using ContinuousMap.norm_coe_le_norm (f i) k

/-- For an operator into `C(K, ℝ)` with `K` compact, its algebraic lattice lift is
bounded by `‖S‖` for the free p-norm. This estimate holds at every exponent. -/
theorem fvl_lift_continuousMap_norm_le {K : Type*}
    [TopologicalSpace K] [CompactSpace K] (S : E →L[ℝ] C(K, ℝ)) (v : FVLv E) :
    ‖FVLv.lift S.toLinearMap v‖ ≤ ‖S‖ * ‖ofFVLv p v‖ := by
  simpa only [one_mul] using fvl_lift_pConvex_norm_le p (convexWith_continuousMap p) S v

/-- Every bounded linear map into `C(K, ℝ)` with `K` compact extends uniquely from
`FBLp p E` to a continuous lattice homomorphism agreeing on generators and of norm at most
`‖S‖`. The supremum norm on the target makes this valid for every exponent. -/
theorem universal_property_continuousMap {K : Type*}
    [TopologicalSpace K] [CompactSpace K] (S : E →L[ℝ] C(K, ℝ)) :
    ∃ L : FBLp p E →L[ℝ] C(K, ℝ), IsVecLatHom L ∧
      (∀ x, L (of p x) = S x) ∧ ‖L‖ ≤ ‖S‖ ∧
      ∀ M : FBLp p E →L[ℝ] C(K, ℝ), IsVecLatHom M →
        (∀ x, M (of p x) = S x) → M = L :=
  universal_property_of_fvl_bound p S ‖S‖ (norm_nonneg S)
    (fvl_lift_continuousMap_norm_le p S)

private lemma convexWith_amSpaceWithUnit {Y : Type*}
    [NormedAddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y]
    [AMSpaceWithUnit Y] [Nontrivial Y] :
    ConvexWith p 1 (ContinuousLinearMap.id ℝ Y) := by
  let e := AMSpaceWithUnit.kakutaniEquiv Y
  refine ⟨zero_le_one, fun n f ↦ ?_⟩
  have h := (convexWith_continuousMap p (K := AMSpaceWithUnit.LatticeCharacter Y)).2 n
    (fun i ↦ e (f i))
  change ‖latticePSum p (fun i ↦ e (f i))‖ ≤
    1 * ‖WithLp.toLp p (fun i ↦ ‖e (f i)‖)‖ at h
  rw [← show e (latticePSum p f) = latticePSum p (fun i ↦ e (f i)) from
    latticePSum_map p e.toVecLatEquiv.toVecLatHom f] at h
  change ‖e.toLinearIsometryEquiv (latticePSum p f)‖ ≤
    1 * ‖WithLp.toLp p (fun i ↦ ‖e.toLinearIsometryEquiv (f i)‖)‖ at h
  simpa only [e.toLinearIsometryEquiv.norm_map, ContinuousLinearMap.id_apply] using h

/-- Every bounded linear map into a nontrivial AM-space with a unit extends uniquely
from `FBLp p E` to a continuous lattice homomorphism agreeing on generators and of norm
at most `‖S‖`. This holds for every exponent `1 ≤ p ≤ ∞`. -/
theorem universal_property_amSpaceWithUnit {Y : Type*}
    [NormedAddCommGroup Y] [Lattice Y] [IsOrderedAddMonoid Y]
    [AMSpaceWithUnit Y] [Nontrivial Y] (S : E →L[ℝ] Y) :
    ∃ L : FBLp p E →L[ℝ] Y, IsVecLatHom L ∧
      (∀ x, L (of p x) = S x) ∧ ‖L‖ ≤ ‖S‖ ∧
      ∀ M : FBLp p E →L[ℝ] Y, IsVecLatHom M →
        (∀ x, M (of p x) = S x) → M = L :=
  universal_property_of_fvl_bound p S ‖S‖ (norm_nonneg S)
    (fun v ↦ by simpa only [one_mul] using
      fvl_lift_pConvex_norm_le p (convexWith_amSpaceWithUnit p) S v)

end FBLp
