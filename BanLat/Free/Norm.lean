import BanLat.Dual
import BanLat.Free.FVLv
import BanLat.Pi

/-!
# The free p-norm on homogeneous dual functions

For a real normed space `E` and `1 ≤ p ≤ ∞`, `freeNormExt p` defines the free p-convex norm
on functions `f : StrongDual ℝ E → ℝ`. With `φ : StrongDual ℝ E` denoting an element of the dual,
for finite `p`, it tests `f` on finite families `(φ i)` with weak p-norm at most one, taking the
supremum of the ℓᵖ evaluation norms; at `p = ∞`, it takes the supremum of `|f φ|` on
the closed dual unit ball. The positively homogeneous functions with finite extended free norm
form `FunctionSpace p E`, a Banach lattice with pointwise order and the free p-norm.
Evaluation at a vector `x` gives the function `φ ↦ φ x`, whose free p-norm is exactly `‖x‖`.
This provides the ambient Banach lattice in which the free p-convex lattice will be constructed
as the closed vector sublattice generated by these evaluation functions.
-/

open scoped ENNReal Topology
open Filter Set

noncomputable section

universe u v

namespace FBLp

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]
  (p : ℝ≥0∞) [Fact (1 ≤ p)]

/-- A finite family `(φ i)` of elements in the dual space is admissible when its weak p-norm is
at most one. -/
def NormAdmissible {n : ℕ} (φ : Fin n → StrongDual ℝ E) : Prop :=
  ∀ x : E, ‖x‖ ≤ 1 → ‖WithLp.toLp p (fun i ↦ φ i x)‖ ≤ 1

/-- Every functional `φ` in the closed dual unit ball forms an admissible singleton
at every exponent, so singleton tests recover bounds on individual evaluations. -/
theorem normAdmissible_singleton (φ : StrongDual ℝ E) (hφ : ‖φ‖ ≤ 1) :
    NormAdmissible p (fun _ : Fin 1 ↦ φ) := by
  intro x hx
  change ‖WithLp.toLp p (Function.const (Fin 1) (φ x))‖ ≤ 1
  simpa only [PiLp.norm_toLp_const', Fintype.card_fin, Nat.cast_one, NNReal.coe_one,
    Real.one_rpow, one_mul]
    using (φ.le_opNorm x).trans (mul_le_one₀ hφ (norm_nonneg _) hx)

/-- The unit-ball estimate defining admissibility extends to all vectors:
the ℓᵖ norm of `(φ i x)` is at most `‖x‖`. -/
theorem normAdmissible_eval_le_norm {n : ℕ} (φ : Fin n → StrongDual ℝ E)
    (hφ : NormAdmissible p φ) (x : E) :
    ‖WithLp.toLp p (fun i ↦ φ i x)‖ ≤ ‖x‖ := by
  have h := hφ (‖x‖⁻¹ • x)
    (mem_closedBall_zero_iff.mp (inv_norm_smul_mem_unitClosedBall x))
  simp only [map_smul, smul_eq_mul] at h
  change ‖‖x‖⁻¹ • WithLp.toLp p (fun i ↦ φ i x)‖ ≤ 1 at h
  rw [norm_smul, norm_inv, norm_norm] at h
  by_cases hx : x = 0
  · subst x
    simp only [map_zero, norm_zero]
    exact (norm_zero : ‖(0 : PiLp p (fun _ : Fin n ↦ ℝ))‖ = 0).le
  · simpa only [mul_one] using (inv_mul_le_iff₀ (norm_pos_iff.mpr hx)).mp h

/-- The extended free p-norm of `f` is the supremum of its ℓᵖ evaluation norms
over admissible families when `p < ∞`, or of `|f φ|` over `‖φ‖ ≤ 1` at infinity.
It is defined for arbitrary functions on the dual and takes values in `ℝ≥0∞`. -/
def freeNormExt (f : StrongDual ℝ E → ℝ) : ℝ≥0∞ :=
  if p = ∞ then ⨆ (φ : StrongDual ℝ E) (_ : ‖φ‖ ≤ 1), ENNReal.ofReal |f φ|
  else ⨆ (n : ℕ) (φ : Fin n → StrongDual ℝ E) (_ : NormAdmissible p φ),
    ENNReal.ofReal ‖WithLp.toLp p (fun i ↦ f (φ i))‖

/-- The evaluation function `φ ↦ φ x` has extended free p-norm at most `‖x‖`. -/
theorem freeNormExt_eval_le (x : E) :
    freeNormExt p (fun φ : StrongDual ℝ E ↦ φ x) ≤ ENNReal.ofReal ‖x‖ := by
  unfold freeNormExt
  split_ifs with hp
  · refine iSup_le fun φ ↦ iSup_le fun hφ ↦ ENNReal.ofReal_le_ofReal ?_
    exact (φ.le_opNorm x).trans (mul_le_of_le_one_left (norm_nonneg x) hφ)
  · exact iSup_le fun n ↦ iSup_le fun φ ↦ iSup_le fun hφ ↦
      ENNReal.ofReal_le_ofReal (normAdmissible_eval_le_norm p φ hφ x)

/-- The extended free p-norm bounds `|f φ|` whenever `φ` is in the closed dual unit ball. -/
theorem ofReal_abs_le_freeNormExt (f : StrongDual ℝ E → ℝ)
    (φ : StrongDual ℝ E) (hφ : ‖φ‖ ≤ 1) :
    ENNReal.ofReal |f φ| ≤ freeNormExt p f := by
  unfold freeNormExt
  split_ifs with hp
  · exact le_iSup_of_le φ (le_iSup_of_le hφ le_rfl)
  · calc
      ENNReal.ofReal |f φ| =
          ENNReal.ofReal ‖WithLp.toLp p (Function.const (Fin 1) (f φ))‖ := by
        simp [PiLp.norm_toLp_const']
      _ ≤ ⨆ (n : ℕ) (ψ : Fin n → StrongDual ℝ E) (_ : NormAdmissible p ψ),
          ENNReal.ofReal ‖WithLp.toLp p (fun i ↦ f (ψ i))‖ :=
        le_iSup_of_le (1 : ℕ) (le_iSup_of_le (fun _ : Fin 1 ↦ φ)
        (le_iSup_of_le (normAdmissible_singleton p φ hφ) le_rfl))

/-- The evaluation function `φ ↦ φ x` has extended free p-norm exactly `‖x‖`.
This equality supplies the norm identity for the canonical embedding of `E`. -/
theorem freeNormExt_eval_eq (x : E) :
    freeNormExt p (fun φ : StrongDual ℝ E ↦ φ x) = ENNReal.ofReal ‖x‖ := by
  apply le_antisymm (freeNormExt_eval_le p x)
  obtain ⟨φ, hφnorm, hφx⟩ := exists_dual_vector'' ℝ x
  simpa [hφx, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg x)] using
    ofReal_abs_le_freeNormExt p (fun ψ : StrongDual ℝ E ↦ ψ x) φ hφnorm

/-- The zero function has zero extended free norm. -/
@[simp]
theorem freeNormExt_zero : freeNormExt p (fun _ : StrongDual ℝ E ↦ 0) = 0 := by
  simp [freeNormExt, show ∀ n, WithLp.toLp p (fun _ : Fin n ↦ (0 : ℝ)) = 0
    from fun _ ↦ rfl]

/-- Multiplying a function `f` on the dual by a real scalar multiplies its extended free p-norm
by the scalar's absolute value; the identity also allows infinite free norms. -/
theorem freeNormExt_smul (c : ℝ) (f : StrongDual ℝ E → ℝ) :
    freeNormExt p (c • f) = ENNReal.ofReal |c| * freeNormExt p f := by
  have hs (n : ℕ) (φ : Fin n → StrongDual ℝ E) :
      ‖WithLp.toLp p (fun i ↦ c * f (φ i))‖ =
        |c| * ‖WithLp.toLp p (fun i ↦ f (φ i))‖ :=
    norm_smul c (WithLp.toLp p (fun i ↦ f (φ i)))
  simp only [freeNormExt, hs, Pi.smul_apply, smul_eq_mul, abs_mul,
    ENNReal.ofReal_mul (abs_nonneg c)]
  split_ifs <;> simp only [ENNReal.mul_iSup]

/-- The triangle inequality for the free p-norm. -/
theorem freeNormExt_add_le (f g : StrongDual ℝ E → ℝ) :
    freeNormExt p (f + g) ≤ freeNormExt p f + freeNormExt p g := by
  by_cases htop : p = ⊤
  · rw [freeNormExt, if_pos htop]
    refine iSup_le fun φ ↦ iSup_le fun hφ ↦ ?_
    calc
      ENNReal.ofReal |(f + g) φ| ≤ ENNReal.ofReal (|f φ| + |g φ|) := by
        apply ENNReal.ofReal_le_ofReal
        simpa using abs_add_le (f φ) (g φ)
      _ = ENNReal.ofReal |f φ| + ENNReal.ofReal |g φ| := by
        rw [ENNReal.ofReal_add (abs_nonneg _) (abs_nonneg _)]
      _ ≤ freeNormExt p f + freeNormExt p g := by
        apply add_le_add
        all_goals rw [freeNormExt, if_pos htop]
        all_goals exact le_iSup_of_le φ (le_iSup_of_le hφ le_rfl)
  · rw [freeNormExt, if_neg htop]
    refine iSup_le fun n ↦ iSup_le fun φ ↦ iSup_le fun hφ ↦ ?_
    calc
      ENNReal.ofReal ‖WithLp.toLp p (fun i ↦ (f + g) (φ i))‖ ≤
          ENNReal.ofReal (‖WithLp.toLp p (fun i ↦ f (φ i))‖ +
            ‖WithLp.toLp p (fun i ↦ g (φ i))‖) := by
        apply ENNReal.ofReal_le_ofReal
        exact norm_add_le (WithLp.toLp p (fun i ↦ f (φ i)))
            (WithLp.toLp p (fun i ↦ g (φ i)))
      _ = ENNReal.ofReal ‖WithLp.toLp p (fun i ↦ f (φ i))‖ +
          ENNReal.ofReal ‖WithLp.toLp p (fun i ↦ g (φ i))‖ := by
        exact ENNReal.ofReal_add (norm_nonneg (WithLp.toLp p (fun i ↦ f (φ i))))
          (norm_nonneg (WithLp.toLp p (fun i ↦ g (φ i))))
      _ ≤ freeNormExt p f + freeNormExt p g := by
        apply add_le_add
        all_goals rw [freeNormExt, if_neg htop]
        all_goals exact le_iSup_of_le n (le_iSup_of_le φ (le_iSup_of_le hφ le_rfl))

/-- If `|f φ| ≤ |g φ|` at every dual functional `φ`, then the extended free p-norm of
`f` is at most that of `g`. The free p-norm is a lattice norm. -/
theorem freeNormExt_mono_abs (p : ℝ≥0∞) [Fact (1 ≤ p)] {f g : StrongDual ℝ E → ℝ}
    (h : ∀ φ, |f φ| ≤ |g φ|) : freeNormExt p f ≤ freeNormExt p g := by
  by_cases htop : p = ⊤
  · rw [freeNormExt, if_pos htop, freeNormExt, if_pos htop]
    refine iSup_le fun φ ↦ iSup_le fun hφ ↦ ?_
    exact (ENNReal.ofReal_le_ofReal (h φ)).trans
      (le_iSup_of_le φ (le_iSup_of_le hφ le_rfl))
  · rw [freeNormExt, if_neg htop, freeNormExt, if_neg htop]
    refine iSup_le fun n ↦ iSup_le fun φ ↦ iSup_le fun hφ ↦ ?_
    exact (ENNReal.ofReal_le_ofReal
      (norm_le_norm_of_abs_le_abs
        (show |WithLp.toLp p (fun i ↦ f (φ i))| ≤
          |WithLp.toLp p (fun i ↦ g (φ i))| from fun i ↦ h (φ i)))).trans
      (le_iSup_of_le n (le_iSup_of_le φ (le_iSup_of_le hφ le_rfl)))

/-- Replacing a function `f` on the dual by its pointwise absolute value leaves its extended
free p-norm unchanged, including when that norm is infinite. -/
theorem freeNormExt_abs (p : ℝ≥0∞) [Fact (1 ≤ p)] (f : StrongDual ℝ E → ℝ) :
    freeNormExt p (fun φ ↦ |f φ|) = freeNormExt p f := by
  apply le_antisymm
  · apply freeNormExt_mono_abs
    intro φ
    simp
  · apply freeNormExt_mono_abs
    intro φ
    simp

/-- The pointwise supremum of two functions has extended free p-norm at most the sum
of their free norms. In particular, finite free norm is preserved by lattice suprema. -/
theorem freeNormExt_sup_le (p : ℝ≥0∞) [Fact (1 ≤ p)] (f g : StrongDual ℝ E → ℝ) :
    freeNormExt p (f ⊔ g) ≤ freeNormExt p f + freeNormExt p g := by
  calc
    freeNormExt p (f ⊔ g) ≤ freeNormExt p (fun φ ↦ |f φ| + |g φ|) := by
      apply freeNormExt_mono_abs
      intro φ
      simpa [Pi.sup_apply, abs_of_nonneg
        (add_nonneg (abs_nonneg (f φ)) (abs_nonneg (g φ)))] using
        FVLv.abs_sup_le_add_abs (f φ) (g φ)
    _ ≤ freeNormExt p (fun φ ↦ |f φ|) + freeNormExt p (fun φ ↦ |g φ|) :=
      freeNormExt_add_le p (fun φ ↦ |f φ|) (fun φ ↦ |g φ|)
    _ = freeNormExt p f + freeNormExt p g := by
      rw [freeNormExt_abs, freeNormExt_abs]

/-- Positive homogeneity of a function `f` on the dual means `f (a • φ) = a * f φ` for `a ≥ 0`.
The case `a = 0` requires the function to vanish at the zero functional. -/
def PosHomogeneous (f : StrongDual ℝ E → ℝ) : Prop :=
  ∀ (a : ℝ), 0 ≤ a → ∀ φ, f (a • φ) = a * f φ

/-- Positively homogeneous real-valued functions on the continuous dual form a vector
sublattice under pointwise addition, real scalar multiplication, and lattice operations. -/
def homogeneousSublattice (E : Type u) [NormedAddCommGroup E] [NormedSpace ℝ E] :
    VectorSublattice (StrongDual ℝ E → ℝ) where
  toSubmodule := {
    carrier := {f | PosHomogeneous f}
    zero_mem' := by simp [PosHomogeneous]
    add_mem' := by
      intro f g hf hg a ha φ
      simp only [Pi.add_apply, hf a ha φ, hg a ha φ, mul_add]
    smul_mem' := by
      intro c f hf a ha φ
      simp [Pi.smul_apply, hf a ha φ, mul_left_comm] }
  sup_mem' := by
    intro f g hf hg a ha φ
    simpa only [Pi.sup_apply, hf a ha φ, hg a ha φ] using
      (mul_max_of_nonneg (f φ) (g φ) ha).symm

/-- The vector sublattice of positively homogeneous functions `f` on the dual satisfying
`freeNormExt p f < ∞`. Its elements will carry the real-valued free p-norm. -/
def finiteNormSublattice (p : ℝ≥0∞) [Fact (1 ≤ p)] (E : Type u)
    [NormedAddCommGroup E] [NormedSpace ℝ E] : VectorSublattice (StrongDual ℝ E → ℝ) where
  toSubmodule := {
    carrier := {f | PosHomogeneous f ∧ freeNormExt p f < ⊤}
    zero_mem' := by
      refine ⟨?_, ?_⟩
      · simp [PosHomogeneous]
      · change freeNormExt p (fun _ : StrongDual ℝ E ↦ 0) < ⊤
        rw [freeNormExt_zero]
        norm_num
    add_mem' := by
      intro f g hf hg
      refine ⟨(homogeneousSublattice E).add_mem hf.1 hg.1, ?_⟩
      exact (freeNormExt_add_le p f g).trans_lt
        (lt_top_iff_ne_top.mpr
          (ENNReal.add_ne_top.mpr ⟨ne_of_lt hf.2, ne_of_lt hg.2⟩))
    smul_mem' := by
      intro c f hf
      refine ⟨(homogeneousSublattice E).smul_mem c hf.1, ?_⟩
      rw [freeNormExt_smul]
      exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hf.2 }
  sup_mem' := by
    intro f g hf hg
    refine ⟨(homogeneousSublattice E).sup_mem hf.1 hg.1, ?_⟩
    exact (freeNormExt_sup_le p f g).trans_lt
      (lt_top_iff_ne_top.mpr
        (ENNReal.add_ne_top.mpr ⟨ne_of_lt hf.2, ne_of_lt hg.2⟩))

/-- The ambient space of positively homogeneous functions on the dual with finite free p-norm.
Its norm and topology are defined from `freeNormExt`, while its algebraic and lattice
operations are pointwise. -/
def FunctionSpace (p : ℝ≥0∞) [Fact (1 ≤ p)] (E : Type u)
    [NormedAddCommGroup E] [NormedSpace ℝ E] : Type u :=
  finiteNormSublattice p E

/-- The finite-norm functions inherit pointwise addition. -/
instance (p : ℝ≥0∞) [Fact (1 ≤ p)] : AddCommGroup (FunctionSpace p E) :=
  inferInstanceAs (AddCommGroup (finiteNormSublattice p E))

/-- The finite-norm functions inherit pointwise real scalar multiplication. -/
instance (p : ℝ≥0∞) [Fact (1 ≤ p)] : Module ℝ (FunctionSpace p E) :=
  inferInstanceAs (Module ℝ (finiteNormSublattice p E))

/-- The finite-norm functions inherit the pointwise lattice operations. -/
instance (p : ℝ≥0∞) [Fact (1 ≤ p)] : Lattice (FunctionSpace p E) :=
  inferInstanceAs (Lattice (finiteNormSublattice p E))

/-- Addition preserves the pointwise order on finite-norm functions. -/
instance (p : ℝ≥0∞) [Fact (1 ≤ p)] : IsOrderedAddMonoid (FunctionSpace p E) :=
  inferInstanceAs (IsOrderedAddMonoid (finiteNormSublattice p E))

/-- The finite-norm functions form a vector lattice. -/
instance (p : ℝ≥0∞) [Fact (1 ≤ p)] : VectorLattice (FunctionSpace p E) :=
  inferInstanceAs (VectorLattice (finiteNormSublattice p E))

/-- A finite-norm function `f` can be evaluated at a dual element `φ` as `f φ`. -/
instance (p : ℝ≥0∞) [Fact (1 ≤ p)] : CoeFun (FunctionSpace p E)
    (fun _ ↦ StrongDual ℝ E → ℝ) := ⟨fun f ↦ f.1⟩

/-- The norm of `f : FunctionSpace p E` is `(freeNormExt p f).toReal`.
Membership in the space guarantees that this extended norm is finite. -/
instance (p : ℝ≥0∞) [Fact (1 ≤ p)] : Norm (FunctionSpace p E) :=
  ⟨fun f ↦ (freeNormExt p f.1).toReal⟩

/-- The free p-norm gives `FunctionSpace p E` its metric and normed group structure.
Positive homogeneity ensures that vanishing on the dual unit ball implies vanishing
everywhere, so the norm separates distinct functions. -/
instance functionSpaceNormedAddCommGroup (p : ℝ≥0∞) [Fact (1 ≤ p)] :
    NormedAddCommGroup (FunctionSpace p E) :=
  NormedAddCommGroup.ofCore (𝕜 := ℝ) {
    norm_nonneg := by
      intro f
      exact ENNReal.toReal_nonneg
    norm_smul := by
      intro c f
      change (freeNormExt p (c • (f : StrongDual ℝ E → ℝ))).toReal =
        ‖c‖ * (freeNormExt p f.1).toReal
      rw [freeNormExt_smul, ENNReal.toReal_mul,
        ENNReal.toReal_ofReal (abs_nonneg c), Real.norm_eq_abs]
    norm_triangle := by
      intro f g
      change (freeNormExt p (f.1 + g.1)).toReal ≤
        (freeNormExt p f.1).toReal + (freeNormExt p g.1).toReal
      calc
        (freeNormExt p (f.1 + g.1)).toReal ≤
            (freeNormExt p f.1 + freeNormExt p g.1).toReal := by
          apply ENNReal.toReal_mono
          · exact ENNReal.add_ne_top.mpr ⟨ne_of_lt f.2.2, ne_of_lt g.2.2⟩
          · exact freeNormExt_add_le p f.1 g.1
        _ ≤ (freeNormExt p f.1).toReal + (freeNormExt p g.1).toReal :=
          ENNReal.toReal_add_le
    norm_eq_zero_iff := by
      intro f
      constructor
      · intro hnorm
        have hzero : freeNormExt p f.1 = 0 := by
          have hfin : freeNormExt p f.1 ≠ ⊤ := ne_of_lt f.2.2
          exact (ENNReal.toReal_eq_zero_iff _).mp hnorm |>.resolve_right hfin
        apply Subtype.ext
        funext φ
        change f.1 φ = 0
        let ψ : StrongDual ℝ E := ‖φ‖⁻¹ • φ
        have hψnorm : ‖ψ‖ ≤ 1 := by
          change ‖‖φ‖⁻¹ • φ‖ ≤ 1
          exact mem_closedBall_zero_iff.mp (inv_norm_smul_mem_unitClosedBall φ)
        have hψval : f.1 ψ = 0 := by
          have hle := ofReal_abs_le_freeNormExt p f.1 ψ hψnorm
          rw [hzero] at hle
          have habs : |f.1 ψ| ≤ 0 :=
            (ENNReal.ofReal_eq_zero.mp (le_zero_iff.mp hle))
          exact abs_eq_zero.mp (le_antisymm habs (abs_nonneg _))
        by_cases hφ : φ = 0
        · subst φ
          have hz := f.2.1 0 (le_refl 0) (0 : StrongDual ℝ E)
          simpa using hz
        · have hφnorm : ‖φ‖ ≠ 0 := norm_ne_zero_iff.mpr hφ
          have hsmul : ‖φ‖ • ψ = φ := by
            dsimp [ψ]
            rw [smul_smul, mul_inv_cancel₀ hφnorm, one_smul]
          rw [← hsmul, f.2.1 ‖φ‖ (norm_nonneg _) ψ, hψval, mul_zero]
      · intro hf
        subst f
        change (freeNormExt p (fun _ : StrongDual ℝ E ↦ 0)).toReal = 0
        rw [freeNormExt_zero]
        rfl }

/-- The pointwise vector lattice structure and the free p-norm make `FunctionSpace p E`
a normed vector lattice: pointwise absolute-value domination implies norm domination. -/
instance functionSpaceNormedVectorLattice (p : ℝ≥0∞) [Fact (1 ≤ p)] :
    NormedVectorLattice (FunctionSpace p E) where
  toVectorLattice := inferInstance
  solid := by
    intro f g hfg
    change (freeNormExt p f.1).toReal ≤ (freeNormExt p g.1).toReal
    exact ENNReal.toReal_mono (ne_of_lt g.2.2)
      (freeNormExt_mono_abs p (fun φ ↦ hfg φ))
  norm_smul := by
    intro c f
    change (freeNormExt p (c • (f : StrongDual ℝ E → ℝ))).toReal =
      ‖c‖ * (freeNormExt p f.1).toReal
    rw [freeNormExt_smul, ENNReal.toReal_mul,
      ENNReal.toReal_ofReal (abs_nonneg c), Real.norm_eq_abs]

/-- Evaluating a finite-norm function `f` at any `φ` with `‖φ‖ ≤ 1` gives `|f φ| ≤ ‖f‖`.
This controls the supremum norm on the dual unit ball by the free p-norm. -/
theorem functionSpace_unit_eval_le (f : FunctionSpace p E)
    (φ : StrongDual ℝ E)
    (hφ : ‖φ‖ ≤ 1) : |f φ| ≤ ‖f‖ := by
  change |f.1 φ| ≤ (freeNormExt p f.1).toReal
  exact (ENNReal.ofReal_le_iff_le_toReal (ne_of_lt f.2.2)).mp
    (ofReal_abs_le_freeNormExt p f.1 φ hφ)

/-- At an arbitrary dual functional `φ`, evaluation satisfies `|f φ| ≤ ‖φ‖ * ‖f‖`.
This estimate makes each evaluation map continuous for the free p-norm. -/
theorem functionSpace_apply_abs_le (f : FunctionSpace p E) (φ : StrongDual ℝ E) :
    |f φ| ≤ ‖φ‖ * ‖f‖ := by
  let ψ : StrongDual ℝ E := ‖φ‖⁻¹ • φ
  have hψ : ‖ψ‖ ≤ 1 := by
    change ‖‖φ‖⁻¹ • φ‖ ≤ 1
    exact mem_closedBall_zero_iff.mp (inv_norm_smul_mem_unitClosedBall φ)
  by_cases hφ : φ = 0
  · subst φ
    have hz := f.2.1 0 (le_refl 0) (0 : StrongDual ℝ E)
    simpa using hz
  · have hφnorm : ‖φ‖ ≠ 0 := norm_ne_zero_iff.mpr hφ
    have hsmul : ‖φ‖ • ψ = φ := by
      dsimp [ψ]
      rw [smul_smul, mul_inv_cancel₀ hφnorm, one_smul]
    have hfun : f φ = ‖φ‖ * f ψ := by
      calc
        f φ = f (‖φ‖ • ψ) := congrArg f hsmul.symm
        _ = ‖φ‖ * f ψ := f.2.1 ‖φ‖ (norm_nonneg _) ψ
    calc
      |f φ| = |‖φ‖ * f ψ| := by rw [hfun]
      _ = ‖φ‖ * |f ψ| := by rw [abs_mul, abs_of_nonneg (norm_nonneg φ)]
      _ ≤ ‖φ‖ * ‖f‖ := mul_le_mul_of_nonneg_left (functionSpace_unit_eval_le p f ψ hψ)
        (norm_nonneg φ)

/-- Evaluation `f ↦ f φ` as a continuous linear functional on `FunctionSpace p E`. -/
def functionSpaceEvaluation (φ : StrongDual ℝ E) : FunctionSpace p E →L[ℝ] ℝ :=
  ({ toFun := fun f : FunctionSpace p E ↦ f φ
     map_add' := by intros; rfl
     map_smul' := by intros; rfl } : FunctionSpace p E →ₗ[ℝ] ℝ).mkContinuous
    ‖φ‖ (by
      intro f
      change |f φ| ≤ ‖φ‖ * ‖f‖
      exact functionSpace_apply_abs_le p f φ)

/-- For finite `p`, evaluating a finite-norm function `f` on an admissible dual family `(φ i)`
produces a tuple `(f (φ i))` whose ℓᵖ norm is at most `‖f‖`. -/
theorem functionSpace_admissible_eval_le (hptop : p ≠ ⊤)
    (f : FunctionSpace p E) {n : ℕ} (φ : Fin n → StrongDual ℝ E) (hφ : NormAdmissible p φ) :
    ‖WithLp.toLp p (fun i ↦ f (φ i))‖ ≤ ‖f‖ := by
  have hle : ENNReal.ofReal (‖WithLp.toLp p (fun i ↦ f (φ i))‖) ≤ freeNormExt p f.1 := by
    rw [freeNormExt, if_neg hptop]
    exact le_iSup_of_le n (le_iSup_of_le φ (le_iSup_of_le hφ le_rfl))
  exact (ENNReal.ofReal_le_iff_le_toReal (ne_of_lt f.2.2)).mp hle

private lemma functionSpace_limit_sub_bound (u : ℕ → FunctionSpace p E)
    (g : StrongDual ℝ E → ℝ) (hg : ∀ φ, Filter.Tendsto (fun m ↦ u m φ) atTop (𝓝 (g φ)))
    (N : ℕ) (r : ℝ) (hN : ∀ᶠ m in atTop, ‖u m - u N‖ ≤ r) :
    freeNormExt p (g - (u N : StrongDual ℝ E → ℝ)) ≤ ENNReal.ofReal r := by
  by_cases hptop : p = ⊤
  · rw [freeNormExt, if_pos hptop]
    refine iSup_le fun φ ↦ iSup_le fun hφ ↦ ?_
    apply ENNReal.ofReal_le_ofReal
    have ht : Filter.Tendsto (fun m ↦ |(u m - u N) φ|) atTop
        (𝓝 |g φ - u N φ|) := by
      have hd : Filter.Tendsto (fun m ↦ (u m - u N) φ) atTop
          (𝓝 (g φ - u N φ)) := by
        convert (hg φ).sub tendsto_const_nhds using 1
        funext m
        rfl
      exact (continuous_abs.tendsto _).comp hd
    have hbound : ∀ᶠ m in atTop, |(u m - u N) φ| ≤ r := by
      filter_upwards [hN] with m hm
      exact (functionSpace_unit_eval_le p (u m - u N) φ hφ).trans hm
    exact le_of_tendsto ht hbound
  · rw [freeNormExt, if_neg hptop]
    refine iSup_le fun n ↦ iSup_le fun φ ↦ iSup_le fun hφ ↦ ?_
    apply ENNReal.ofReal_le_ofReal
    have hcoords : Filter.Tendsto
        (fun m : ℕ ↦ fun i : Fin n ↦ (u m - u N) (φ i)) atTop
        (𝓝 (fun i : Fin n ↦ g (φ i) - u N (φ i))) := by
      apply tendsto_pi_nhds.mpr
      intro i
      convert (hg (φ i)).sub tendsto_const_nhds using 1
      funext m
      rfl
    have ht : Filter.Tendsto
        (fun m ↦ ‖WithLp.toLp p (fun i : Fin n ↦ (u m - u N) (φ i))‖) atTop
        (𝓝 (‖WithLp.toLp p (fun i : Fin n ↦ g (φ i) - u N (φ i))‖)) :=
      ((continuous_norm.comp
        (PiLp.continuous_toLp p (fun _ : Fin n ↦ ℝ))).tendsto _).comp hcoords
    have hbound : ∀ᶠ m in atTop,
        ‖WithLp.toLp p (fun i : Fin n ↦ (u m - u N) (φ i))‖ ≤ r := by
      filter_upwards [hN] with m hm
      exact (functionSpace_admissible_eval_le p hptop (u m - u N) φ hφ).trans hm
    exact le_of_tendsto ht hbound

/-- Every Cauchy sequence for the free p-norm converges to its pointwise limit in
`FunctionSpace p E`. The ambient function space is complete without assuming `E` complete. -/
instance functionSpaceCompleteSpace : CompleteSpace (FunctionSpace p E) := by
  refine Metric.complete_of_cauchySeq_tendsto fun u hu ↦ ?_
  have hpoint : ∀ φ : StrongDual ℝ E, CauchySeq (fun n ↦ u n φ) := by
    intro φ
    have hc := (functionSpaceEvaluation p φ).uniformContinuous.comp_cauchySeq hu
    change CauchySeq (fun n ↦ u n φ) at hc
    exact hc
  choose g hg using fun φ ↦ cauchySeq_tendsto_of_complete (hpoint φ)
  have hg_pos : PosHomogeneous g := by
    intro a ha φ
    have ht : Filter.Tendsto (fun n ↦ u n (a • φ)) atTop (𝓝 (a * g φ)) := by
      convert tendsto_const_nhds.mul (hg φ) using 1
      funext n
      exact (u n).2.1 a ha φ
    exact tendsto_nhds_unique (hg (a • φ)) ht
  have huMetric := Metric.cauchySeq_iff.mp hu
  have hg_fin : freeNormExt p g < ⊤ := by
    obtain ⟨N, hN⟩ := huMetric 1 zero_lt_one
    have htail : ∀ᶠ m in atTop, ‖u m - u N‖ ≤ (1 : ℝ) := by
      filter_upwards [Filter.eventually_atTop.2 ⟨N, fun m hm ↦ hm⟩] with m hm
      exact le_of_lt (by simpa [dist_eq_norm] using hN m hm N le_rfl)
    have hdiff : freeNormExt p (g - (u N : StrongDual ℝ E → ℝ)) ≤ ENNReal.ofReal 1 :=
      functionSpace_limit_sub_bound p u g hg N 1 htail
    have hdiff_lt : freeNormExt p (g - (u N : StrongDual ℝ E → ℝ)) < ⊤ :=
      lt_of_le_of_lt hdiff (lt_top_iff_ne_top.mpr ENNReal.ofReal_ne_top)
    have hg_le : freeNormExt p g ≤
        freeNormExt p (g - (u N : StrongDual ℝ E → ℝ)) +
          freeNormExt p (u N : StrongDual ℝ E → ℝ) := by
      simpa [sub_add_cancel] using
        freeNormExt_add_le p (g - (u N : StrongDual ℝ E → ℝ)) (u N : StrongDual ℝ E → ℝ)
    exact lt_of_le_of_lt hg_le
      (lt_top_iff_ne_top.mpr
        (ENNReal.add_ne_top.mpr ⟨ne_of_lt hdiff_lt, ne_of_lt (u N).2.2⟩))
  let gLimit : FunctionSpace p E := ⟨g, hg_pos, hg_fin⟩
  refine ⟨gLimit, ?_⟩
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨N, hN⟩ := huMetric (ε / 2) (by linarith)
  refine ⟨N, fun n hn ↦ ?_⟩
  rw [dist_eq_norm]
  have htail : ∀ᶠ m in atTop, ‖u m - u n‖ ≤ ε / 2 := by
    filter_upwards [Filter.eventually_atTop.2 ⟨N, fun m hm ↦ hm⟩] with m hm
    exact le_of_lt (by simpa [dist_eq_norm] using hN m hm n hn)
  have hdiff : freeNormExt p (g - (u n : StrongDual ℝ E → ℝ)) ≤ ENNReal.ofReal (ε / 2) :=
    functionSpace_limit_sub_bound p u g hg n (ε / 2) htail
  have hnorm : ‖gLimit - u n‖ ≤ ε / 2 := by
    change (freeNormExt p ((gLimit - u n : FunctionSpace p E) :
      StrongDual ℝ E → ℝ)).toReal ≤ ε / 2
    have hcoe : ((gLimit - u n : FunctionSpace p E) : StrongDual ℝ E → ℝ) =
        g - (u n : StrongDual ℝ E → ℝ) := rfl
    rw [hcoe]
    exact ENNReal.toReal_le_of_le_ofReal (by linarith) hdiff
  rw [norm_sub_rev]
  linarith

/-- The finite-norm positively homogeneous functions on the dual form a Banach lattice
with the free p-norm and pointwise order. This is the ambient lattice for the free p-convex
construction. -/
instance functionSpaceBanachLattice : BanachLattice (FunctionSpace p E) where
  toNormedVectorLattice := functionSpaceNormedVectorLattice p
  toCompleteSpace := functionSpaceCompleteSpace p

/-- A vector `x : E` defines the positively homogeneous function on the dual `φ ↦ φ x` as an
element in `FunctionSpace p E`. -/
def functionSpaceEval (x : E) : FunctionSpace p E := ⟨fun φ ↦ φ x, by
  refine ⟨?_, ?_⟩
  · intro a ha φ
    simp
  · exact (freeNormExt_eval_le p x).trans_lt ENNReal.ofReal_lt_top⟩

end FBLp
